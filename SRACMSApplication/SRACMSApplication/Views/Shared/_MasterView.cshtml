            box-sizing: border-box;
        }

        .btnLink {
            /*width: 150px;*/
            height: 50px;
            border: 2px solid orange;
            font-family: 'Cinzel', serif;
            font-size: 20px;
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 0;
            transition: 1s;
            border-radius: 0px 20px 0px 20px;
        }

            .btnLink::before, .btnLink::after {
                position: absolute;
                /*background: #eee;*/
                background: white;
                z-index: -1;
                transition: 1s;
                content: '';
            }

            .btnLink::before {
                height: 70px;
                width: 300px;
                border-radius: 0px 20px 0px 20px;
            }

            .btnLink::after {
                width: 150px;
                height: 30px;
            }

        .noselect {
            -webkit-touch-callout: none;
            -webkit-user-select: none;
            -khtml-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
        }

        .btnLink:hover::before {
            width: 0px;
            background: #00a9ff;
        }

        .btnLink:hover::after {
            height: 0px;
            background: #00a9ff;
        }

        .btnLink:hover {
            background: #00a9ff;
        }

        .aText {
            color: black;
            font-size: medium;
            font-weight: 600;
        }
