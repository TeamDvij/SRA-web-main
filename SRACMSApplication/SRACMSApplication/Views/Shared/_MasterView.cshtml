<script>
        // JavaScript to handle the sliding action
        let currentIndex = 0;  // Track the current slide index
        const sliderWrapper = document.getElementById('sliderWrapper');
        const images = sliderWrapper.children;
        const totalSlides = images.length;

        // Duplicate the first image at the end to enable smooth loop
        const firstImage = images[0].cloneNode(true);
        sliderWrapper.appendChild(firstImage);

        function moveSlide(direction) {
            if (direction === 'next') {
                currentIndex = (currentIndex + 1) % totalSlides;  // Move to the next image
            } else if (direction === 'prev') {
                currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;  // Move to the previous image
            }
            updateSliderPosition();
        }

        function updateSliderPosition() {
            const slideWidth = sliderWrapper.children[0].clientWidth;  // Get width of an individual image
            sliderWrapper.style.transform = `translateX(-${currentIndex * slideWidth}px)`;  // Move slider

            // If we reach the last image (which is the duplicated first image), reset to the first image
            if (currentIndex === totalSlides - 1) {
                setTimeout(() => {
                    sliderWrapper.style.transition = 'none';  // Disable transition for a smooth jump
                    sliderWrapper.style.transform = `translateX(0)`;
                    currentIndex = 0;
                }, 500); // Timeout duration should match the transition time
            } else {
                sliderWrapper.style.transition = 'transform 0.5s ease';  // Re-enable transition
            }
        }

        // Optional: Auto-slide every 3 seconds
        setInterval(() => moveSlide('next'), 3000);

        // Update on window resize
        window.addEventListener('resize', updateSliderPosition);
</script>
