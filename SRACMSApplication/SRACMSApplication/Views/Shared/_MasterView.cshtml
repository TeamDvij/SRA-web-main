      <style>
        /* Container holding the entire slider */
        .slider-container {
            width: 100%; /* Full width of the page */
            overflow: hidden; /* Hide images outside the container */
            position: relative;
        }

        /* Slider wrapper: used to move images horizontally */
        .slider-wrapper {
            display: flex;
            transition: transform 0.5s ease; /* Smooth transition */
        }

            /* Individual images inside the slider */
            .slider-wrapper img {
                width: 100%; /* Images take full width of the slider */
                height: auto;
            }

        /* Navigation arrows */
        .arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background-color: rgba(0, 0, 0, 0.5);
            color: white;
            padding: 10px;
            border: none;
            cursor: pointer;
        }

        .left-arrow {
            left: 10px;
        }

        .right-arrow {
            right: 10px;
        }
    </style>

