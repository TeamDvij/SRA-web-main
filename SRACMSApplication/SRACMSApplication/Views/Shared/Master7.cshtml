<script>
    document.addEventListener("DOMContentLoaded", function () {

        var lightbox = document.getElementById("videoLightbox");
        var popupVideo = document.getElementById("popupVideo");
        var closeBtn = document.getElementById("closeVideo");

        document.querySelectorAll(".video-thumb").forEach(function (video) {

            video.addEventListener("click", function () {

                popupVideo.src = this.getAttribute("data-video");
                lightbox.style.display = "flex";
                popupVideo.play();

            });

        });

        function closePopup() {
            popupVideo.pause();
            popupVideo.currentTime = 0;
            popupVideo.removeAttribute("src");
            popupVideo.load();
            lightbox.style.display = "none";
        }

        // Close button
        closeBtn.onclick = closePopup;

        // Click outside video
        lightbox.onclick = function (e) {
            if (e.target === lightbox) {
                closePopup();
            }
        };

        // ESC key
        document.onkeydown = function (e) {
            if (e.key === "Escape") {
                closePopup();
            }
        };

    });
</script>

<script>
    let inverted = false;
    let grayscale = false;

    let letterSpacing = 0;
    let lineHeight = 1.6;

    function toggleInvert() {
        inverted = !inverted;

        document.documentElement.style.filter =
            inverted
                ? "invert(1) hue-rotate(180deg)"
                : "";
    }

    function toggleGrayscale() {
        grayscale = !grayscale;

        document.documentElement.style.filter =
            grayscale
                ? "grayscale(100%)"
                : "";
    }

    function increaseLetterSpacing() {
        letterSpacing += 1;
        document.body.style.letterSpacing = letterSpacing + "px";
    }

    function decreaseLetterSpacing() {
        letterSpacing = Math.max(0, letterSpacing - 1);
        document.body.style.letterSpacing = letterSpacing + "px";
    }

    function increaseLineHeight() {
        lineHeight += 0.2;
        document.body.style.lineHeight = lineHeight;
    }

    function decreaseLineHeight() {
        lineHeight = Math.max(1, lineHeight - 0.2);
        document.body.style.lineHeight = lineHeight;
    }

    function resetAccessibility() {

        inverted = false;
        grayscale = false;
        letterSpacing = 0;
        lineHeight = 1.6;

        document.documentElement.style.filter = "";
        document.body.style.letterSpacing = "";
        document.body.style.lineHeight = "";
    }
</script>
<script>
    const accessibilityBtn = document.getElementById("accessibilityBtn");
    const accessibilityPopup = document.getElementById("accessibilityPopup");
    const closeAccessibility = document.getElementById("closeAccessibility");

    accessibilityBtn.addEventListener("click", function (e) {
        e.stopPropagation();
        accessibilityPopup.classList.toggle("show");
    });

    closeAccessibility.addEventListener("click", function () {
        accessibilityPopup.classList.remove("show");
    });

    document.addEventListener("click", function (e) {
        if (
            !accessibilityPopup.contains(e.target) &&
            !accessibilityBtn.contains(e.target)
        ) {
            accessibilityPopup.classList.remove("show");
        }
    });
</script>



