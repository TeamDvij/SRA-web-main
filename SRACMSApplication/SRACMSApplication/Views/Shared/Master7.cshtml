<script>
    // JavaScript for infinite continuous scroll
    const sliderWrapper = document.getElementById('sliderWrapper');
    const originalSlides = Array.from(sliderWrapper.children);
    const slideCount = originalSlides.length;

    // Clone slides for seamless transition
    originalSlides.forEach(slide => {
        const clone = slide.cloneNode(true);
        sliderWrapper.appendChild(clone);
    });

    let currentIndex = 0;
    let isAnimating = false;

    function moveSlide() {
        if (isAnimating) return;

        isAnimating = true;
        currentIndex++;

        const slideWidth = originalSlides[0].offsetWidth;
        const totalWidth = slideWidth * slideCount;

        sliderWrapper.style.transition = 'transform 0.5s ease-in-out';
        sliderWrapper.style.transform = `translateX(-${currentIndex * slideWidth}px)`;

        // Reset position when reaching cloned slides
        setTimeout(() => {
            if (currentIndex >= slideCount) {
                sliderWrapper.style.transition = 'none';
                currentIndex = 0;
                sliderWrapper.style.transform = `translateX(0)`;
                // Force reflow to apply reset
                void sliderWrapper.offsetWidth;
            }
            isAnimating = false;
        }, 500);
    }

    // Auto-scroll every 3 seconds
    setInterval(moveSlide, 3000);

    // Handle window resize
    window.addEventListener('resize', () => {
        sliderWrapper.style.transition = 'none';
        currentIndex = 0;
        sliderWrapper.style.transform = `translateX(0)`;
        void sliderWrapper.offsetWidth;
    });
</script>



