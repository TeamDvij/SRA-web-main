<script>
    $(document).ready(function () {
        const $searchWrapper = $("#searchBoxWrapper");
        const $searchInput = $("#docSearch");
        // const $searchResults = $("#docResults");
        const $searchResults = $("#docResults");

        // Show search overlay
        $("#openSearch").on("click", function () {
            $searchWrapper.fadeIn();
            $searchInput.val("").focus();
            $("#openSearch").on("click", function () {
                $searchWrapper.fadeIn();
                $searchInput.val("").focus();
                $searchResults.html('<li class="list-group-item" style="padding: 10px; color: #6c757d; text-align: center;">Start typing to search...</li>').show();
            });

            // Add this to your input keyup or input event handler when user starts typing
            $searchInput.on("input", function () {
                if ($(this).val().trim() !== "") {
                    $searchResults.html('<li class="list-group-item" style="padding: 10px; color: #6c757d; text-align: center;">Loading...</li>').show();
                } else {
                    $searchResults.html('<li class="list-group-item" style="padding: 10px; color: #6c757d; text-align: center;">Start typing to search...</li>').show();
                }
            });
        });

        // Hide search overlay
        $("#closeSearch").on("click", function () {
            $searchWrapper.fadeOut();
        });


        // Fetch data when typing
        $searchInput.on("input", function () {
            const query = $(this).val().trim();

            if (query.length > 1) {
                $.ajax({
                    url: '@Url.Action("SearchDocuments", "Mr")',
                    data: { term: query },
                    success: function (data) {
                        $searchResults.empty();

                        if (data.length === 0) {
    $searchResults.append('<li class="list-group-item" style="padding: 10px; color: #6c757d; text-align: center;">No documents found</li>');
} else {
    $.each(data, function (i, item) {
        const docPath = '@Url.Content("~")' + item.DocumentLink.replace(/^~\//, '');
        const listItem = `
            <li class="list-group-item" style="padding: 0; border-bottom: 1px solid #eaeaea;">
                <a href="${docPath}" target="_blank" style="color: #333; text-decoration: none; padding: 12px 15px; display: block; font-weight: 500;">
                    <div style="font-size: 14px; margin-bottom: 2px;">${item.TableName}</div>
                    <div style="font-size: 12px; color: #888;">${item.Source}</div>
                </a>
            </li>`;
        $searchResults.append(listItem);
    });
}
                    }
                });
            } else {
                $searchResults.empty();
            }
        });

        // Optional: Close when clicking outside the search box
        $(document).on("click", function (e) {
            if (!$(e.target).closest(".search-box, #openSearch").length) {
                $searchWrapper.fadeOut();
            }
        });
    });
</script>

<script>
    const demoTexts = [
        "शोधा झोपुप्रा परिपत्रके...",
        "शोधा शासन निर्णय...",
        "शोधा झोपुप्रा नियमावली...",
