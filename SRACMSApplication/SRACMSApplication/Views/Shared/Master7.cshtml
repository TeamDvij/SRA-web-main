<script>
    document.addEventListener("DOMContentLoaded", function () {
        const modal = document.getElementById("customImageModal");
        const zoomImg = document.getElementById("zoomableImage");
        const wrapper = document.getElementById("zoomWrapper");

        // Create or locate a container for media (supports switching between img and video)
        let mediaContainer = document.getElementById("zoomMediaContainer");
        if (wrapper && !mediaContainer) {
            mediaContainer = document.createElement("div");
            mediaContainer.id = "zoomMediaContainer";
            mediaContainer.style.cssText = "width:100%; height:100%; display:flex; align-items:center; justify-content:center; position:relative;";
            // Move zoomImg inside mediaContainer
            if (zoomImg) {
                mediaContainer.appendChild(zoomImg);
            }
            wrapper.insertBefore(mediaContainer, wrapper.firstChild);
        }

        // Create a dedicated video element inside the media container if it doesn't exist
        let zoomVideo = document.getElementById("zoomableVideo");
        if (mediaContainer && !zoomVideo) {
            zoomVideo = document.createElement("video");
            zoomVideo.id = "zoomableVideo";
            zoomVideo.controls = true;
            zoomVideo.autoplay = true;
            zoomVideo.disablePictureInPicture = true;
            zoomVideo.controls = true;
            zoomVideo.controlsList = "nodownload";
            zoomVideo.style.cssText = "max-width:90%; max-height:90%; display:none; object-fit:contain; transform-origin: center center; transition: transform 0.05s ease-out;";
            mediaContainer.appendChild(zoomVideo);
        }

        let scale = 1;
        let posX = 0;
        let posY = 0;
        let isDragging = false;
        let hasMoved = false;
        let startX, startY;
        let clickStartX, clickStartY;
        let lastTapTime = 0;

        // Current active subset of items and index tracking
        let galleryItems = [];
        let currentIndex = 0;

        // Dynamically inject Next / Previous buttons into the modal wrapper if they don't exist
        if (wrapper && !document.getElementById("prevBtn")) {
            const prevButton = document.createElement("button");
            prevButton.id = "prevBtn";
            prevButton.innerHTML = "&#10094;"; // Left Arrow
            prevButton.style.cssText = "position:absolute; left:20px; top:50%; transform:translateY(-50%); background:rgba(0,0,0,0.5); color:white; border:none; padding:10px 15px; cursor:pointer; font-size:24px; z-index:1000; border-radius:50%;";

            const nextButton = document.createElement("button");
            nextButton.id = "nextBtn";
            nextButton.innerHTML = "&#10095;"; // Right Arrow
            nextButton.style.cssText = "position:absolute; right:20px; top:50%; transform:translateY(-50%); background:rgba(0,0,0,0.5); color:white; border:none; padding:10px 15px; cursor:pointer; font-size:24px; z-index:1000; border-radius:50%;";

            wrapper.style.position = "relative";
            wrapper.appendChild(prevButton);
            wrapper.appendChild(nextButton);

            prevButton.addEventListener("click", function (e) {
                e.stopPropagation();
                navigate(-1);
            });

            nextButton.addEventListener("click", function (e) {
                e.stopPropagation();
                navigate(1);
            });
        }

        function showItemAtIndex(index) {
            if (galleryItems.length === 0) return;
            currentIndex = (index + galleryItems.length) % galleryItems.length; // Loop around
            const activeItem = galleryItems[currentIndex];

            // Check if item contains an image or a video
            const img = activeItem.querySelector("img");
            const video = activeItem.querySelector("video");
            const source = activeItem.querySelector("source");

            // Pause and hide video if switching away
            if (zoomVideo) {
                zoomVideo.pause();
                zoomVideo.style.display = "none";
            }
            if (zoomImg) {
                zoomImg.style.display = "none";
            }

            if (img) {
                zoomImg.src = img.currentSrc || img.src;
                zoomImg.style.display = "block";
                resetTransform();
            } else if (video) {
                zoomVideo.src = video.currentSrc || video.src;
                zoomVideo.style.display = "block";
                zoomVideo.load();
                zoomVideo.play().catch(() => { });
                resetTransform();
            } else if (source) {
                zoomVideo.src = source.src;
                zoomVideo.style.display = "block";
                zoomVideo.load();
                zoomVideo.play().catch(() => { });
                resetTransform();
            }
        }

        function navigate(direction) {
            showItemAtIndex(currentIndex + direction);
        }

        // Open custom modal on lightbox-item click (Scoped by closest container card/grid)
        document.querySelectorAll(".lightbox-item").forEach(function (item) {
            item.addEventListener("click", function (e) {
                e.preventDefault();

                // Find the parent card body or photo-grid so we ONLY loop items within this specific section
                const scopeContainer = item.closest(".card-body") || document;
                galleryItems = Array.from(scopeContainer.querySelectorAll(".lightbox-item"));
                currentIndex = galleryItems.indexOf(item);

                const img = item.querySelector("img");
                const video = item.querySelector("video");
                const source = item.querySelector("source");

                if (zoomVideo) {
                    zoomVideo.pause();
                    zoomVideo.style.display = "none";
                }
                if (zoomImg) {
                    zoomImg.style.display = "none";
                }

                if (img) {
                    zoomImg.src = img.currentSrc || img.src;
                    zoomImg.style.display = "block";
                    resetTransform();
                    modal.style.display = "block";
                    document.body.style.overflow = "hidden";
                } else if (video || source) {
                    zoomVideo.src = video ? (video.currentSrc || video.src) : source.src;
                    zoomVideo.style.display = "block";
                    zoomVideo.load();
                    zoomVideo.play().catch(() => { });
                    resetTransform();
                    modal.style.display = "block";
                    document.body.style.overflow = "hidden";
                }
            });
        });

        // Close modal triggers
        document.getElementById("closeZoomModal").addEventListener("click", closeModal);

        modal.addEventListener("mousedown", function (e) {
            if (e.target === modal || e.target === wrapper || e.target === mediaContainer) {
                clickStartX = e.clientX;
                clickStartY = e.clientY;
                hasMoved = false;
            }
        });

        modal.addEventListener("mousemove", function (e) {
            if (e.target === modal || e.target === wrapper || e.target === mediaContainer) {
                if (clickStartX !== undefined && (Math.abs(e.clientX - clickStartX) > 5 || Math.abs(e.clientY - clickStartY) > 5)) {
                    hasMoved = true;
                }
            }
        });

        modal.addEventListener("mouseup", function (e) {
            if ((e.target === modal || e.target === wrapper || e.target === mediaContainer) && !hasMoved) {
                closeModal();
            }
            clickStartX = undefined;
            hasMoved = false;
        });

        function closeModal() {
            if (zoomVideo) zoomVideo.pause();
            modal.style.display = "none";
            document.body.style.overflow = "auto";
        }

        function getActiveActiveElement() {
            return (zoomImg && zoomImg.style.display !== "none") ? zoomImg : zoomVideo;
        }

        function updateTransform() {
            const activeEl = getActiveActiveElement();
            if (activeEl) {
                activeEl.style.transform = `translate(${posX}px, ${posY}px) scale(${scale})`;
            }
        }

        function resetTransform() {
            scale = 1;
            posX = 0;
            posY = 0;
            updateTransform();
        }

        // Double-Tap to Zoom In / Reset
        wrapper.addEventListener("click", function (e) {
            if (e.target.id === 'prevBtn' || e.target.id === 'nextBtn' || e.target.tagName === 'VIDEO' || e.target.tagName === 'SOURCE' || e.target.controls) return;
            const currentTime = new Date().getTime();
            const tapLength = currentTime - lastTapTime;

            if (tapLength < 300 && tapLength > 0) {
                e.preventDefault();
                if (scale > 1) {
                    resetTransform();
                } else {
                    scale = 2.5;
                    updateTransform();
                }
            }
            lastTapTime = currentTime;
        });

        // Keyboard arrow keys support for navigation
        document.addEventListener("keydown", function (e) {
            if (modal.style.display === "block") {
                if (e.key === "ArrowLeft") navigate(-1);
                if (e.key === "ArrowRight") navigate(1);
                if (e.key === "Escape") closeModal();
            }
        });

        const zoomInBtn = document.getElementById("zoomInBtn");
        if (zoomInBtn) {
            zoomInBtn.addEventListener("click", () => {
                scale = Math.min(scale * 1.25, 10);
                updateTransform();
            });
        }

        const zoomOutBtn = document.getElementById("zoomOutBtn");
        if (zoomOutBtn) {
            zoomOutBtn.addEventListener("click", () => {
                scale = Math.max(scale / 1.25, 0.5);
                if (scale <= 1) { resetTransform(); }
                updateTransform();
            });
        }

        const resetZoomBtn = document.getElementById("resetZoomBtn");
        if (resetZoomBtn) {
            resetZoomBtn.addEventListener("click", resetTransform);
        }

        wrapper.addEventListener("wheel", function (e) {
            e.preventDefault();
            const zoomIntensity = 0.1;
            if (e.deltaY < 0) {
                scale = Math.min(scale * (1 + zoomIntensity), 10);
            } else {
                scale = Math.max(scale / (1 + zoomIntensity), 0.5);
                if (scale <= 1) { resetTransform(); }
            }
            updateTransform();
        }, { passive: false });

        wrapper.addEventListener("mousedown", function (e) {
            if (e.target.id === 'prevBtn' || e.target.id === 'nextBtn' || e.target.tagName === 'VIDEO') return;
            if (scale > 1) {
                isDragging = true;
                startX = e.clientX - posX;
                startY = e.clientY - posY;
            }
        });

        window.addEventListener("mousemove", function (e) {
            if (!isDragging) return;
            posX = e.clientX - startX;
            posY = e.clientY - startY;
            updateTransform();
        });

        window.addEventListener("mouseup", function () {
            isDragging = false;
        });

        let initialDist = null;
        wrapper.addEventListener("touchstart", function (e) {
            if (e.target.id === 'prevBtn' || e.target.id === 'nextBtn' || e.target.tagName === 'VIDEO') return;
            if (e.touches.length === 1) {
                if (scale > 1) {
                    isDragging = true;
                    startX = e.touches[0].clientX - posX;
                    startY = e.touches[0].clientY - posY;
                }
            } else if (e.touches.length === 2) {
                initialDist = Math.hypot(
                    e.touches[0].clientX - e.touches[1].clientX,
                    e.touches[0].clientY - e.touches[1].clientY
                );
            }
        });

        wrapper.addEventListener("touchmove", function (e) {
            if (e.touches.length === 1 && isDragging) {
                posX = e.touches[0].clientX - startX;
                posY = e.touches[0].clientY - startY;
                updateTransform();
            } else if (e.touches.length === 2 && initialDist) {
                const currentDist = Math.hypot(
                    e.touches.length > 1 ? e.touches[0].clientX - e.touches[1].clientX : 0,
                    e.touches.length > 1 ? e.touches[0].clientY - e.touches[1].clientY : 0
                );
                let factor = currentDist / initialDist;
                scale = Math.min(Math.max(scale * factor, 0.5), 10);
                if (scale <= 1) { resetTransform(); }
                initialDist = currentDist;
                updateTransform();
            }
        });

        wrapper.addEventListener("touchend", function () {
            isDragging = false;
            initialDist = null;
        });
    });
</script>

@*Gallery Script end*@