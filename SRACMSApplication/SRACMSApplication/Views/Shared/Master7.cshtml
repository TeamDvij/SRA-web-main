    // State Management
    let selectedLang = null;
    let chatHistory = [];
    let isMinimized = false;

    // DOM Elements
    const chatToggle = document.getElementById("chatToggle");
    const chatBox = document.getElementById("chatbotBox");
    const chatClose = document.getElementById("chatClose"); // Minimize removed
    const chatWindow = document.getElementById("chatWindow");
    const chatInput = document.getElementById("chatInput");
    const chatSend = document.getElementById("chatSend");
    const typingIndicator = document.getElementById("typingIndicator");

    // Enhanced Message Function
    function addMessage(sender, text, isHtml = false, options = {}) {
        const messageId = Date.now();
        const wrapper = document.createElement("div");
        wrapper.className = `message-wrapper ${sender}`;
        wrapper.id = `msg-${messageId}`;

        const bubble = document.createElement("div");
        bubble.className = `message-bubble ${sender}`;

        const header = document.createElement("div");
        header.classList.add("small-text");
        header.textContent = sender === "bot" ? "SRA Pune Assistant" : "You";

        const content = document.createElement("div");
        content.className = "message-content";

        if (isHtml) {
            content.innerHTML = text;
        } else {
            content.textContent = text;
        }

        bubble.appendChild(header);
        bubble.appendChild(content);
        wrapper.appendChild(bubble);
        chatWindow.appendChild(wrapper);

        // Store in history
        chatHistory.push({
            id: messageId,
            sender,
            text,
            timestamp: new Date().toISOString()
        });

        // Auto-scroll
        wrapper.scrollIntoView({ behavior: 'smooth', block: 'end' });

        return messageId;
    }

    // Show Typing Indicator
    function showTyping() {
        typingIndicator.style.display = 'flex';
        chatWindow.scrollTop = chatWindow.scrollHeight;
    }

    function hideTyping() {
        typingIndicator.style.display = 'none';
    }

    // Welcome Message with Animation
    function showWelcome() {
        const welcomeText = `
            <div style="text-align: center; padding: 10px 0;">
                <div style="font-size: 18px; font-weight: 600; color: #790913; margin-bottom: 8px;">
                    झो.पु.प्रा. पुणे मध्ये आपले स्वागत!
                </div>
                <div style="color: #64748b; font-size: 13px; margin-bottom: 16px;">
                     मी आपला ऑनलाईन सहाय्यक आहे. आज मी आपली कशी मदत करू शकतो?
                </div>
                <button class="start-btn" onclick="showLanguageSelection()"
                        style="background: linear-gradient(135deg, #790913 0%, #030745 100%);
                               color: white; border: none; padding: 12px 24px;
                               border-radius: 12px; cursor: pointer; font-weight: 500;">
                    Start Conversation
                </button>
            </div>
        `;
        addMessage("bot", welcomeText, true);
    }

    // Modern Language Selection
    function showLanguageSelection() {
        showTyping();
        setTimeout(() => {
            hideTyping();
            const languageText = `
                <div style="margin-bottom: 12px;">
                    <strong>Select your preferred language:</strong>
                </div>
                <div class="btn-grid">
                    <button onclick="selectLanguage('mr')" style="display: flex; align-items: center; gap: 10px;">
                        <span style="font-size: 18px;">🇮🇳</span>
                        <div style="text-align: left;">
                            <div style="font-weight: 600;">मराठी</div>
                            <div style="font-size: 11px; opacity: 0.7;">Marathi</div>
                        </div>
                    </button>
                    <button onclick="selectLanguage('en')" style="display: flex; align-items: center; gap: 10px;">
                        <span style="font-size: 18px;">🇮🇳</span>
                        <div style="text-align: left;">
                            <div style="font-weight: 600;">English</div>
                            <div style="font-size: 11px; opacity: 0.7;">English</div>
                        </div>
                    </button>
                </div>
            `;
            addMessage("bot", languageText, true);
        }, 800);
    }

    function selectLanguage(lang) {
        selectedLang = lang;
        const langText = lang === "mr" ? "मराठी" : "English";
        addMessage("user", `🌐 Selected: ${langText}`);

        showTyping();
        setTimeout(() => {
            hideTyping();
            loadMenu(faqList[lang], "root");
        }, 600);
    }

    // Modern Menu Loader
    function loadMenu(menu, level) {
        let titleText = "";
        if (selectedLang === "mr") {
            titleText = level === "root" ? "मुख्य मेनू" : "पर्याय निवडा";
        } else {
            titleText = level === "root" ? "Main Menu" : "Select an option";
        }

        let html = `
            <div style="margin-bottom: 12px;">
                <strong>${titleText}:</strong>
            </div>
            <div class="btn-grid">
        `;

        for (const key in menu) {
            const item = menu[key];
            const icon = item.icon || "📌";

            if (item.children) {
                html += `
                    <button data-key="${escapeHtml(key)}" onclick="openSubMenuFromButton(this)">
                        <span>${icon} ${key}</span>
                        <i class="fas fa-chevron-right"></i>
                    </button>
                `;
            } else {
                html += `
                    <button class="link-btn" data-link="${escapeHtml(item.link)}"
                            data-label="${escapeHtml(key)}" onclick="showLinkFromButton(this)">
                        <span>${icon} ${key}</span>
                        <i class="fas fa-external-link-alt"></i>
                    </button>
                `;
            }
        }

        html += `</div>`;

        if (level !== "root") {
            const backText = selectedLang === "mr" ? "⬅️ मागे जा" : "⬅️ Go Back";
            html += `
                <div style="margin-top: 16px;">
                    <button onclick="loadMenu(faqList[selectedLang],'root')"
                            style="background: transparent; color: #64748b; border: 1px dashed #e2e8f0;">
                        ${backText}
                    </button>
                </div>
            `;
        }

        addMessage("bot", html, true);
    }

    // Helper Functions
    function escapeHtml(text) {
        const div = document.createElement("div");
        div.textContent = text;
        return div.innerHTML;
    }

    function openSubMenuFromButton(btn) {
        const key = btn.getAttribute("data-key");
        if (!key) return;
        addMessage("user", key);
        const submenu = faqList[selectedLang][key]?.children;
        if (submenu) {
            showTyping();
            setTimeout(() => {
                hideTyping();
                loadMenu(submenu, "sub");
            }, 500);
        }
    }

    function showLinkFromButton(btn) {
        const url = btn.getAttribute("data-link");
        const label = btn.getAttribute("data-label") || "Link";
        showLink(url, label);
    }

    function showLink(url, label) {
        addMessage("user", label);

        showTyping();
        setTimeout(() => {
            hideTyping();
            const linkText = `
                <div style="background: #f0f9ff; padding: 16px; border-radius: 12px; border-left: 4px solid #790913;">
                    <div style="font-weight: 600; margin-bottom: 8px;">🔗 ${label}</div>
                    <div style="font-size: 12px; color: #64748b; margin-bottom: 12px;">
                        Click the button below to view this document:
                    </div>
                    <a href="${url}" target="_blank"
                       style="display: inline-block; background: #790913; color: white;
                              padding: 10px 20px; border-radius: 8px; text-decoration: none;
                              font-weight: 500; font-size: 13px;">
                        <i class="fas fa-external-link-alt" style="margin-right: 6px;"></i>
                        Open
                    </a>
                </div>
            `;
            addMessage("bot", linkText, true);
        }, 600);
    }

    // Enhanced Send Function
    function sendMessage() {
        const msg = chatInput.value.trim();
        if (!msg) return;

        addMessage("user", msg);
        chatInput.value = "";

        // Show typing indicator
        showTyping();

        // Simulate AI processing
        setTimeout(() => {
            hideTyping();

            // For now, use the existing backend or show fallback
            $.ajax({
                url: '@Url.Action("GetResponse", "Mr")',
                type: "POST",
                data: { message: msg },
                success: function (data) {
                    addMessage("bot", data.response);
                },
                error: function () {
                    const fallbackMsg = `
                        <div style="color: #64748b;">
                            <div style="font-weight: 600; color: #790913; margin-bottom: 8px;">
                                <i class="fas fa-info-circle"></i> Quick Access
                            </div>
                            <div style="margin-bottom: 12px;">
                                For detailed queries, you might want to:
                            </div>
                            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                                <button onclick="loadMenu(faqList[selectedLang || 'en'], 'root')"
                                        style="padding: 8px 12px; font-size: 12px;">
                                    Browse Menu
                                </button>
                                <button onclick="showLanguageSelection()"
                                        style="padding: 8px 12px; font-size: 12px;">
                                    Change Language
                                </button>
                            </div>
                        </div>
                    `;
                    addMessage("bot", fallbackMsg, true);
                }
            });
        }, 1000);
    }

    // Event Listeners
    chatToggle.addEventListener("click", () => {
        chatBox.style.display = "flex";
        chatToggle.style.display = "none";
        showWelcome();
    });

    // Minimize functionality removed
    chatClose.addEventListener("click", () => {
        chatBox.style.display = "none";
        chatToggle.style.display = "flex";
        chatWindow.innerHTML = ``;
        selectedLang = null;
        chatHistory = [];
    });

    chatSend.addEventListener("click", sendMessage);

    chatInput.addEventListener("keyup", e => {
        if (e.key === "Enter") sendMessage();
    });

    // Auto-focus on input when chat opens
    chatToggle.addEventListener("click", () => {
        setTimeout(() => chatInput.focus(), 300);
    });
</script>


