        "शोधा विहित निकष/नमुने/कार्यपद्धती...",
        "शोधा योजनचे माहिती पुस्तिका...",
        "शोधा वार्षिक लेखा अहवाल...",
        "शोधा सूचिबध्द संस्था...",
        "शोधा माहितीचा अधिकार कायदा २००५ ...",
        "शोधा माहितीचा अधिकार कायदा ४ ख...",
        "शोधा नागरिकांची सनद...",
        "शोधा लोकसेवा हक्क अधिनियम अंतर्गत सेवा...",
        "शोधा झोपुप्रा अधिनियम ..."
    ];

    let currentText = 0;
    let charIndex = 0;
    let typing = true;

    function typeEffect() {
        const input = document.getElementById("autoSearch");

        if (typing) {
            if (charIndex < demoTexts[currentText].length) {
                input.setAttribute("placeholder", demoTexts[currentText].substring(0, charIndex + 1));
                charIndex++;
                setTimeout(typeEffect, 20);
            } else {
                typing = false;
                setTimeout(typeEffect, 500); // pause after full text
            }
        } else {
            if (charIndex > 0) {
                input.setAttribute("placeholder", demoTexts[currentText].substring(0, charIndex - 1));
                charIndex--;
                setTimeout(typeEffect, 50);
            } else {
                typing = true;
                currentText = (currentText + 1) % demoTexts.length;
                setTimeout(typeEffect, 500);
            }
        }
    }

    // Start typing effect
    typeEffect();
</script>


<script>
    let currentZoom = 100;

    function change(action) {

        if (action === "increase") {
            currentZoom = Math.min(currentZoom + 10, 120); // Max 120%
        }
        else if (action === "decrease") {
            currentZoom = Math.max(currentZoom - 10, 80); // Min 80%
        }
        else {
            currentZoom = 100;
        }

        document.body.style.zoom = currentZoom + "%";
    }


    // Voice Reader Toggle
    let voiceEnabled = false;
    const voiceToggle = document.getElementById("voiceToggle");

    //voiceToggle.addEventListener("change", () => {
    //    voiceEnabled = voiceToggle.click;
    //    window.speechSynthesis.cancel(); // stop any ongoing speech when toggled off
    //});

    voiceToggle.addEventListener("click", () => {
        voiceEnabled = !voiceEnabled;

        if (voiceEnabled) {
            voiceToggle.textContent = " Voice Reader Assistance ON";
            // voiceToggle.classList.add("active");
        } else {
            voiceToggle.textContent = "Voice Reader Assistance OFF";
            // voiceToggle.classList.remove("active");
            speechSynthesis.cancel(); // Stop speaking
        }

        console.log("Voice Enabled:", voiceEnabled);
    });
    // Voice Reader Function
    function speak(text) {
        const speech = new SpeechSynthesisUtterance(text);
        speech.lang = "hi-IN"; // change to "hi-IN" or "mr-IN" for Hindi/Marathi
        window.speechSynthesis.speak(speech);
    }

    // Apply hover events to all text elements (no need for class="speak-text")
    document.querySelectorAll("p,h1,h2,h3,h4,h5,h6,li,span,ul,a,button,form,th,td", "alt").forEach(el => {
        el.addEventListener("mouseenter", () => {
            if (voiceEnabled) {
                window.speechSynthesis.cancel();
                speak(el.innerText);
            }
        });
        el.addEventListener("mouseleave", () => {
            if (voiceEnabled) {
                window.speechSynthesis.cancel();
            }
        });
    });
</script>

