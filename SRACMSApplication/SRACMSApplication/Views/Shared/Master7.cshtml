                                                         alt="Image @(j + 1)">
                                                </a>
                                            </div>
                                        }
                                    }
                                </div>

                                <button class="btn-gallery mt-auto align-self-center" onclick="location.href='@Url.Action("Gallery", "Mr")#targetSection'">
                                    छायाचित्र दालन
                                    <span class="material-icons">arrow_forward</span>
                                </button>

                            </div>
                        </div>
                    </div>

                    <!-- VIDEO CARD -->
                    <div class=" col-md-4 md-4 ">
                        <div class="card h-100" style="border:2px solid #c2048a;">
                            <div class="card-body flex-column">
                                <div class="photo-grid">
                                    @if (ViewBag.VideoGalleryList_mr != null)
                                    {
                                        for (int j = 0; j < ViewBag.VideoGalleryList_mr.Count; j++)
                                        {
                                            <div class="lightbox-item img-wrap text-decoration-none">
                                             <video class="gallery-img img-fluid "
                                                       data-video="@Url.Content(ViewBag.VideoGalleryList_mr[j].doc_location + ViewBag.VideoGalleryList_mr[j].doc_name)"
                                                       preload="metadata"
                                                       controlsList="nodownload"
                                                       disablePictureInPicture
                                                       oncontextmenu="return false;"
                                                       muted>
                                                    <source src="@Url.Content(ViewBag.VideoGalleryList_mr[j].doc_location + ViewBag.VideoGalleryList_mr[j].doc_name)" type="video/mp4">
                                                </video>
                                                <!-- Optional play icon -->
                                                <span class="play-icon">
                                                    <i class="fa fa-play-circle fs-1"></i>
                                                </span>
                                            </div>
                                        }
                                    }

                                </div>
                                <button class="btn-gallery mt-auto align-self-center" onclick="location.href='@Url.Action("GalleryVideo", "Mr")#targetSection'">
                                    व्हिडिओ
                                    <span class="material-icons">arrow_forward</span>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div id="videoLightbox" class="video-lightbox">
                        <span class="close-btn fs-1" id="closeVideo">&times;</span>

                        <video id="popupVideo"
