@model SRACMSApplication.Models.societyModel

@{
    ViewBag.Title = "Society";
    Layout = "~/Views/Shared/_MasterView.cshtml";
}

@*Data table*@
@*css*@

@*javascript*@
<script>
    $(document).ready(function () {
        $('#datatable').dataTable(),
        $("[data-toggle=tooltip]").tooltip();
    });

</script>

@*<link href="//maxcdn.bootstrapcdn.com/bootstrap/3.3.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">*@
<script src="~//maxcdn.bootstrapcdn.com/bootstrap/3.3.0/js/bootstrap.min.js"></script>
<script src="~//code.jquery.com/jquery-1.11.1.min.js"></script>
<!------ Include the above in your HEAD tag ---------->

<script language="JavaScript" src="https://code.jquery.com/jquery-1.11.1.min.js" type="text/javascript"></script>
<script language="JavaScript" src="https://cdn.datatables.net/1.10.4/js/jquery.dataTables.min.js" type="text/javascript"></script>
<script language="JavaScript" src="https://cdn.datatables.net/plug-ins/3cfcc339e89/integration/bootstrap/3/dataTables.bootstrap.js" type="text/javascript"></script>
@*<link rel="stylesheet" type="text/css" href="http://maxcdn.bootstrapcdn.com/bootstrap/3.2.0/css/bootstrap.min.css">*@
<link rel="stylesheet" type="text/css" href="http://cdn.datatables.net/plug-ins/3cfcc339e89/integration/bootstrap/3/dataTables.bootstrap.css">


<div class="container containerStyle">
    <div class="row">
        <div>
            <div class="multimedia">
                <h3>@(Session["Lang"].ToString() == "mr" ? "गृहनिर्माण संस्थांची यादी" : "List of housing societies") </h3>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <table id="datatable" class="table table-striped table-bordered pStyle" cellspacing="0" width="100%">
                <thead>
                    <tr class="tCenter">
                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "अ.क्र." : "Sr.No.")</th>
                        <th class="tCenter" >@(Session["Lang"].ToString() == "mr" ? "संस्थेचे नाव" : "Society Name") </th>
                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "संस्थेचा पत्ता" : "Society Address") </th>
                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "संस्थेचा नोंदणी क्रमांक" : "Society Registration No.")</th>
                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "नोंदणी दिनांक" : "Registration Date") </th>
                    </tr>
                    @*<tr style="font-size:medium;">
                        <th class="tCenter">1</th>
                        <th class="tCenter">2</th>
                        <th class="tCenter">3</th>
                        <th class="tCenter">4</th>
                        <th class="tCenter">5</th>
                    </tr>*@
                </thead> 
                <tbody>
                    @foreach (var item in Model.society_List.Select((x, i) => new { Data = x, Index = i + 1 }))
                    {
                        <tr>
                            <td style="text-align:center;">@item.Index</td>
                            <td style="text-align:left;width:30%">@(Session["Lang"].ToString() == "mr" ? @item.Data.soc_name : @item.Data.soc_name_eng)</td>
                            <td style="text-align:left;width:30%">@(Session["Lang"].ToString() == "mr" ? @item.Data.soc_address : @item.Data.soc_address_eng)</td>
                            <td style="text-align:left;width:30%">@(Session["Lang"].ToString() == "mr" ? @item.Data.soc_registration_no : @item.Data.soc_registration_no_eng)</td>
                            @if (@item.Data.soc_registration_dt.ToString("dd-MM-yyyy") != "01-01-1900")
                            {
                                <td style="text-align:center;width:12%">@item.Data.soc_registration_dt.ToString("dd-MM-yyyy")</td>
                            }
                            @if (@item.Data.soc_registration_dt.ToString("dd-MM-yyyy") == "01-01-1900")
                            {
                                <td></td>
                            }

                            @*<td class="tCenter">@item.Data.soc_registration_dt.ToString("dd/MM/yyyy")</td>*@
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

