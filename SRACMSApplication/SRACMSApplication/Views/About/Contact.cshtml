<div class="container containerStyle">
        <div class="row">
            <div class="multimedia">
                <h3  style="font-size: x-large; padding: 14.1px;">@(Session["Lang"].ToString() == "mr" ? "संपर्क" : "Contact") </h3>
            </div>
        </div>
             <div class="row">
                <div class="col-md-6">
                    <h3 style="font-weight: bold; margin-left:15px;">@(Session["Lang"].ToString() == "mr" ? "मुख्य कार्यालय" : "Main Office")</h3>
                    <p class="pStyle" style="margin-top: 5px;">
                        @(Session["Lang"].ToString() == "mr" ? Model.address1 : Model.address1_eng) <br />
                        @(Session["Lang"].ToString() == "mr" ? "कार्यालय वेळ : " + Model.officeTime : "Office Time : " + Model.officeTime_eng) <br />
                        @(Session["Lang"].ToString() == "mr" ? "कार्यालयीन दूरध्वनी : " + Model.officeContactNumber : "Office Landline : " + Model.officeContactNumber_eng) <br />
                        @*@(Session["Lang"].ToString() == "mr" ? "वेब साइट : " : "Website : ")<a href="https://www.srapune.gov.in/" target="_blank" >www.srapune.gov.in</a><br />
                        @(Session["Lang"].ToString() == "mr" ? "ई-मेल : " : "e-mail") @Model.office_email<br />*@
                    </p>
                </div>
                 <div class="col-md-6">
                     <h3 style="font-weight: bold; margin-left:15px;">@(Session["Lang"].ToString() == "mr" ? "शाखा कार्यालय" : "Branch Office")</h3>
                     <p class="pStyle" style="margin-top: 5px;">
                         @(Session["Lang"].ToString() == "mr" ? Model.address2 : Model.address2_eng) <br />
                         @(Session["Lang"].ToString() == "mr" ? "कार्यालय वेळ : " + Model.officeTime : "Office Time : " + Model.officeTime_eng) <br />
                         @(Session["Lang"].ToString() == "mr" ? "कार्यालयीन दूरध्वनी : " + Model.branchContactNumber : "Office Landline : " + Model.branchContactNumber_eng) <br />
                         @*@(Session["Lang"].ToString() == "mr" ? "वेब साइट : " : "Website : ")<a href="https://www.srapune.gov.in/" target="_blank">www.srapune.gov.in</a><br />
                         @(Session["Lang"].ToString() == "mr" ? "ई-मेल : " : "e-mail") @Model.office_email<br />*@
                     </p>
                 </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    @*<iframe style="width: 100%; height: 250px; margin-left:15px;" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3782.9193422842645!2d73.82797251475243!3d18.532546687402057!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bc2bf79e2abeabf%3A0x5f6c87b647800360!2sSlum%20Rehabilitation%20Authority!5e0!3m2!1sen!2sin!4v1583824365715!5m2!1sen!2sin" width="500" height="350" frameborder="0" style="border:0;" allowfullscreen=""></iframe>*@
                    <iframe src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d3782.804059062149!2d73.8339615!3d18.5377546!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x18238bfc7c8c4a7f!2z4KSd4KWL4KSq4KSh4KSq4KSf4KWN4KSf4KWAIOCkquClgeCkqOCksOCljeCkteCkuOCkqCDgpKrgpY3gpLDgpL7gpKfgpL_gpJXgpLDgpKMsIOCkquClgeCko-Clhw!5e0!3m2!1sen!2sin!4v1636458963899!5m2!1sen!2sin" width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                </div>
                <div class="col-md-6">
                    @*<iframe style="width: 100%; height: 250px; margin-left:15px;" src="https://goo.gl/maps/gsLQaFKmxuzZa2YP7" width="500" height="350" frameborder="0" style="border:0;" allowfullscreen=""></iframe>*@
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d7565.64975205859!2d73.82456733494254!3d18.53681429921249!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bc2bf8dc90b8ad3%3A0x8e2566aadc5d1336!2z4KSd4KWL4KSq4KSh4KSq4KSf4KWN4KSf4KWAIOCkquClgeCkqOCksOCljeCkteCkuOCkqCDgpKrgpY3gpLDgpL7gpKfgpL_gpJXgpLDgpKMsIOCkquClgeCko-ClhyDgpLUg4KSq4KS_4KSC4KSq4KSw4KWAIOCkmuCkv-CkguCkmuCkteCkoSDgpJXgpY3gpLfgpYfgpKTgpY3gpLAsIOCkquClgeCko-Clhw!5e0!3m2!1sen!2sin!4v1636504831794!5m2!1sen!2sin" width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                </div>
            </div>
    <br />
        <div class="row">
            <div class="multimedia">
                <h3 style="font-size: x-large; padding: 14.1px;">@(Session["Lang"].ToString() == "mr" ? "संपर्क-अधिकारी व कर्मचारी" : "Liaison Officer and Staff")</h3><br />
            </div>
            <table id="datatable1" class="table table-striped table-bordered pStyle" cellspacing="0" width="100%">
                <thead>
                    <tr>
                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "अ.क्र." : "Sr.No.")</th>
                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "अधिकारी / कर्मचारी नाव" : "Officer / Employee Name") </th>
                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "पदनाम" : "Designation")</th>
                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "कार्यालयीन दूरध्वनी" : "Office Telephone")</th>
                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "बसण्याचे ठिकाण" : "Sitting Place")</th>
                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "कार्य" : "Work")</th>
                    </tr>
                    <tr style="font-size:medium;">
                        <th style="text-align:center;">1</th>
                        <th style="text-align:center;">2</th>
                        <th style="text-align:center;">3</th>
                        <th style="text-align:center;">4</th>
                        <th style="text-align:center;">5</th>
                        <th style="text-align:center;">6</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ContactOfficerTableList.Select((x, i) => new { Data = x, Index = i + 1 }))
                            {
                            <tr>
                                @*<td style="text-align:center">@(Session["Lang"].ToString() == "mr" ? @item.Data.col0 : @item.Data.col_eng0)</td>*@
                                <td style="text-align:center">@item.Index</td>
                                <td style="text-align:left">@(Session["Lang"].ToString() == "mr" ? @item.Data.col1 : @item.Data.col_eng1)</td>
                                <td style="text-align:left">@(Session["Lang"].ToString() == "mr" ? @item.Data.col2 : @item.Data.col_eng2)</td>
                                <td style="text-align:center">@(Session["Lang"].ToString() == "mr" ? @item.Data.col3 : @item.Data.col_eng3)</td>
                                <td style="text-align:left">@(Session["Lang"].ToString() == "mr" ? @item.Data.col4 : @item.Data.col_eng4)</td>
                                <td style="text-align:left">
                                    @(Session["Lang"].ToString() == "mr" ? @item.Data.col5 : @item.Data.col_eng5)
                                @if (@item.Data.col6 != null)
                                        {
                                    <br /> <a href="@Url.Content(@item.Data.col6)" class="marathi_font" style="font-size:small;" target="_blank"> @(Session["Lang"].ToString() == "mr" ? "अधिक माहिती..." : "Read More...")</a>
                                        }
                            </td>
                        </tr>
                            }
                </tbody>

            </table>
        </div>
        @*<div class="row" style="display:none;">
            <div class="multimedia">
                <h3 style="font-size: x-large;padding: 14.1px;">@(Session["Lang"].ToString() == "mr" ? "माहिती अधिकार संपर्क-अधिकारी व कर्मचारी" : "RTI Liaison Officer and Staff")</h3>
            </div>
            <table id="datatable2" class="table table-striped table-bordered pStyle" cellspacing="0" width="100%">
                <thead>
