@model SRACMSApplication.Models.abount_saksham_sadasyaModel
    
@{
    ViewBag.Title = "cp_saksham_sadasya_edit";
    Layout = "~/Views/Shared/_MainView.cshtml";
}

@*<link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">
<script src="//code.jquery.com/jquery-1.10.2.js"></script>
<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>*@
<script src="@Url.Content("~/Content/Web/js/bootstrap.min.js")"></script>
<script src="@Url.Content("~/Content/Web/js/jquery-3.5.1.min.js")"></script>

@if (@ViewBag.Message != null)
{
    <script type="text/javascript">
                    window.onload = function () {
                        alert("@ViewBag.Message");
                    };
    </script>
}

@if (@ViewBag.error != null)
{
    <script type="text/javascript">
        window.onload = function () {
            alert("@ViewBag.error");
        };
    </script>
}

@using (Html.BeginForm("cp_saksham_sadasya_edit", "CPAbout", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <div class="container-fluid">
        <!-- Page Heading -->
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h1 class="h3 mb-0 text-gray-800">Edit सक्षम सदस्य</h1>
            <a href="@Url.Content("~/CPAbout/cp_saksham_sadasya")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
                Back to List
            </a>
        </div>
        <!-- Content Row -->
        <hr />
        <div class="row">
            <div class="col-lg-12">
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("नाव")
                        @Html.TextBox("name", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.name)
                    </div>
                    <div class="col-sm-6">
                        @Html.Label("Name")
                        @Html.TextBox("name_eng", null, new { @class = "form-control form-control-user" })
                        @Html.ValidationMessageFor(a => a.name_eng)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("पद")
                        @Html.TextBox("designation", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.designation)
                    </div>
                    <div class="col-sm-6">
                        @Html.Label("Designation")
                        @Html.TextBox("designation_eng", null, new { @class = "form-control form-control-user" })
                        @Html.ValidationMessageFor(a => a.designation_eng)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-3">
                        <input type="submit" value="Submit" class="btn btn-primary btn-user btn-block" />
                    </div>
                </div>
                @Html.HiddenFor(a => a.id)
            </div>
        </div>
    </div>
}

