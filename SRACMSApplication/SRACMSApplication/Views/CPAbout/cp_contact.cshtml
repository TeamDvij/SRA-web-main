@model SRACMSApplication.Models.aboutModel
@{
    ViewBag.Title = "cp_contact";
    Layout = "~/Views/Shared/_MainView.cshtml";
}
<style>
    div.scroll {
        overflow-x: hidden;
        overflow-y: auto;
        height: 360px;
    }
</style>

<script src="~/Contents/vendor/jquery/jquery.min.js"></script>

<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">संपर्क</h1>
    </div>
    <hr />
    <h1 class="h3 mb-0 text-gray-800">संपर्क-अधिकारी व कर्मचारी</h1>
    <div class="card-body">
        <div class="table-responsive">
            <table class="scroll table table-bordered" style="font-size:small" id="dt1">
                <thead>
                    <tr>
                        <th style="text-align:center">#</th>
                        <th style="text-align:center">Sequence</th>
                        <th style="text-align:center">अ.क्र.</th>
                        <th class="tCenter">अधिकारी / कर्मचारी नाव</th>
                        <th class="tCenter">पदनाम</th>
                        <th class="tCenter">कार्यालयीन दूरध्वनी</th>
                        <th class="tCenter">बसण्याचे ठिकाण</th>
                        <th class="tCenter">कार्य</th>
                        <th class="tCenter">अधिक माहिती (Link)</th>
                        <th style="text-align:center">Sr.No.</th>
                        <th class="tCenter">Officer / Employee Name</th>
                        <th class="tCenter">Designation</th>
                        <th class="tCenter">Office Telephone</th>
                        <th class="tCenter">Sitting Place</th>
                        <th class="tCenter">Work</th>
                    </tr>
                </thead>
                <tbody class="scroll">
                        @foreach (var item in Model.ContactOfficerTableList.Select((x, i) => new { Data = x, Index = i + 1 }))
                        {
                            <tr class="tCenter">
                                <td align="center" width="10px"><input type="hidden" id="id1" value="@item.Data.id" /> @item.Index</td>
                                <td style="text-align:center"><input style="width:50px; height:50px" type="text" id="col_srno" value="@item.Data.col_srno" /></td>
                                <td style="text-align:center"><input style="width:50px; height:50px" type="text" id="col0" value="@item.Data.col0" /></td>
                                <td style="text-align:left"><input multiple; style="width:300px; height:50px" type="text" id="col1" value="@item.Data.col1" /></td>
                                <td style="text-align:left"><input style="width:200px; height:50px" type="text" id="col2" value="@item.Data.col2" /></td>
                                <td style="text-align:left"><input style="width:200px; height:50px" type="text" id="col3" value="@item.Data.col3" /></td>
                                <td style="text-align:left"><input style="width:200px; height:50px" type="text" id="col4" value="@item.Data.col4" /></td>
                                <td style="text-align:left"><input style="width:300px; height:50px" type="text" id="col5" value="@item.Data.col5" /></td>
                                <td style="text-align:left"><input style="width:200px; height:50px" type="text" id="col6" value="@item.Data.col6" /></td>

                                <td style="text-align:center"><input style="width:50px; height:50px" type="text" id="col_eng0" value="@item.Data.col_eng0" /></td>
                                <td style="text-align:center"><input multiple style="width:300px; height:50px" type="text" id="col_eng1" value="@item.Data.col_eng1" /></td>
                                <td style="text-align:center"><input style="width:200px; height:50px" type="text" id="col_eng2" value="@item.Data.col_eng2" /></td>
                                <td style="text-align:center"><input style="width:200px; height:50px" type="text" id="col_eng3" value="@item.Data.col_eng3" /></td>
                                <td style="text-align:center"><input style="width:200px; height:50px" type="text" id="col_eng4" value="@item.Data.col_eng4" /></td>
                                <td style="text-align:center"><input style="width:200px; height:50px" type="text" id="col_eng5" value="@item.Data.col_eng5" /></td>

                            </tr>
                        }
                </tbody>
            </table>
        </div>
        <div class="form-group row">
            <div class="col-sm-3">
                <input type="button" id="btnSave1" value="Save" class="btn btn-primary btn-user btn-block" />
            </div>
        </div>
    </div>
    <hr />
    <h1 class="h3 mb-0 text-gray-800">माहिती अधिकार संपर्क-अधिकारी व कर्मचारी</h1>
    <div class="table-responsive">
        <table class="table table-bordered" style="font-size:small" id="dt2">
            <thead>
                <tr>
                    <th style="text-align:center">#</th>
                    <th style="text-align:center">अ.क्र.</th>
                    <th class="tCenter">शाखा/विभाग</th>
                    <th class="tCenter">पदाचे नाव</th>
                    <th class="tCenter">नाव व पदनाम</th>
                    <th class="tCenter">कार्यक्षेत्र</th>
                    <th style="text-align:center">Sr.No.</th>
                    <th class="tCenter">Branch/Department</th>
                    <th class="tCenter">Post Name</th>
                    <th class="tCenter">Name and Designation</th>
                    <th class="tCenter">Workspace</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.RTIContactOfficerTableList.Select((x, i) => new { Data = x, Index = i + 1 }))
                {
                    <tr class="tCenter">
                        <td align="center" width="10px"><input type="hidden" id="id2" value="@item.Data.id" />@item.Index</td>
                        <td style="text-align:center"><input style="width:50px; height:50px" type="text" id="col0" value="@item.Data.col0" /></td>
                        <td style="text-align:left"><input style="width:200px; height:50px" type="text" id="col1" value="@item.Data.col1" /></td>
                        <td style="text-align:left"><input style="width:200px; height:50px" type="text" id="col2" value="@item.Data.col2" /></td>
                        <td style="text-align:left"><input style="width:300px; height:50px" type="text" id="col3" value="@item.Data.col3" /></td>
                        <td style="text-align:left"><input style="width:300px; height:50px" type="text" id="col4" value="@item.Data.col4" /></td>

                        <td style="text-align:center"><input style="width:50px; height:50px" type="text" id="col_eng0" value="@item.Data.col_eng0" /></td>
                        <td style="text-align:left"><input style="width:200px; height:50px" type="text" id="col_eng1" value="@item.Data.col_eng1" /></td>
                        <td style="text-align:left"><input style="width:200px; height:50px" type="text" id="col_eng2" value="@item.Data.col_eng2" /></td>
                        <td style="text-align:left"><input style="width:300px; height:50px" type="text" id="col_eng3" value="@item.Data.col_eng3" /></td>
                        <td style="text-align:left"><input style="width:300px; height:50px" type="text" id="col_eng4" value="@item.Data.col_eng4" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="form-group row">
        <div class="col-sm-3">
            <input type="button" id="btnSave2" value="Save" class="btn btn-primary btn-user btn-block" />
        </div>
    </div>
</div>

<script>
        $(function () {
                $("#btnSave1").click(function () {
                    //Loop through the Table rows and build a JSON array.
                var abouts = new Array();
                $("#dt1 TBODY TR").each(function () {
                    var row = $(this);
                    var about = {};
                    about.id = $(this).find("td:eq(0) input[type='hidden']").val();
                    about.col_srno = $(this).find("td:eq(1) input[type='text']").val();
                    about.col0 = $(this).find("td:eq(2) input[type='text']").val();
                    about.col1 = $(this).find("td:eq(3) input[type='text']").val();
                    about.col2 = $(this).find("td:eq(4) input[type='text']").val();
                    about.col3 = $(this).find("td:eq(5) input[type='text']").val();
                    about.col4 = $(this).find("td:eq(6) input[type='text']").val();
                    about.col5 = $(this).find("td:eq(7) input[type='text']").val();
                    about.col6 = $(this).find("td:eq(8) input[type='text']").val();


                    about.col_eng0 = $(this).find("td:eq(9) input[type='text']").val();
                    about.col_eng1 = $(this).find("td:eq(10) input[type='text']").val();
                    about.col_eng2 = $(this).find("td:eq(11) input[type='text']").val();
                    about.col_eng3 = $(this).find("td:eq(12) input[type='text']").val();
                    about.col_eng4 = $(this).find("td:eq(13) input[type='text']").val();
                    about.col_eng5 = $(this).find("td:eq(14) input[type='text']").val();

                    abouts.push(about);

                });
                //Send the JSON array to Controller using AJAX.
                $.ajax({
                    type: "POST",
                    url: "../CPAbout/SaveAboutTableList",
                    data: JSON.stringify(abouts),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (r) {
                        alert(r);
                    }
                });
                });

                $("#btnSave2").click(function () {
                    //Loop through the Table rows and build a JSON array.
                    var abouts = new Array();
                    $("#dt2 TBODY TR").each(function () {
                        var row = $(this);
                        var about = {};
                        about.id = $(this).find("td:eq(0) input[type='hidden']").val();
                        about.col0 = $(this).find("td:eq(1) input[type='text']").val();
                        about.col1 = $(this).find("td:eq(2) input[type='text']").val();
                        about.col2 = $(this).find("td:eq(3) input[type='text']").val();
                        about.col3 = $(this).find("td:eq(4) input[type='text']").val();
                        about.col4 = $(this).find("td:eq(5) input[type='text']").val();
                        about.col_eng0 = $(this).find("td:eq(6) input[type='text']").val();
                        about.col_eng1 = $(this).find("td:eq(7) input[type='text']").val();
                        about.col_eng2 = $(this).find("td:eq(8) input[type='text']").val();
                        about.col_eng3 = $(this).find("td:eq(9) input[type='text']").val();
                        about.col_eng4 = $(this).find("td:eq(10) input[type='text']").val();

                        abouts.push(about);

                    });
                    //Send the JSON array to Controller using AJAX.
                    $.ajax({
                        type: "POST",
                        url: "../CPAbout/SaveAboutTableList",
                        data: JSON.stringify(abouts),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (r) {
                            alert(r);
                        }
                    });
                });
        });
</script>