@model SRACMSApplication.Models.other_navitamModel
@{
    ViewBag.Title = "cp_other_navintam";
    Layout = "~/Views/Shared/_MainView.cshtml";
}


<script src="~/Contents/vendor/jquery/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        $('#datatable').dataTable(),
            $("[data-toggle=tooltip]").tooltip();
    });
</script>


<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">नवीनतम</h1>
        <a href="@Url.Content("~/cp_other/cp_other_navintam_addedit")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            Add New
        </a>
    </div>
    @using (Html.BeginForm("cp_other_navintam", "cp_other", FormMethod.Get))
    {
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" style="font-size:small" id="dataTable">
                    <thead>
                        <tr>
                            <th style="text-align:center">अ.क्र.</th>
                            <th class="tCenter">नवीनतम प्रकार/Type</th>
                            <th class="tCenter">नवीनतम शीर्षक/Title</th>
                            <th class="tCenter">नवीनतम शीर्षक/Title(Eng)</th>
                            <th class="tCenter">तारीख</th>
                            <th style="text-align:center">पहा</th>
                            <th style="text-align:center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.other_navitamList.Select((x, i) => new { Data = x, Index = i + 1 }))
                        {

                            <tr class="tCenter" style="@(item.Data.active_status =="A" ? "color:Default" : "color:Red")">
                                <td class="tCenter" width="10px">@item.Index</td>
                                <td style="text-align:left">@item.Data.new_tag</td>
                                <td style="text-align:left">@item.Data.new_title</td>
                                <td style="text-align:left">@item.Data.new_title_eng</td>
                                <td style="text-align:center">@item.Data.new_date.ToString("dd-MM-yyyy")</td>
                                <td align="center">
                                    <a href="@Url.Content(@item.Data.doc_location+@item.Data.doc_name)" class="marathi_font" target="_blank">
                                        <img src="~/Content/images/pdf-logo.png" width="25" height="25">
                                    </a>
                                </td>
                                <td style="text-align:center">
                                    <div class="dropdown no-arrow">
                                        <a class="dropdown-toggle" href="#" role="button" id="dropdownMenuLink"
                                           data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                            <i class="fas fa-fw fa-wrench"></i>
                                        </a>
                                        <div class="dropdown-menu dropdown-menu-right shadow animated--fade-in"
                                             aria-labelledby="dropdownMenuLink">
                                            <a href="@Url.Content("~/cp_other/cp_other_navintam_addedit?id="+@item.Data.id)" class="dropdown-item edit" data-id="@item.Data.id">Edit</a>
                                            <a href="" class="dropdown-item activeDeactive" data-id="@item.Data.id">@(item.Data.active_status == "A" ? "Remove" : "Add Again")</a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>@*script for activate deactivate*@
<script>
    $(function () {
        $(".activeDeactive").click(function () {
            var $buttonClicked = $(this);
            var id = $buttonClicked.attr('data-id');
            $.ajax({
                type: "Get",
                url: '../cp_other/cp_other_navintam_activeDeactive',
                contentType: "application/json; charset=utf-8",
                data: { "id": id },
                datatype: "text",
                success: function (data, textStatus, jqXHR) {
                    alert(textStatus);
                },
                error: function () {
                    alert("Successfully Saved!");
                }
            });
        });
    });
</script>
