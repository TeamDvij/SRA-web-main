@model SRACMSApplication.Models.projectModel
@{
    ViewBag.Title = "cp_project_addedit";
    Layout = "~/Views/Shared/_MainView.cshtml";
}

@*<link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">
<script src="//code.jquery.com/jquery-1.10.2.js"></script>
<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>*@
<script src="@Url.Content("~/Content/Web/js/bootstrap.min.js")"></script>
<script src="@Url.Content("~/Content/Web/js/jquery-3.5.1.min.js")"></script>

@if (@ViewBag.Message != null)
{
    <script type="text/javascript">
                    window.onload = function () {
                        alert("@ViewBag.Message");
                    };
    </script>
}

@if (@ViewBag.error != null)
{
    <script type="text/javascript">
        window.onload = function () {
            alert("@ViewBag.error");
        };
    </script>
}

@using (Html.BeginForm("cp_project_addedit", "CPAdmin", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <div class="container-fluid">
        <!-- Page Heading -->
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h1 class="h3 mb-0 text-gray-800">Add/Edit प्रकल्प</h1>
            <a href="@Url.Content("~/CPAdmin/cp_project")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
                Back to List
            </a>
        </div>
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h4 style="font-size:medium; color:green">@ViewBag.Message</h4>
            <a href="@Url.Content("~/CPAdmin/cp_project_addedit")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
                Add New
            </a>
        </div>

        <!-- Content Row -->
        <hr />
        <div class="row">
            <div class="col-lg-12">
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("प्रकल्प स्थिती")
                        @Html.DropDownListFor(a => a.project_type, new SelectList(Model.typeList, "value", "text"), "Select", new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.project_type)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("स नं /सि स नं /फा नंबर")
                        @Html.TextBox("survey_no", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.survey_no)
                    </div>
                    <div class="col-sm-6">
                        @Html.Label("Survey Number")
                        @Html.TextBox("survey_no_eng", null, new { @class = "form-control form-control-user" })
                        @Html.ValidationMessageFor(a => a.survey_no_eng)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("प्रकल्प नाव")
                        @Html.TextBox("project_name", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.project_name)
                    </div>
                    <div class="col-sm-6">
                        @Html.Label("project Name")
                        @Html.TextBox("project_name_eng", null, new { @class = "form-control form-control-user" })
                        @Html.ValidationMessageFor(a => a.project_name_eng)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("विकसक")
                        @Html.TextBox("developer_name", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.developer_name)
                    </div>
                    <div class="col-sm-6">
                        @Html.Label("Devloper Name")
                        @Html.TextBox("developer_name_eng", null, new { @class = "form-control form-control-user" })
                        @Html.ValidationMessageFor(a => a.developer_name_eng)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("वास्तुविशारद")
                        @Html.TextBox("architect_name", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.architect_name)
                    </div>
                    <div class="col-sm-6">
                        @Html.Label("Architect Name")
                        @Html.TextBox("architect_name_eng", null, new { @class = "form-control form-control-user" })
                        @Html.ValidationMessageFor(a => a.architect_name_eng)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("पुर्ण झालेला दिनांक")
                        @Html.TextBox("completion_date1", null, new { @class = "date-picker form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.completion_date1)
                    </div>
                    <div class="col-sm-6">
                        @Html.Label("ताब्यात मिळालेल्या सदनिका")
                        @Html.TextBox("occupied_flats", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.occupied_flats)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-3">
                        <input type="submit" value="Submit" class="btn btn-primary btn-user btn-block" />
                    </div>
                </div>
                @Html.HiddenFor(a => a.id)
            </div>
        </div>
    </div>
}

<script type="text/javascript">
    $(function () {
        // This will make every element with the class "date-picker" into a DatePicker element
        $('.date-picker').datepicker({
            dateFormat: 'dd-mm-yy'
        });
    })
</script>