@model SRACMSApplication.Models.projectModel
@{
    ViewBag.Title = "cp_yojna_addedit";
    Layout = "~/Views/Shared/_MainView.cshtml";
}

@*<link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">
<script src="//code.jquery.com/jquery-1.10.2.js"></script>
<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>*@
<script src="@Url.Content("~/Content/Web/js/bootstrap.min.js")"></script>
<script src="@Url.Content("~/Content/Web/js/jquery-3.5.1.min.js")"></script>

@if (@ViewBag.Message != null)
{
    <script type="text/javascript">
                    window.onload = function () {
                        alert("@ViewBag.Message");
                    };
    </script>
}

@if (@ViewBag.error != null)
{
    <script type="text/javascript">
        window.onload = function () {
            alert("@ViewBag.error");
        };
    </script>
}

@using (Html.BeginForm("cp_yojna_addedit", "CPAdmin", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <div class="container-fluid">
        <!-- Page Heading -->
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h1 class="h3 mb-0 text-gray-800">Add/Edit योजना </h1>
            <a href="@Url.Content("~/CPAdmin/cp_yojna")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
                Back to List
            </a>
        </div>
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h4 style="font-size:medium; color:green">@ViewBag.Message</h4>
            <a href="@Url.Content("~/CPAdmin/cp_yojna_addedit")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
                Add New
            </a>
        </div>

        <!-- Content Row -->
        <hr />
        <div class="row">
            <div class="col-lg-12">
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("मास्टर क्रमांक")
                        @Html.TextBox("Master_no", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.Master_no)
                    </div>
                    <div class="col-sm-6">
                        @Html.Label("सादर दिनांक")
                        @Html.TextBox("submission_date1", null, new { @class = "date-picker form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.submission_date1)
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-sm-12">
                        @Html.Label("योजनेचे नाव व पत्ता")
                        @Html.TextBox("project_name", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.project_name)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-12">
                        @Html.Label("Project Name - Address")
                        @Html.TextBox("project_name_eng", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.project_name_eng)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("वॉर्ड")
                        @Html.DropDownListFor(a => a.ward, new SelectList(Model.lst_ward, "id", "ward_name"), "Select", new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.ward)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("योजना सद्यस्थिती")
                        @Html.DropDownListFor(a => a.project_status,
                            new SelectList(Model.lst_yojna_status.Select(x => new
                            {
                                id = x.id,
                                display = x.status
                            }), "id", "display"),
                            "Select",
                            new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.project_status)
                    </div>
                    <div class="col-sm-6">
                        @Html.Label("सक्षम-१/२/३")
                        @Html.DropDownListFor(a => a.ca_dept_id, new SelectList(Model.sys_configList, "id", "sys_name_mar"), "Select", new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.ca_dept_id)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("विकसक")
                        @Html.TextBox("developer_name", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.developer_name)
                    </div>
                    <div class="col-sm-6">
                        @Html.Label("Developer Name")
                        @Html.TextBox("developer_name_eng", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.developer_name_eng)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("वास्तुविशारद")
                        @Html.TextBox("architect_name", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.architect_name)
                    </div>
                    <div class="col-sm-6">
                        @Html.Label("Architect Name")
                        @Html.TextBox("architect_name_eng", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.architect_name_eng)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("झोपडीधारकांची संख्या")
                        @Html.TextBox("total_huts", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.total_huts)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-3">
                        <input type="submit" value="Submit" class="btn btn-primary btn-user btn-block" />
                    </div>
                </div>
                @Html.HiddenFor(a => a.id)
            </div>
        </div>
    </div>
}


<script type="text/javascript">
    $(function () {
        // This will make every element with the class "date-picker" into a DatePicker element
        $('.date-picker').datepicker({
            dateFormat: 'dd-mm-yy'
        });
    })
</script>