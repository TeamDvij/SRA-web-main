@model SRACMSApplication.Models.slumModel
@{
    ViewBag.Title = "cp_slums_addedit";
    Layout = "~/Views/Shared/_MainView.cshtml";
}

@*<link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">
<script src="//code.jquery.com/jquery-1.10.2.js"></script>
<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>*@
<script src="@Url.Content("~/Content/Web/js/bootstrap.min.js")"></script>
<script src="@Url.Content("~/Content/Web/js/jquery-3.5.1.min.js")"></script>

@if (@ViewBag.Message != null)
{
    <script type="text/javascript">
                    window.onload = function () {
                        alert("@ViewBag.Message");
                    };
    </script>
}

@if (@ViewBag.error != null)
{
    <script type="text/javascript">
        window.onload = function () {
            alert("@ViewBag.error");
        };
    </script>
}

@using (Html.BeginForm("cp_slums_addedit", "CPAdmin", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <div class="container-fluid">
        <!-- Page Heading -->
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h1 class="h3 mb-0 text-gray-800">Add/Edit झोपडपट्टयांची यादी</h1>
            <a href="@Url.Content("~/CPAdmin/cp_slums")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
                Back to List
            </a>
        </div>
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h4 style="font-size:medium; color:green">@ViewBag.Message</h4>
            <a href="@Url.Content("~/CPAdmin/cp_slums_addedit")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
                Add New
            </a>
        </div>

        <!-- Content Row -->
        <hr />
        <div class="row">
            <div class="col-lg-12">
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("PMC / PCMC")
                        @Html.DropDownListFor(a => a.pmc_pcmc, new SelectList(Model.typeList, "value", "text"), "Select", new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.pmc_pcmc)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("वार्ड")
                        @Html.TextBox("ward", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.ward)
                    </div>
                    <div class="col-sm-6">
                        @Html.Label("Ward")
                        @Html.TextBox("ward_eng", null, new { @class = "form-control form-control-user" })
                        @Html.ValidationMessageFor(a => a.ward_eng)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("प्रभाग")
                        @Html.TextBox("prabhag", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.prabhag)
                    </div>
                    <div class="col-sm-6">
                        @Html.Label("Prabhag")
                        @Html.TextBox("prabhag_eng", null, new { @class = "form-control form-control-user" })
                        @Html.ValidationMessageFor(a => a.prabhag_eng)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("झोपडपट्टीचे नाव")
                        @Html.TextBox("slum_name", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.slum_name)
                    </div>
                    <div class="col-sm-6">
                        @Html.Label("Slum Name")
                        @Html.TextBox("slum_name_eng", null, new { @class = "form-control form-control-user" })
                        @Html.ValidationMessageFor(a => a.slum_name_eng)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("अंदाजे झोपड्यांची संख्या")
                        @Html.TextBox("hut_count", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.hut_count)
                    </div>
                    <div class="col-sm-6">
                        @Html.Label("Hut Count")
                        @Html.TextBox("hut_count_eng", null, new { @class = "form-control form-control-user" })
                        @Html.ValidationMessageFor(a => a.hut_count_eng)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("क्षेत्रफळ चौ.मी.")
                        @Html.TextBox("slum_area", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.slum_area)
                    </div>
                    <div class="col-sm-6">
                        @Html.Label("Slum Area (SqMtr)")
                        @Html.TextBox("slum_area_eng", null, new { @class = "form-control form-control-user" })
                        @Html.ValidationMessageFor(a => a.slum_area_eng)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("घोषित / अघोषित")
                        @Html.TextBox("declared_nondeclared", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.declared_nondeclared)
                    </div>
                    <div class="col-sm-6">
                        @Html.Label("Declared / Non Declared")
                        @Html.TextBox("declared_nondeclared_eng", null, new { @class = "form-control form-control-user" })
                        @Html.ValidationMessageFor(a => a.declared_nondeclared_eng)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("जमीन मालकी")
                        @Html.TextBox("slum_owner", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.slum_owner)
                    </div>
                    <div class="col-sm-6">
                        @Html.Label("Slum Owner")
                        @Html.TextBox("slum_owner_eng", null, new { @class = "form-control form-control-user" })
                        @Html.ValidationMessageFor(a => a.slum_owner_eng)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-3">
                        <input type="submit" value="Submit" class="btn btn-primary btn-user btn-block" />
                    </div>
                </div>
                @Html.HiddenFor(a => a.id)
            </div>
        </div>
    </div>
}
