<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">गॅलरी</h1>
        <a href="@Url.Content("~/CPAdmin/cp_gallery_add")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            Add New
        </a>
    </div>
    @using (Html.BeginForm("cp_gallery", "CPAdmin", FormMethod.Get))
    {
        <div class="tab-group rates-page-tabs tabStyle galley_box">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs responsive nav-tabs" role="tablist">
                <li role="presentation" class="active">
                    <a href="#photo" aria-controls="mortgage-rates" role="tab" data-toggle="tab">फोटो गॅलरी</a>
                </li>
                <li role="presentation">
                    <a href="#video" aria-controls="mortgage-rates" role="tab" data-toggle="tab">व्हिडिओ गॅलरी</a>
                </li>
                <li role="presentation">
                    <a href="#news" aria-controls="mortgage-rates" role="tab" data-toggle="tab">News</a>
                </li>
            </ul>
            <hr />
            <!-- Tab panes -->
            <div class="tab-content responsive">
                <div role="tabpanel" class="tab-pane active" id="#">
                    <div class="panel-group" id="accordion">
                    </div><!-- /.panel-group -->
                </div>
                <div role="tabpanel" class="tab-pane active gallery_box" id="photo">
                    <div class="multimedia">
                        <h3 style="font-size: medium;">फोटो गॅलरी</h3>
                    </div>
                    <table id="datatable1" class="table table-striped table-bordered pStyle" cellpadding="0" cellspacing="0" width="100%">
                        <thead>
                            <tr>
                                <th style="text-align:center">अ.क्र.</th>
                                <th class="tCenter">अल्बम</th>
                                <th style="text-align:center">पहा</th>
                                <th style="text-align:center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.PhotoGalleryList.Select((x, i) => new { Data = x, Index = i + 1 }))
                            {
                                <tr class="tCenter" style="@(item.Data.active_status =="A" ? "color:Default" : "color:Red")">
                                    <td class="tCenter" width="10px">@item.Index</td>
                                    <td style="text-align:left">@item.Data.album_desc</td>
                                    <td style="text-align:center">
                                        <a href="@Url.Content(item.Data.doc_location+item.Data.doc_name)" target="_blank">
                                            <img src="@Url.Content(item.Data.doc_location + item.Data.doc_name)" style="height:80px" />
                                        </a>
                                    </td>
                                    <td style="text-align:center" width="100px">
                                        <a href="" class="dropdown-item activeDeactive" data-id="@item.Data.id">@(item.Data.active_status == "A" ? "Remove" : "Add Again")</a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
                <div role="tabpanel" class="tab-pane gallery_box" id="video">
                    <div class="multimedia">
                        <h3 style="font-size: medium;">व्हिडिओ गॅलरी</h3>
                    </div>
                    <table id="datatable2" class="table table-striped table-bordered pStyle" cellpadding="0" cellspacing="0" width="100%">
                        <thead>
                            <tr>
                                <th style="text-align:center">अ.क्र.</th>
                                <th class="tCenter">अल्बम</th>
                                <th style="text-align:center">पहा</th>
                                <th style="text-align:center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.VideoGalleryList.Select((x, i) => new { Data = x, Index = i + 1 }))
                            {
                                <tr class="tCenter" style="@(item.Data.active_status =="A" ? "color:Default" : "color:Red")">
                                    <td class="tCenter" width="10px">@item.Index</td>
                                    <td style="text-align:left">@item.Data.album_desc</td>
                                    <td style="text-align:center">
                                        <a href="@Url.Content(item.Data.doc_location+item.Data.doc_name)" target="_blank">
                                            <img src="~/Content/images/video.png" width="25" height="25">
                                        </a>
                                    </td>
                                    <td style="text-align:center" width="100px">
                                        <a href="" class="dropdown-item activeDeactive" data-id="@item.Data.id">@(item.Data.active_status == "A" ? "Remove" : "Add Again")</a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

                <div role="tabpanel" class="tab-pane gallery_box" id="news">
                    <div class="multimedia">
                        <h3 style="font-size: medium;">News</h3>
                    </div>
                    <table id="datatable3" class="table table-striped table-bordered pStyle" cellpadding="0" cellspacing="0" width="100%">
                        <thead>
                            <tr>
                                <th style="text-align:center">अ.क्र.</th>
                                <th class="tCenter">News</th>
                                <th style="text-align:center">पहा</th>
                                <th style="text-align:center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.NewsGalleryList.Select((x, i) => new { Data = x, Index = i + 1 }))
                            {
                                <tr class="tCenter" style="@(item.Data.active_status =="A" ? "color:Default" : "color:Red")">
                                    <td class="tCenter" width="10px">@item.Index</td>
                                    <td style="text-align:left">@item.Data.album_desc</td>
                                    <td style="text-align:center">
                                        <a href="@Url.Content(item.Data.doc_location+item.Data.doc_name)" target="_blank">
                                            <img src="@Url.Content(item.Data.doc_location + item.Data.doc_name)" style="height:80px" />
                                        </a>
                                    </td>
                                    <td style="text-align:center" width="100px">
                                        <a href="" class="dropdown-item activeDeactive" data-id="@item.Data.id">@(item.Data.active_status == "A" ? "Remove" : "Add Again")</a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>


            </div>
        </div>
    }
</div>
@*script for activate deactivate*@
<script>
        $(function () {
            $(".activeDeactive").click(function () {
                var $buttonClicked = $(this);
                var id = $buttonClicked.attr('data-id');
                $.ajax({
                    type: "Get",
                    url: '../CPAdmin/cp_gallery_activeDeactive',
                    contentType: "application/json; charset=utf-8",
                    data: { "id": id },
                    datatype: "text",
                    success: function (data, textStatus, jqXHR) {
                        alert(textStatus);
                    },
                    error: function () {
                        alert("Successfully Saved!");
                    }
                });
            });
        });
</script>