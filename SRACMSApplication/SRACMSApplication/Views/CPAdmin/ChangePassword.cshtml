@model SRACMSApplication.Models.mst_userModel
@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Views/Shared/_MainView.cshtml";
}

@*<link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">
    <script src="//code.jquery.com/jquery-1.10.2.js"></script>
    <script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>*@
<script src="@Url.Content("~/Content/Web/js/bootstrap.min.js")"></script>
<script src="@Url.Content("~/Content/Web/js/jquery-3.5.1.min.js")"></script>

@if (@ViewBag.Message != null)
{
    <script type="text/javascript">
                    window.onload = function () {
                        alert("@ViewBag.Message");
                    };
    </script>
}

@if (@ViewBag.error != null)
{
    <script type="text/javascript">
        window.onload = function () {
            alert("@ViewBag.error");
        };
    </script>
}

@using (Html.BeginForm("ChangePassword", "CPAdmin", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <div class="container-fluid">
        <!-- Page Heading -->
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h1 class="h3 mb-0 text-gray-800">Change Password : User @Session["UserName"]</h1>
        </div>
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h4 style="font-size:medium; color:green">@ViewBag.Message</h4>
        </div>

        <!-- Content Row -->
        <hr />
        <div class="row">
            <div class="col-lg-12">
                <div class="form-group row">
                    @*<div class="col-sm-4">
                            @Html.Label("User Name")
                            @Html.TextBox("user_name", null, new { @class = "form-control form-control-user", disabled = "true", @required = "required" })
                            @Html.ValidationMessageFor(a => a.user_name)
                        </div>*@
                    <div class="col-sm-4">
                        @Html.Label("User's First Name")
                        @Html.TextBox("user_fname", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.user_fname)
                    </div>
                    <div class="col-sm-4">
                        @Html.Label("User's Last Name")
                        @Html.TextBox("user_lname2", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.user_lname2)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-4">
                        @Html.Label("Old Password")
                        @Html.TextBox("user_old_password", null, new { @class = "form-control form-control-user", placeholder = "Old Password", @required = "required", @type = "password" })
                        @Html.ValidationMessageFor(a => a.user_old_password)
                    </div>
                    @*<div class="col-sm-4">
                            @Html.Label("New Password")
                            @Html.TextBox("user_create_password", null, new { @class = "form-control form-control-user", placeholder = "New Password", @required = "required", @type = "password" })
                            @Html.ValidationMessageFor(a => a.user_create_password)
                        </div>*@
                    <div class="col-sm-4">
                        @Html.Label("New Password")
                        @Html.PasswordFor(a => a.user_create_password, new
                        {
                            @class = "form-control",
                            placeholder = "Enter New Password",
                            pattern = "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[^a-zA-Z0-9]).{8,}$",
                            title = "Password must contain at least 1 uppercase, 1 lowercase, 1 digit, 1 special character and minimum 8 characters",
                            required = "required"
                        })
                        @Html.ValidationMessageFor(a => a.user_create_password, "", new { @class = "text-danger" })
                    </div>

                    @*<div class="col-sm-4">
                            @Html.Label("Confirm Password")
                            @Html.TextBox("user_confirm_password", null, new { @class = "form-control form-control-user", placeholder = "Confirm Password", @required = "required", @type = "password" })
                            @Html.ValidationMessageFor(a => a.user_confirm_password)
                        </div>*@
                    <div class="col-sm-4">
                        @Html.Label("Confirm Password")
                        @Html.PasswordFor(a => a.user_confirm_password, new
                        {
                            @class = "form-control",
                            placeholder = "Enter New Password",
                            pattern = "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[^a-zA-Z0-9]).{8,}$",
                            title = "Password must contain at least 1 uppercase, 1 lowercase, 1 digit, 1 special character and minimum 8 characters",
                            required = "required"
                        })
                        @Html.ValidationMessageFor(a => a.user_confirm_password, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-3">
                        <input type="submit" value="Change Password" class="btn btn-primary btn-user btn-block" />
                    </div>
                </div>
                @Html.HiddenFor(a => a.user_id)
            </div>
        </div>
    </div>
}


<script>
    document.getElementById("user_create_password").addEventListener("input", function () {
        var oldPwd = document.getElementById("user_old_password").value;
        var newPwd = this.value;

        if (oldPwd && newPwd && oldPwd === newPwd) {
            this.setCustomValidity("New password must be different from old password.");
        } else {
            this.setCustomValidity("");
        }
    });
</script>
