@model SRACMSApplication.Models.mst_userModel
@{
    ViewBag.Title = "cp_user_addedit";
    Layout = "~/Views/Shared/_MainView.cshtml";
}

@*<link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">
<script src="//code.jquery.com/jquery-1.10.2.js"></script>
<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>*@
<script src="@Url.Content("~/Content/Web/js/bootstrap.min.js")"></script>
<script src="@Url.Content("~/Content/Web/js/jquery-3.5.1.min.js")"></script>

@if (@ViewBag.Message != null)
{
    <script type="text/javascript">
                    window.onload = function () {
                        alert("@ViewBag.Message");
                    };
    </script>
}

@if (@ViewBag.error != null)
{
    <script type="text/javascript">
        window.onload = function () {
            alert("@ViewBag.error");
        };
    </script>
}

@using (Html.BeginForm("cp_user_addedit", "CPAdmin", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <div class="container-fluid">
        <!-- Page Heading -->
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h1 class="h3 mb-0 text-gray-800">Add/Edit User</h1>
            <a href="@Url.Content("~/CPAdmin/cp_user")">
                Back to List
            </a>
        </div>
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h4 style="font-size:medium; color:green">@ViewBag.Message</h4>
            <a href="@Url.Content("~/CPAdmin/cp_user_addedit")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
                Add New
            </a>
        </div>

        <!-- Content Row -->
        <hr />
        <div class="row">
            <div class="col-lg-12">
                <div class="form-group row">
                    <div class="col-sm-4">
                        @Html.Label("Role")
                        @Html.DropDownListFor(a => a.user_role_id, new SelectList(Model.mst_roleList, "id", "role_name"), "Select", new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.user_role_id)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-4">
                        @Html.Label("User Name")
                        @Html.TextBox("user_name", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.user_name)
                    </div>
                    <div class="col-sm-4">
                        @Html.Label("Password")
                        @Html.TextBox("user_create_password", null, new { @class = "form-control form-control-user", @required = "required", @type = "password" })
                        @Html.ValidationMessageFor(a => a.user_create_password)
                    </div>
                    <div class="col-sm-4">
                        @Html.Label("Confirm Password")
                        @Html.TextBox("user_confirm_password", null, new { @class = "form-control form-control-user", @required = "required", @type = "password" })
                        @Html.ValidationMessageFor(a => a.user_confirm_password)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-4">
                        @Html.Label("First Name")
                        @Html.TextBox("user_fname", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.user_fname)
                    </div>
                    <div class="col-sm-4">
                        @Html.Label("Middle Name")
                        @Html.TextBox("user_mname1", null, new { @class = "form-control form-control-user"})
                        @Html.ValidationMessageFor(a => a.user_mname1)
                    </div>
                    <div class="col-sm-4">
                        @Html.Label("Lst Name")
                        @Html.TextBox("user_lname2", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.user_lname2)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-3">
                        <input type="submit" value="Submit" class="btn btn-primary btn-user btn-block" />
                    </div>
                </div>
                @Html.HiddenFor(a => a.user_id)
            </div>
        </div>
    </div>
}
