@model SRACMSApplication.Models.galaryModel
@{
    ViewBag.Title = "cp_gallery_add";
    Layout = "~/Views/Shared/_MainView.cshtml";
}

@*<link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">
<script src="//code.jquery.com/jquery-1.10.2.js"></script>
<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>*@
<script src="@Url.Content("~/Content/Web/js/bootstrap.min.js")"></script>
<script src="@Url.Content("~/Content/Web/js/jquery-3.5.1.min.js")"></script>

@if (@ViewBag.Message != null)
{
    <script type="text/javascript">
                    window.onload = function () {
                        alert("@ViewBag.Message");
                    };
    </script>
}
@if (@ViewBag.fileExtensionMessage != null)
{
    <script type="text/javascript">
                    window.onload = function () {
                        alert("@ViewBag.fileExtensionMessage");
                    };
    </script>
}

@if (@ViewBag.error != null)
{
    <script type="text/javascript">
        window.onload = function () {
            alert("@ViewBag.error");
        };
    </script>
}

@using (Html.BeginForm("cp_gallery_add", "CPAdmin", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <div class="container-fluid">
        <!-- Page Heading -->
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h1 class="h3 mb-0 text-gray-800">Add गॅलरी </h1>
            <a href="@Url.Content("~/CPAdmin/cp_gallery")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
                Back to List
            </a>
        </div>
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h4 style="font-size:medium; color:green">@ViewBag.Message</h4>
        </div>

        <!-- Content Row -->
        <hr />
        <div class="row">
            <div class="col-lg-12">
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("Photo Gallery/Video Gallery")
                        @Html.DropDownListFor(a => a.photo_video, new SelectList(Model.photo_video_List, "value", "text"), "Select", new { @class = "change form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.photo_video)
                    </div>
                    <div class="col-sm-6">
                        <label for="albumDropdown"><b>Album</b></label>
                        <select class="changeAlbum form-control" id="albumDropdown" name="albumDropdown"></select>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("गॅलरी नाव")
                        @Html.TextBox("album_desc", null, new { @class = "form-control form-control-user",  @required = "required" })
                        @Html.ValidationMessageFor(a => a.album_desc)
                    </div>
                    <div class="col-sm-6">
                        @Html.Label("Gallery Name")
                        @Html.TextBox("album_desc_eng", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.album_desc_eng)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("Upload File")
                            <input type="file" id="file" name="postedFile" multiple accept=".jpeg/.jpg/.mp4" required />
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-3">
                        <input type="submit" value="Submit" class="btn btn-primary btn-user btn-block" />
                    </div>
                </div>
                @Html.HiddenFor(a => a.id)
            </div>
        </div>
    </div>
}
<script>
        $(function () {
            $(".change").change(function () {
                var $buttonClicked = $(this);
                var id = $buttonClicked.attr('data-id');
                var selectedText = $(this).find("option:selected").text();
                var selectedValue = $(this).val();
                
                $.ajax({
                    type: "GET",
                    url: '../CPAdmin/cp_gallery_getGalleries',
                    contentType: "application/json; charset=utf-8",
                    data: { "type": selectedValue },
                    datatype: "text",
                    success: function (data) {
                        var s = '<option value="-1">Select</option>';
                        for (var i = 0; i < data.length; i++) {
                            s += '<option value="' + data[i].album_eng + '">' + data[i].album + '</option>';
                        }
                        $("#albumDropdown").html(s);
                    },
                    error: function () {
                        alert("Successfully Saved!");
                    }
                });
            });
            
        });
        $(function () {
        $(".changeAlbum").change(function () {
            var $buttonClicked = $(this);
            var id = $buttonClicked.attr('data-id');
            var selectedText = $(this).find("option:selected").text();
            var selectedValue = $(this).val();
                
            $("#album_desc_eng").val(selectedValue);
            $("#album_desc").val(selectedText);
        });
        });

</script>


@if (@ViewBag.fileExtensionMessage != null)
{
    <script type="text/javascript">
        window.onload = function () {
            alert("@ViewBag.fileExtensionMessage");
        };
    </script>
}
<script type="text/javascript">
    $(function () {
        // This will make every element with the class "date-picker" into a DatePicker element
        $('.date-picker').datepicker({
            dateFormat: 'dd-mm-yy'
        });
    })
    $('#file').on('change', function () {
        var val = $(this).val().toLowerCase();
        var regex = new RegExp("(.*?)\.(jpg|jpeg|mp4)$");
        if (!(regex.test(val))) {
            $(this).val('');
            alert('Select valid file!');
        }
    });
</script>