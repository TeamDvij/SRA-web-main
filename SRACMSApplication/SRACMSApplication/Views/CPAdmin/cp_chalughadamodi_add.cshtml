@model SRACMSApplication.Models.mst_single_image_pdfModel
@{
    ViewBag.Title = "cp_chalughadamodi_add";
    Layout = "~/Views/Shared/_MainView.cshtml";
}

@*<link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">
<script src="//code.jquery.com/jquery-1.10.2.js"></script>
<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>*@
<script src="@Url.Content("~/Content/Web/js/bootstrap.min.js")"></script>
<script src="@Url.Content("~/Content/Web/js/jquery-3.5.1.min.js")"></script>

@if (@ViewBag.Message != null)
{
    <script type="text/javascript">
                    window.onload = function () {
                        alert("@ViewBag.Message");
                    };
    </script>
}

@if (@ViewBag.error != null)
{
    <script type="text/javascript">
        window.onload = function () {
            alert("@ViewBag.error");
        };
    </script>
}

@using (Html.BeginForm("cp_chalughadamodi_add", "CPAdmin", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <div class="container-fluid">
        <!-- Page Heading -->
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h1 class="h3 mb-0 text-gray-800">Add : बातम्या</h1>
            <a href="@Url.Content("~/CPAdmin/cp_chalughadamodi")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
                Back to List
            </a>
        </div>
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h4 style="font-size:medium; color:green">@ViewBag.Message</h4>
            <a href="@Url.Content("~/CPAdmin/cp_chalughadamodi_add")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
                Add New
            </a>
        </div>

        <!-- Content Row -->
        <hr />
        <div class="row">
            <div class="col-lg-12">
                <h4>Select Year from List or Enter new Year</h4>
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("शीर्षक/Title")
                        @Html.DropDownListFor(a => a.title_eng, new SelectList(ViewBag.YearListItems, "value", "text"), "Select", new { @class = "change form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.title_eng)
                    </div>
                    <div class="col-sm-6">
                        @Html.Label("शीर्षक/Title")
                        @Html.TextBox("title1", null, new { @class = "form-control form-control-user", @required = "required" })
                        @Html.ValidationMessageFor(a => a.title1)
                    </div>
                </div>
                    <div class="form-group row">
                        <div class="col-sm-3">
                            <label for="imgInp">
                                <i class="fa fa-cloud-upload"></i>Add बातम्या ( NEWS )
                            </label>
                            <input type="file" id="imgInp" name="postedFile" multiple accept=".jpg,.jpeg" required />
                        </div>
                    </div>

                @*<div class="form-group row">
                    <div class="col-sm-9">
                        <img id="blah" class="photo" ImageUrl="" />
                    </div>
                </div>*@
                <div class="form-group row">
                    <div class="col-sm-3">
                        <input type="submit" value="Submit" class="btn btn-primary btn-user btn-block" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}


<script>
//Preview & Update an image before it is uploaded
    function readURL(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();

            reader.onload = function (e) {
                $('#blah').attr('src', e.target.result);
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    $("#imgInp").change(function () {
        readURL(this);
    });

    $(function () {
        $(".change").change(function () {
            var $buttonClicked = $(this);
            var id = $buttonClicked.attr('data-id');
            var selectedText = $(this).find("option:selected").text();
            var selectedValue = $(this).val();
            $("#title1").val(selectedText);
        });
    });
</script>

<style type="text/css">
    .photo {
        width: 50em;
        height: 15em;
        border: 1px solid rgb(197, 197, 197);
        border-radius: 4px 4px 4px 4px;
    }
</style>