@model SRACMSApplication.Models.faqModel
@{
    ViewBag.Title = "cp_faq_addedit";
    Layout = "~/Views/Shared/_MainView.cshtml";
}

@*<link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">
<script src="//code.jquery.com/jquery-1.10.2.js"></script>
<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>*@
<script src="@Url.Content("~/Content/Web/js/bootstrap.min.js")"></script>
<script src="@Url.Content("~/Content/Web/js/jquery-3.5.1.min.js")"></script>

@if (@ViewBag.Message != null)
{
    <script type="text/javascript">
                    window.onload = function () {
                        alert("@ViewBag.Message");
                    };
    </script>
}

@if (@ViewBag.error != null)
{
    <script type="text/javascript">
        window.onload = function () {
            alert("@ViewBag.error");
        };
    </script>
}

@using (Html.BeginForm("cp_faq_addedit", "CPAdmin", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <div class="container-fluid">
        <!-- Page Heading -->
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h1 class="h3 mb-0 text-gray-800">Add/Edit शंका समाधान</h1>
            <a href="@Url.Content("~/CPAdmin/cp_faq")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
                Back to List
            </a>
        </div>
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <h4 style="font-size:medium; color:green">@ViewBag.Message</h4>
            <a href="@Url.Content("~/CPAdmin/cp_faq_addedit")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
                Add New
            </a>
        </div>

        <!-- Content Row -->
        <hr />
        <div class="row">
            <div class="col-lg-12">
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("शंका")
                        @Html.TextArea("faq1", null,  new { @class = "form-control form-control-user", rows = "3", @required = "required" })    
                        @Html.ValidationMessageFor(a => a.faq1)
                        </div>
                    <div class="col-sm-6">
                        @Html.Label("Faq")
                        @Html.TextArea("faq_eng", null, new { @class = "form-control form-control-user", rows = "3", @required = "required" })
                        @Html.ValidationMessageFor(a => a.faq_eng)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-6">
                        @Html.Label("समाधान")
                        @Html.TextArea("answer", null, new { @class = "form-control form-control-user", rows = "7", @required = "required" })
                        @Html.ValidationMessageFor(a => a.answer)
                    </div>
                    <div class="col-sm-6">
                        @Html.Label("Answer")
                        @Html.TextArea("answer_eng", null, new { @class = "form-control form-control-user", rows = "7", @required = "required" })
                        @Html.ValidationMessageFor(a => a.answer_eng)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-3">
                        <input type="submit" value="Submit" class="btn btn-primary btn-user btn-block" />
                    </div>
                </div>
                @Html.HiddenFor(a => a.id)
            </div>
        </div>
    </div>
}
