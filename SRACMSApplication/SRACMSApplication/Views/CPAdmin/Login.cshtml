@model SRACMSApplication.Models.mst_userModel
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<script src="~/Content/webcss/refresh-captcha.js"></script>

<style>
    .lblStyle {
        text-align: right;
        margin-top: 5px;
        margin-left: -44px;
    }
</style>
@{
    ViewBag.Title = "Index";
    //Layout = "~/Views/Shared/_DefaultView.cshtml";
}
@using (Html.BeginForm("Login", "CPAdmin", FormMethod.Post))
{
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <meta name="description" content="">
        <meta name="author" content="">
        <title>SRA Pune Website CMS</title>
        <!-- Custom fonts for this template-->
        <link href="~/Contents/vendor//fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
        <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
              rel="stylesheet">
        <!-- Custom styles for this template-->
        <link href="~/Contents/css/sb-admin-2.min.css" rel="stylesheet">
    </head>

    <body class="bg-gradient-primary">
        <div class="container">
            <!-- Outer Row -->
            <div class="row justify-content-center">
                <div class="col-xl-10 col-lg-12 col-md-9">
                    <div class="card o-hidden border-0 shadow-lg my-5">
                        <div class="card-body p-0">
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true)
                            <div class="row">
                                <div class="col-lg-6 d-none d-lg-block"><img src="~/Content/images/SRA-Logo.jpg" style="width:500px; height:400px" /></div>
                                <div class="col-lg-6">
                                    <div class="p-5">
                                        <div class="text-center">
                                            <h1 class="h4 text-gray-900 mb-4">Login!</h1>
                                        </div>
                                        <form class="user">
                                            <div class="form-group">
                                                @Html.TextBox("user_name", null, new { @class = "form-control form-control-user", @required = "required", placeholder = "User Name" })
                                                @Html.ValidationMessageFor(a => a.user_name)

                                            </div>
                                            <div class="form-group">
                                                @Html.TextBox("user_password", null, new { @class = "form-control form-control-user", placeholder = "Password", @required = "required", @type = "password" })
                                                @Html.ValidationMessageFor(a => a.user_password)
                                            </div>
                                            <div class="form-group row">
                                                <div class="col-sm-6">
                                                    @Html.Label("CAPTCHA")
                                                    <img id="captchaImg" src="@Url.Action("GenerateCaptcha", "CPAdmin")" alt="Captcha Image" style="width:100px; height:auto;" />
                                                    <button type="button" title="Refresh CAPTCHA" onclick="refreshCaptcha()" style="color:white; background-color:#004274; width:30px; height:30px; border-radius:20%;">&#x21bb;</button>
                                                </div>
                                                <div class="col-sm-6">
                                                    @Html.Label("Enter CAPTCHA")<span class="mandatory">*</span>
                                                    @Html.TextBox("CaptchaCode", null, new { @class = "form-control form-control-user", @required = "required" })
                                                    @Html.ValidationMessageFor(m => m.CaptchaCode)
                                                </div>
                                            </div>
                                            @*<div class="form-group">
                                                    <div class="custom-control custom-checkbox small">
                                                        <input type="checkbox" class="custom-control-input" id="customCheck">
                                                        <label class="custom-control-label" for="customCheck">
                                                            Remember
                                                            Me
                                                        </label>
                                                    </div>
                                                </div>*@
                                            <input type="submit" value="Login" class="btn btn-primary btn-user btn-block" />
                                        </form>
                                        @if (@ViewBag.Message != null)
                                        {
                                            <hr />
                                            <div class="h6" style="color:red; font-size:small">
                                                @ViewBag.Message
                                            </div>
                                        }
                                        <hr>
                                        @*<div class="text-center">
                                                <a class="small" href="#">Forgot Password?</a>
                                            </div>*@

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Bootstrap core JavaScript-->
        <script src="~/Contents/vendor//jquery/jquery.min.js"></script>
        <script src="~/Contents/vendor//bootstrap/js/bootstrap.bundle.min.js"></script>
        <!-- Core plugin JavaScript-->
        <script src="~/Contents/vendor//jquery-easing/jquery.easing.min.js"></script>
        <!-- Custom scripts for all pages-->
        <script src="~/Contents/js/sb-admin-2.min.js"></script>
    </body>
}

<script>
    $(document).ready(function () { $("input").attr("autocomplete", "off"); });
</script>