@model SRACMSApplication.Models.projectModel
@{
    ViewBag.Title = "cp_yojna";
    Layout = "~/Views/Shared/_MainView.cshtml";
}
<script src="~/Contents/vendor/jquery/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        $('#datatable').dataTable(),
            $("[data-toggle=tooltip]").tooltip();
    });
</script>
<style>
    .collapsible {
        background-color: #777;
        color: white;
        cursor: pointer;
        padding: 18px;
        width: 100%;
        border: none;
        text-align: left;
        outline: none;
        font-size: 15px;
    }

        .active, .collapsible:hover {
            background-color: #555;
        }

    .content {
        padding: 0 18px;
        display: none;
        overflow: hidden;
        background-color: #f1f1f1;
    }
</style>

<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">झोपूप्रा पुणे योजना</h1>
        <a href="@Url.Content("~/CPAdmin/cp_yojna_addedit")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            Add New
        </a>
    </div>
    @using (Html.BeginForm("cp_yojna", "CPAdmin", FormMethod.Get))
    {
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" style="font-size:small" id="dataTable">
                    <thead>
                        <tr>
                            <th style="text-align:center">अ.क्र.</th>
                            <th class="tCenter">मा.क्र.</th>
                            <th class="tCenter">सादर दिनांक</th>
                            <th class="tCenter">विभाग</th>
                            <th class="tCenter">योजना</th>
                            <th class="tCenter">झोपडीधारकांची संख्या</th>
                            <th class="tCenter">विकसक</th>
                            <th class="tCenter">वास्तुविशारद</th>
                            <th class="tCenter">सद्यस्थिती</th>
                            <th style="text-align:center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.yojna_list.Select((x, i) => new { Data = x, Index = i + 1 }))
                        {
                            <tr class="tCenter" style="@(item.Data.active_status =="A" ? "color:Default" : "color:Red")">
                                <td style="text-align:center">@item.Index.</td>
                                <td style="text-align:center">@item.Data.Master_no</td>
                                <td style="text-align:center">@item.Data.submission_date</td>
                                <td style="text-align:center">सक्षम @item.Data.ca_dept_id</td>
                                <td style="text-align:left">@item.Data.project_name</td>
                                <td style="text-align:center">@item.Data.total_huts</td>
                                <td style="text-align:left">@item.Data.developer_name</td>
                                <td style="text-align:left">@item.Data.architect_name</td>
                                <td style="text-align:left">@item.Data.project_status1.status</td>
                                <td style="text-align:center">
                                    <div class="dropdown no-arrow">
                                        <a class="dropdown-toggle" href="#" role="button" id="dropdownMenuLink"
                                           data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                            <i class="fas fa-fw fa-wrench"></i>
                                        </a>
                                        <div class="dropdown-menu dropdown-menu-right shadow animated--fade-in"
                                             aria-labelledby="dropdownMenuLink">
                                            <a href="@Url.Content("~/CPAdmin/cp_yojna_addedit?id="+@item.Data.id)" class="dropdown-item edit" data-id="@item.Data.id">Edit</a>
                                            <a href="" class="dropdown-item activeDeactive" data-id="@item.Data.id">@(item.Data.active_status == "A" ? "Remove" : "Add Again")</a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>@*script for activate deactivate*@
<script>
    $(function () {
        $(".activeDeactive").click(function () {
            var $buttonClicked = $(this);
            var id = $buttonClicked.attr('data-id');
            $.ajax({
                type: "Get",
                url: '../CPAdmin/cp_yojna_activeDeactive',
                contentType: "application/json; charset=utf-8",
                data: { "id": id },
                datatype: "text",
                success: function (data, textStatus, jqXHR) {
                    alert(textStatus);
                },
                error: function () {
                    alert("Successfully Saved!");
                }
            });
        });
    });
</script>