@model List<SRACMSApplication.Models.mst_single_image_pdfModel>
@{
    ViewBag.Title = "cp_chalughadamodi";
    Layout = "~/Views/Shared/_MainView.cshtml";
}

<script src="~/Contents/vendor/jquery/jquery.min.js"></script>

@if (@ViewBag.activeDeactiveMessage != null)
{
    <script type="text/javascript">
                    window.onload = function () {
                        alert("@ViewBag.activeDeactiveMessage");
                    };
    </script>
}
<script>
    $(document).ready(function () {
        $('#datatable').dataTable(),
        $("[data-toggle=tooltip]").tooltip();
    });
</script>

<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">बातम्या</h1>
        <a href="@Url.Content("~/CPAdmin/cp_chalughadamodi_add")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            Add New
        </a>
    </div>
    @using (Html.BeginForm("cp_chalughadamodi", "CPAdmin", FormMethod.Get))
    {
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" style="font-size:small" id="dataTable">
                    <thead>
                        <tr>
                            <th style="text-align:center">अ.क्र.</th>
                            <th style="text-align:center">शीर्षक</th>
                            <th style="text-align:center">बातमी</th>
                            <th style="text-align:center">कृती</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Select((x, i) => new { Data = x, Index = i + 1 }))
                        {
                            <tr class="tCenter" style="@(item.Data.active_status =="A" ? "color:Default" : "color:Red")">
                                <td align="center" width="10px">@item.Index</td>
                                <td align="center" width="10px">@item.Data.title1</td>
                                <td>
                                    <a href="@Url.Content(item.Data.doc_location+item.Data.doc_name)" target="_blank">
                                        <img src="@Url.Content(item.Data.doc_location+item.Data.doc_name)" style="height:80px" />
                                    </a>
                                </td>
                                <td width="50px">
                                    <a href="" style="color:blue" class="dropdown-item activeDeactive" data-id="@item.Data.id">@(item.Data.active_status == "A" ? "Remove" : "Add Again")</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>@*script for activate deactivate*@
<script>
        $(function () {
            $(".activeDeactive").click(function () {
                var $buttonClicked = $(this);
                var id = $buttonClicked.attr('data-id');
                $.ajax({
                    type: "Get",
                    url: '../CPAdmin/cp_chalughadamodi_activeDeactive',
                    contentType: "application/json; charset=utf-8",
                    data: { "id": id },
                    datatype: "text",
                    success: function (data, textStatus, jqXHR) {
                        alert(textStatus);
                    },
                    error: function () {
                        alert("Successfully Saved!");
                    }
                });
            });
        });
</script>
