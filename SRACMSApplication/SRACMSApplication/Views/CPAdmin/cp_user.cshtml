@model SRACMSApplication.Models.mst_userModel
@{
    ViewBag.Title = "cp_user";
    Layout = "~/Views/Shared/_MainView.cshtml";
}
<script src="~/Contents/vendor/jquery/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        $('#datatable').dataTable({
            order: [],
            columnDefs: [{ orderable: false, targets: [0,1,2,3,4] }]
        }),
        $("[data-toggle=tooltip]").tooltip();
    });

</script>

<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">User / युसर</h1>
        <a href="@Url.Content("~/CPAdmin/cp_user_addedit")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            Add New
        </a>
    </div>
    @using (Html.BeginForm("cp_user", "CPAdmin", FormMethod.Get))
    {
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" style="font-size:small" id="dataTable">
                    <thead>
                        <tr style="height:46px;">
                            <th>Sr.No.</th>
                            <th>User Name</th>
                            <th>Pssword</th>
                            <th>Role</th>
                            <th>First Name</th>
                            <th>Middle Name</th>
                            <th>Last Name</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.mst_userList.Select((x, i) => new { Data = x, Index = i + 1 }))
                        {
                            <tr class="tCenter" style="@(item.Data.active_status =="A" ? "color:Default" : "color:Red")">
                                <td class="tCenter" width="10px">@item.Index</td>
                                <td width="20px">@item.Data.user_name</td>
                                <td width="20px">@item.Data.user_password</td>
                                <td width="500px">@item.Data.mst_role.role_name</td>
                                <td width="20px">@item.Data.user_fname</td>
                                <td width="20px">@item.Data.user_mname1</td>
                                <td width="20px">@item.Data.user_lname2</td>
                                <td align="center">
                                    <div class="dropdown no-arrow">
                                        <a class="dropdown-toggle" href="#" role="button" id="dropdownMenuLink"
                                           data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                            <i class="fas fa-fw fa-wrench"></i>
                                        </a>
                                        <div class="dropdown-menu dropdown-menu-right shadow animated--fade-in"
                                             aria-labelledby="dropdownMenuLink">
                                            <a href="@Url.Content("~/CPAdmin/cp_user_addedit?id="+@item.Data.user_id)" class="dropdown-item edit" data-id="@item.Data.user_id">Edit</a>
                                            <a href="" class="dropdown-item activeDeactive" data-id="@item.Data.user_id">@(item.Data.active_status == "A" ? "Remove" : "Add Again")</a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
@*script for activate deactivate*@
<script>
        $(function () {
            $(".activeDeactive").click(function () {
                var $buttonClicked = $(this);
                var id = $buttonClicked.attr('data-id');
                $.ajax({
                    type: "Get",
                    url: '../CPAdmin/cp_user_activeDeactive',
                    contentType: "application/json; charset=utf-8",
                    data: { "id": id },
                    datatype: "text",
                    success: function (data, textStatus, jqXHR) {
                        alert(textStatus);
                    },
                    error: function () {
                        alert("Successfully Saved!");
                    }
                });
            });
        });
</script>