<script>
    let event2Index = 0;
    function moveEvent2Slide(direction) {
        const track = document.querySelector('.event2-track');
        const images = document.querySelectorAll('.event2-track img');
        const imageWidth = images[0].clientWidth + 30;

        event2Index += direction;
        const maxIndex = images.length - Math.floor(document.querySelector('.event2-container').clientWidth / imageWidth);

        if (event2Index < 0) event2Index = 0;
        if (event2Index > maxIndex) event2Index = maxIndex;

        track.style.transform = `translateX(-${event2Index * imageWidth}px)`;
    }

</script>

<script>
    const modal = document.getElementById("modal");
    const modalImg = document.getElementById("modal-img");
    const captionText = document.getElementById("caption");
    const closeBtn = document.getElementById("close");
    const zoomInBtn = document.getElementById("zoom-in");
    const zoomOutBtn = document.getElementById("zoom-out");

    const galleryItems = document.querySelectorAll(".gallery-item");
    let scale = 1;

    galleryItems.forEach(item => {
        item.addEventListener("click", function () {
            modal.style.display = "flex";
            modalImg.src = this.src;
            captionText.innerHTML = this.alt;
            scale = 1; // Reset scale when a new image is opened
            modalImg.style.transform = `scale(${scale})`;
        });
    });

    closeBtn.addEventListener("click", function () {
        modal.style.display = "none";
    });

    window.addEventListener("click", function (event) {
        if (event.target === modal) {
            modal.style.display = "none";
        }
    });

    zoomInBtn.addEventListener("click", function () {
        scale += 0.1; // Increase scale
        modalImg.style.transform = `scale(${scale})`;
    });

    zoomOutBtn.addEventListener("click", function () {
        if (scale > 0.1) {
            scale -= 0.1; // Decrease scale
            modalImg.style.transform = `scale(${scale})`;
        }
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let scale = 1;
        const zoomStep = 0.2;
        let activeImg = null;

        // Create Zoom Control Buttons
        const zoomControls = document.createElement("div");
        zoomControls.id = "zoomControls";
        zoomControls.innerHTML = `
        <button id="zoomIn">+</button>
        <button id="zoomOut">-</button>
    `;
        zoomControls.style.position = "fixed";
        zoomControls.style.bottom = "20px";
        zoomControls.style.left = "50%";
        zoomControls.style.transform = "translateX(-50%)";
        zoomControls.style.zIndex = "1000";
        zoomControls.style.display = "none"; // Initially hidden
        document.body.appendChild(zoomControls);

        // Function to reset zoom
        function resetZoom() {
            if (activeImg) {
                activeImg.style.transform = "scale(1)";
                scale = 1;
            }
        }

        // Apply zoomable functionality
        document.querySelectorAll(".zoomable").forEach(img => {
            img.addEventListener("click", function () {
                // Reset previous zoom if a new image is clicked
                if (activeImg && activeImg !== this) {
                    resetZoom();
                }

                activeImg = this;
                zoomControls.style.display = "block"; // Show zoom buttons
            });
        });

        // Zoom-In Button
        document.getElementById("zoomIn").addEventListener("click", () => {
            if (activeImg) {
                scale += zoomStep;
                activeImg.style.transform = `scale(${scale})`;
            }
        });

        // Zoom-Out Button
        document.getElementById("zoomOut").addEventListener("click", () => {
            if (activeImg) {
                scale -= zoomStep;
                if (scale < 1) scale = 1; // Prevent shrinking below original size
                activeImg.style.transform = `scale(${scale})`;
            }
        });

        // Hide zoom controls when clicking outside an image
        document.addEventListener("click", function (event) {
            if (!event.target.classList.contains("zoomable")) {
                zoomControls.style.display = "none";
                resetZoom();
            }
        });
    });

</script>
