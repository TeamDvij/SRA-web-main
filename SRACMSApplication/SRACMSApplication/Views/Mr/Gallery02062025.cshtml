<div class="sramain" id="targetSection">
    <div class="row">
        <div class="col-md-12">
            <h3 style="background-color: antiquewhite;   align-content: center;"></h3>
            <div class="tab">
                <button class="tablinks" onclick="openTab(event, 'Tab1')" id="defaultOpen">@(Session["Lang"].ToString() == "mr" ? "फोटो गॅलरी" : "Photo gallary")</button>
                <button class="tablinks" onclick="openTab(event, 'Tab2')">@(Session["Lang"].ToString() == "mr" ? "व्हिडिओ गॅलरी" : "Video Gallary")</button>
            </div>
        </div>
        <div class="col-md-12">
            <div id="Tab1" class="tabcontent" style="padding:10px; ">
                <div class="row">
                    @foreach (var item in Model.DistinctPhotoAlbum.Select((x, i) => new { Data = x, Index = i + 1 }))
                    {
                        <a class="mb-3 fs-4 text-start" style="text-align: left; padding: 10px; font-size: large; color: #004d99" href="@Url.Content("~/Gallery/Gallery?desc="+@item.Data.Text)"><b>@item.Data.Text</b></a>
                        @*foreach (var item1 in Model.PhotoGalleryList.Select((x, i) => new { Data = x, Index1 = i + 1 }))
                            {
                                <div class="event2-container">
                                    <div class="event2-track tz-gallery ">
                                        @if (item1.Data.album_desc == item.Data.Text)
                                        {
                                            <div class="col-sm-12 col-md-3">
                                                <a class="lightbox" href="@Url.Content(Model.PhotoGalleryList[item1.Index1].doc_location + Model.PhotoGalleryList[item1.Index1].doc_name)">
                                                    <img src="@Url.Content(Model.PhotoGalleryList[item1.Index1].doc_location + Model.PhotoGalleryList[item1.Index1].doc_name)" alt="Image">
                                                </a>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }*@
                    }

                    <div class="event2-container">
                        <div class="event2-track tz-gallery ">
                            @{
                                int totalcount = Model.PhotoGalleryList.Count();
                                if (totalcount > 13)
                                {
                                    totalcount = 13;
                                }
                            }

                            @for (int j = 0; j < totalcount; j += 4)
                            {

                                for (int i = 0; i < 4; i++)
                                {
                                    int index = j + i;
                                    if (index < totalcount)
                                    {
                                        <div class="col-sm-12 col-md-3">
                                            <a class="lightbox" href="@Url.Content(Model.PhotoGalleryList[index].doc_location + Model.PhotoGalleryList[index].doc_name)">
                                                <img src="@Url.Content(Model.PhotoGalleryList[index].doc_location + Model.PhotoGalleryList[index].doc_name)" alt="Image">
                                            </a>
                                        </div>
                                    }
                                }

                            }


                        </div>
                        <div class="event2-buttons">
                            <button class="event2-btn" onclick="moveEvent2Slide(-1)">&#10094; Prev</button>
                            <button class="event2-btn" onclick="moveEvent2Slide(1)">Next &#10095;</button>
                        </div>
                    </div>

                    <div id="modal" class="modal">
                        <span class="close" id="close">&times;</span>
                        <img class="modal-content" id="modal-img">
                        <div id="caption"></div>
                        <div class="zoom-controls">
                            <button id="zoomIn">+</button>
                            <button id="zoomOut">-</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



