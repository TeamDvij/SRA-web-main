@model SRACMSApplication.Models.other_building_permission_bhogvataModel
@{
    ViewBag.Title = "BuildingPermission";
    Layout = @Session["Layout"].ToString();
    //Layout = "~/Views/Shared/Master7.cshtml";
}


<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">


<!-- Add jQuery and DataTables JS -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<link href="~/Content/webcss/tabs.css" rel="stylesheet" />

    <div style="width:70%;margin-top:5px;padding:5px;">
        <div class="row">
            <div class="col-md-12">
                <h3 style="background-color: antiquewhite; height: 120%;  align-content: center;">
                    @(Session["Lang"].ToString() == "mr" ? "बांधकाम परवानगी प्रमाणपत्रे" : "Building Permission Certificates")
                </h3>
            </div>
            <div class="col-md-12">
                <table id="datatable" cellspacing="0" width="100%" style="padding:10px">
                    <thead>
                        <tr>
                            <th style="text-align: center; width: 5%;">@(Session["Lang"].ToString() == "mr" ? "अ.क्र." : "Sr.No.")</th>
                            <th style="text-align:center;" title="मास्टर क्रमांक">@(Session["Lang"].ToString() == "mr" ? "मा.क्र." : "Master No.")</th>
                            <th style="text-align: center; width: 12%;">@(Session["Lang"].ToString() == "mr" ? "विभाग" : "Department")</th>
                            <th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "योजनाचे नाव" : "Project Name") </th>
                            <th style="text-align:center;width: 15%;">@(Session["Lang"].ToString() == "mr" ? "दिनांक" : "Date")</th>
                            <th style="text-align:center;width: 5%;">@(Session["Lang"].ToString() == "mr" ? "पहा" : "View")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.other_building_permission_list.Select((x, i) => new { Data = x, Index = i + 1 }))
                        {
                            <tr>
                                <td style="text-align:center">@item.Index</td>
                                <td style="text-align:center;width: 10%;">@(item.Data.project_new.Master_no.ToString() == "0" ? "" : item.Data.project_new.Master_no.ToString())</td>
                                <td style="text-align:center;">@(Session["Lang"].ToString() == "mr" ? @item.Data.sys_config.sys_name_mar : @item.Data.sys_config.sys_name_eng)</td>
                                <td style="text-align:left;width: 50%;">@(item.Data.project_new.Master_no.ToString() == "0" ? (Session["Lang"].ToString() == "mr" ? @item.Data.proj_name : @item.Data.proj_name_eng) : (Session["Lang"].ToString() == "mr" ? @item.Data.project_new.project_name : @item.Data.project_new.project_name_eng)) @(item.Data.remark_yojna == null ? "" : " - " + item.Data.remark_yojna.ToString()) </td>
                                @*<td style="text-align:center;width: 15%;">@item.Data.proj_date.ToString("dd-MM-yyyy")</td>*@
                                @if (@item.Data.proj_date.ToString("dd-MM-yyyy") != "01-01-1900")
                                {
                                    <td style="text-align:center;width:12%;">@item.Data.proj_date.ToString("dd-MM-yyyy")</td>
                                }
                                @if (@item.Data.proj_date.ToString("dd-MM-yyyy") == "01-01-1900")
                                {
                                    <td></td>
                                }
                                 <td style="text-align:center;width: 5%;">
                                    <a href="@Url.Content(@item.Data.doc_location+@item.Data.doc_name)" class="marathi_font" target="_blank">
                                        <img src="~/Content/images/pdf-logo.png" width="25" height="25">
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

<!-- Add DataTables CSS -->

<script>
    $(document).ready(function() {
        var lang = '@Session["Lang"].ToString()';

        // Initialize DataTable
        var table = $('#datatable').DataTable({
            "paging": true,
            "pageLength": 5,
            "lengthMenu": [5, 10, 25, 50, 100],
            "language": {
                "url": lang === 'mr' ?
                    '//cdn.datatables.net/plug-ins/1.13.6/i18n/mr.json' :
                    '//cdn.datatables.net/plug-ins/1.13.6/i18n/en-GB.json'
            },
            "columnDefs": [
                { "orderable": false, "targets": [4,5] }, // Disable sorting for View column
                { "searchable": false, "targets": [] } // Disable search for Sr.No and View columns
            ]
        });

        // Add search input functionality
        $('#searchInput').on('keyup', function() {
            table.search(this.value).draw();
        });
    });
</script>
