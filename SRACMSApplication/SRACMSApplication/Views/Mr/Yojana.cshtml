    }

    .subheader {
        /*background-color: #f7ecb5;*/
        background-color: antiquewhite;
        color: #333333;
        font-weight: bold;
        padding: 5px;
        margin-bottom: 5px;
        text-align: center;
        font-size: medium;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 10px;
    }

    table, th, td {
