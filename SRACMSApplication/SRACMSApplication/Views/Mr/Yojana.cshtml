                    <!-- Add DataTables CSS -->

                    <script>
                        $(document).ready(function () {
                            var lang = '@Session["Lang"].ToString()';

                            // Initialize DataTable
                            var table = $('#datatable1').DataTable({
                                "paging": true,
                                "pageLength": 11,
                                "lengthMenu": [11, 25, 50, 100],
                                "language": {
                                    "url": lang === 'mr' ?
                                        '//cdn.datatables.net/plug-ins/1.13.6/i18n/mr.json' :
                                        '//cdn.datatables.net/plug-ins/1.13.6/i18n/en-GB.json'
                                },
                                "columnDefs": [
                                    { "orderable": false, "targets": [3] }, // Disable sorting for View column
                                    { "searchable": false, "targets": [0, 4] } // Disable search for Sr.No and View columns
                                ]
                            });

                            // Add search input functionality
                            $('#searchInput').on('keyup', function () {
                                table.search(this.value).draw();
                            });

                            // Add year filter functionality
                            $('#yearFilter1').on('change', function () {
                                var year = this.value;
                                table.column(3).search(year).draw();
                            });
                        });
                    </script>

