@model SRACMSApplication.Models.galaryModel

@{
    ViewBag.Title = "Gallery";
    Layout = (Session["Layout"] != null) ? Session["Layout"].ToString() : "~/Views/Shared/_Layout.cshtml";

    int totalcount = Model.PhotoGalleryList.Count();
    if (totalcount > 8)
    {
        totalcount = 8;
    }

    int imageIndex = 0; // Initialize image index for lightbox
}
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<!-- Add jQuery and DataTables JS -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<link href="~/Content/webcss/tabs.css" rel="stylesheet" />
<style>

    .event {
        background-color: white;
        padding: 20px;
        border-radius: 10px;
        max-width: 1000px;
        margin: auto;
    }

        .event h2 {
            color: #333;
            margin-bottom: 15px;
            text-align: center;
        }

    .photo-carousel {
        position: relative;
        overflow: hidden;
        width: 100%;
        display: flex;
        align-items: center;
    }

    .photo-track {
        display: flex;
        gap: 30px;
        transition: transform 0.5s ease-in-out;
        flex-wrap: nowrap;
    }

    .photo-carousel img {
        height: 200px;
        width: auto;
        border-radius: 8px;
        flex-shrink: 0;
        cursor: pointer;
    }

    .carousel-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background-color: rgba(0, 0, 0, 0.6);
        color: white;
        border: none;
        padding: 10px;
        cursor: pointer;
        font-size: 18px;
        border-radius: 5px;
        z-index: 10;
    }

    .prev-btn {
        left: 10px;
    }

    .next-btn {
        right: 10px;
    }

    .carousel-btn:hover {
        background-color: rgba(0, 0, 0, 0.8);
    }

    /* Popup Styles */
    .lightbox {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.9);
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        z-index: 1000;
        display: none;
    }

        .lightbox img {
            max-height: 80%;
            max-width: 90%;
            transition: transform 0.3s ease;
        }

    .lightbox-controls {
        margin-top: 20px;
    }

        .lightbox-controls button {
            padding: 10px 15px;
            font-size: 20px;
            margin: 5px;
            cursor: pointer;
        }

    .lightbox-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        color: white;
        font-size: 40px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 10px;
        z-index: 1001;
    }

    .lightbox-prev {
        left: 20px;
        position: absolute;
    }

    .lightbox-next {
        right: 20px;
        position: absolute;
    }

    .lightbox-close {
        position: absolute;
        top: 20px;
        right: 30px;
        font-size: 30px;
        color: white;
        background: none;
        border: none;
        cursor: pointer;
    }
</style>
<div class="sramain" id="targetSection">
    <div class="row">
        <div class="col-md-12">
            <h3 class="fs-5" style="background-color: antiquewhite; padding:10px;">
                @(Session["Lang"].ToString() == "mr" ? "गॅलरी" : "Gallary")
            </h3>
            <div class="tab">
                <button class="tablinks" onclick="openTab(event, 'Tab1')" id="defaultOpen">@(Session["Lang"].ToString() == "mr" ? "फोटो गॅलरी" : "Photo gallary")</button>
                <button class="tablinks" onclick="openTab(event, 'Tab2')">@(Session["Lang"].ToString() == "mr" ? "व्हिडिओ गॅलरी" : "Video Gallary")</button>
            </div>
        </div>
        <div class="col-md-12">
            <div id="Tab1" class="tabcontent" style="padding:10px; ">
                <div class="event">

                    <h2>
                        @foreach (var item in Model.DistinctPhotoAlbum.Select((x, i) => new { Data = x, Index = i + 1 }))
                        {
                            <a class="mb-3 fs-4 text-start" style="text-align: left; padding: 10px; font-size: large; color: #004d99" href="@Url.Content("~/Mr/Gallery?desc="+@item.Data.Text)"><b>@item.Data.Text</b></a>
                        }
                    </h2>
                    <div class="photo-carousel">
                        <button class="carousel-btn prev-btn" onclick="moveCarousel(-1)">❮</button>
                        <div class="photo-track" id="photoTrack">
                            @for (int j = 0; j < totalcount; j++)
                            {
                                <img src="@Url.Content(Model.PhotoGalleryList[j].doc_location + Model.PhotoGalleryList[j].doc_name)"
                                     alt="Gallery Image"
                                     onclick="openLightbox(@imageIndex)" />
                                imageIndex++;
                            }
                        </div>
                        <button class="carousel-btn next-btn" onclick="moveCarousel(1)">❯</button>
                    </div>
                </div>
            </div>
        </div>
<div class="col-md-12">
    <div id="Tab2" class="tabcontent" style="padding:10px; ">
        <h4>
            <b style="color: #004274; "> छायाचित्र व्हिडिओ</b>
        </h4>
    </div>
</div>
    </div>
</div>


        <div class="lightbox" id="lightbox">
            <button class="lightbox-close" onclick="closeLightbox()">✕</button>
            <button class="lightbox-nav lightbox-prev" onclick="changeImage(-1)">❮</button>
            <img id="lightboxImage" src="" />
            <button class="lightbox-nav lightbox-next" onclick="changeImage(1)">❯</button>
            <div class="lightbox-controls">
                <button onclick="zoomIn()">＋</button>
                <button onclick="zoomOut()">－</button>
                <button onclick="resetZoom()">⟳</button>
            </div>
        </div>

        <script>
    var images = [
        @for (int i = 0; i < Model.PhotoGalleryList.Count(); i++)
        {
            @: "@Url.Content(Model.PhotoGalleryList[i].doc_location + Model.PhotoGalleryList[i].doc_name)"@(i < Model.PhotoGalleryList.Count() - 1 ? "," : "")
        }
    ];

    var currentIndex = 0;
    var zoomLevel = 1;

    function moveCarousel(direction) {
        const track = document.getElementById('photoTrack');
        const imgWidth = track.querySelector('img').offsetWidth + 30; // Adjust for gap
        currentIndex += direction;
        currentIndex = Math.max(0, Math.min(currentIndex, images.length - 1));
        track.style.transform = `translateX(-${currentIndex * imgWidth}px)`;
    }

    function openLightbox(index) {
        currentIndex = index;
        zoomLevel = 1;
        var lightbox = document.getElementById('lightbox');
        var img = document.getElementById('lightboxImage');
        img.src = images[currentIndex];
        img.style.transform = "scale(1)";
        lightbox.style.display = 'flex';
    }

    function closeLightbox() {
        document.getElementById('lightbox').style.display = 'none';
    }

    function changeImage(direction) {
        currentIndex += direction;
        if (currentIndex < 0) currentIndex = images.length - 1;
        if (currentIndex >= images.length) currentIndex = 0;
        var img = document.getElementById('lightboxImage');
        zoomLevel = 1;
        img.src = images[currentIndex];
        img.style.transform = "scale(1)";
    }

    function zoomIn() {
        zoomLevel += 0.1;
        document.getElementById('lightboxImage').style.transform = "scale(" + zoomLevel + ")";
    }

    function zoomOut() {
        zoomLevel = Math.max(0.5, zoomLevel - 0.1);
        document.getElementById('lightboxImage').style.transform = "scale(" + zoomLevel + ")";
    }

    function resetZoom() {
        zoomLevel = 1;
        document.getElementById('lightboxImage').style.transform = "scale(1)";
    }
        </script>

        @*Tab Script*@
        <script>
            function openTab(evt, tabName) {
                // Hide all tab content
                let tabcontent = document.getElementsByClassName("tabcontent");
                for (let i = 0; i < tabcontent.length; i++) {
                    tabcontent[i].style.display = "none";
                }

                // Remove active class from all buttons
                let tablinks = document.getElementsByClassName("tablinks");
                for (let i = 0; i < tablinks.length; i++) {
                    tablinks[i].className = tablinks[i].className.replace(" active", "");
                }

                // Show the selected tab content and mark button as active
                document.getElementById(tabName).style.display = "block";
                evt.currentTarget.className += " active";
            }

            // Open the default tab on page load
            document.getElementById("defaultOpen").click();
        </script>
