@model SRACMSApplication.Models.other_lotteryModel
@{
    ViewBag.Title = "Lottery";
    Layout = @Session["Layout"].ToString();
    //Layout = "~/Views/Shared/Master7.cshtml";
}

<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">

<!-- Add jQuery and DataTables JS -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<link href="~/Content/webcss/tabs.css" rel="stylesheet" />

<div class="sramain" id="targetSection">
    <div class="row">
        <div class="col-md-12">
            <h3 class="fs-5" style="background-color: antiquewhite; padding:10px;">
                @(Session["Lang"].ToString() == "mr" ? "लॉटरी पद्धतीने सदनिका वाटप करण्यात आलेल्या योजनांची यादी" : "Lottery List")
            </h3>
        </div>
        <div class="col-md-12 table-container">
            <table id="datatable" style="padding:10px">
                <thead>
                    <tr>
                        <th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "अ.क्र." : "Sr.No.")</th>
                        <th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "योजनेचे नाव" : "Plan Name") </th>
                        <th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "विकसकाचे नाव" : "Developer")</th>
                        @*<th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "वर्ष" : "Year")</th>*@
                        <th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "सदनिका वाटप दिनांक" : "Flat allotment date")</th>
                        <th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "एकूण सदनिका" : "Total Flats")</th>
                        <th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "वाटप सदनिका" : "Alloted Flats")</th>
                        <th style="text-align: center">@(Session["Lang"].ToString() == "mr" ? "पहा" : "View")</th>
                        @*<th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "व्हिडिओ पहा" : "Video")</th>*@
                    </tr>

                </thead>
                <tbody>
                    @foreach (var item in Model.other_lotteryList.Select((x, i) => new { Data = x, Index = i + 1 }))
                    {
                        <tr>
                            <td style="text-align:center;width:5%;">@item.Index</td>
                            <td style="text-align:left;width:45%;">@(Session["Lang"].ToString() == "mr" ? @item.Data.proj_name : @item.Data.proj_name_eng)</td>
                            <td style="text-align:left;width:30%;">@(Session["Lang"].ToString() == "mr" ? @item.Data.developer : @item.Data.developer_eng)</td>
                            @*<td style="text-align:center">@item.Data.lottery_year</td>*@
                            <td style="text-align:center;width:15%;">@item.Data.flat_allotment_date.ToString("dd-MM-yyyy")</td>
                            <td style="text-align:center;width:10%;">@item.Data.total_flats</td>
                            <td style="text-align:center;width:10%;">@item.Data.allotted_flats</td>
                            <td class="tCenter" style="width:7%">
                                <a href="@Url.Content(@item.Data.doc_location+@item.Data.doc_name)" class="marathi_font" target="_blank">
                                    <img src="~/Content/images/pdf-logo.png" width="25" height="25">
                                </a>
                            </td>
                            @*<td class="tCenter">
                                    @if (@item.Data.video_url != null)
                                    {
                                        <a href="@Url.Content(@item.Data.video_url)" class="marathi_font" target="_blank">
                                            <img src="~/Content/images/utLogo.jpg" width="25" height="25">
                                        </a>
                                    }
                                </td>*@
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


<!-- Add DataTables CSS -->

<script>
    $(document).ready(function() {
        var lang = '@Session["Lang"].ToString()';

        // Initialize DataTable
        var table = $('#datatable').DataTable({
            "paging": true,
            "pageLength": 5,
            "lengthMenu": [5, 10, 25, 50, 100],
            "language": {
                "url": lang === 'mr' ?
                    '//cdn.datatables.net/plug-ins/1.13.6/i18n/mr.json' :
                    '//cdn.datatables.net/plug-ins/1.13.6/i18n/en-GB.json'
            },
            "columnDefs": [
                { "orderable": false, "targets": [3,6] }, // Disable sorting for View column
                { "searchable": false, "targets": [] } // Disable search for Sr.No and View columns
            ]
        });

        // Add search input functionality
        $('#searchInput').on('keyup', function() {
            table.search(this.value).draw();
        });

    });
</script>


