<div class="lightbox" id="lightbox">
    <button class="lightbox-close" onclick="closeLightbox()">✕</button>
    <button class="lightbox-nav lightbox-prev" onclick="changeImage(-1)">❮</button>
    <img id="lightboxImage" src="" />
    <button class="lightbox-nav lightbox-next" onclick="changeImage(1)">❯</button>
    <div class="lightbox-controls">
        <button onclick="zoomIn()">＋</button>
        <button onclick="zoomOut()">－</button>
        <button onclick="resetZoom()">⟳</button>
    </div>
</div>

<script>
    // Separate variables for photo and video carousels
    var currentPhotoIndex = 0;
    var currentVideoIndex = 0;
    var currentLightboxIndex = 0;
    var zoomLevel = 1;

    // Global images array for lightbox
    var images = [
        @if (Model.PhotoGalleryList != null && Model.PhotoGalleryList.Any())
        {
            for (int i = 0; i < Model.PhotoGalleryList.Count(); i++)
            {
                @: "@Url.Content(Model.PhotoGalleryList[i].doc_location + Model.PhotoGalleryList[i].doc_name)"@(i < Model.PhotoGalleryList.Count() - 1 ? "," : "")
            }
        }
    ];

    function moveCarousel(direction) {
        const track = document.getElementById('photoTrack');
        const imagesInTrack = track.querySelectorAll('img');

        if (imagesInTrack.length === 0) {
            // Disable buttons if no images
            document.querySelector('#photoTrack').parentElement.querySelector('.prev-btn').disabled = true;
            document.querySelector('#photoTrack').parentElement.querySelector('.next-btn').disabled = true;
            return;
        }

        const imgWidth = imagesInTrack[0].offsetWidth + 30; // Image width + gap
        const maxIndex = Math.max(0, imagesInTrack.length - 1);

        currentPhotoIndex += direction;

        // Ensure index stays within bounds
        if (currentPhotoIndex < 0) currentPhotoIndex = 0;
        if (currentPhotoIndex > maxIndex) currentPhotoIndex = maxIndex;

        track.style.transform = `translateX(-${currentPhotoIndex * imgWidth}px)`;

        // Update button states
        updateCarouselButtons('photoTrack', currentPhotoIndex, imagesInTrack.length);
    }

    function moveCarousel1(direction) {
        const track = document.getElementById('photoTrack1');
        const videosInTrack = track.querySelectorAll('video');

        if (videosInTrack.length === 0) {
            // Disable buttons if no videos
            document.querySelector('#photoTrack1').parentElement.querySelector('.prev-btn').disabled = true;
            document.querySelector('#photoTrack1').parentElement.querySelector('.next-btn').disabled = true;
            return;
        }

        const videoWidth = videosInTrack[0].offsetWidth + 30; // Video width + gap
        const maxIndex = Math.max(0, videosInTrack.length - 1);

        currentVideoIndex += direction;

        // Ensure index stays within bounds
        if (currentVideoIndex < 0) currentVideoIndex = 0;
        if (currentVideoIndex > maxIndex) currentVideoIndex = maxIndex;

        track.style.transform = `translateX(-${currentVideoIndex * videoWidth}px)`;

        // Update button states
        updateCarouselButtons('photoTrack1', currentVideoIndex, videosInTrack.length);
    }

    function updateCarouselButtons(trackId, currentIndex, totalItems) {
        const carousel = document.getElementById(trackId).parentElement;
        const prevBtn = carousel.querySelector('.prev-btn');
        const nextBtn = carousel.querySelector('.next-btn');

        prevBtn.disabled = (currentIndex === 0);
        nextBtn.disabled = (currentIndex >= totalItems - 1);
    }

    function openLightbox(index) {
        // Check if image exists
        if (index < 0 || index >= images.length) {
            console.error("Image index out of bounds");
            return;
        }

        currentLightboxIndex = index;
        zoomLevel = 1;
        var lightbox = document.getElementById('lightbox');
        var img = document.getElementById('lightboxImage');
        img.src = images[currentLightboxIndex];
        img.style.transform = "scale(1)";
        lightbox.style.display = 'flex';
    }

    function openVideo(index) {
        // You can implement a video lightbox similar to the image lightbox
        alert("Video clicked: " + index);
        // Implement video lightbox functionality here
    }

    function closeLightbox() {
        document.getElementById('lightbox').style.display = 'none';
    }

    function changeImage(direction) {
        if (images.length === 0) return;

        currentLightboxIndex += direction;
        if (currentLightboxIndex < 0) currentLightboxIndex = images.length - 1;
        if (currentLightboxIndex >= images.length) currentLightboxIndex = 0;

        var img = document.getElementById('lightboxImage');
        zoomLevel = 1;
        img.src = images[currentLightboxIndex];
        img.style.transform = "scale(1)";
    }

    function zoomIn() {
        zoomLevel += 0.1;
        document.getElementById('lightboxImage').style.transform = "scale(" + zoomLevel + ")";
    }

    function zoomOut() {
        zoomLevel = Math.max(0.5, zoomLevel - 0.1);
        document.getElementById('lightboxImage').style.transform = "scale(" + zoomLevel + ")";
    }

    function resetZoom() {
        zoomLevel = 1;
        document.getElementById('lightboxImage').style.transform = "scale(1)";
    }

    // Initialize carousel buttons on page load
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize photo carousel buttons
        const photoTrack = document.getElementById('photoTrack');
        const photoImages = photoTrack.querySelectorAll('img');
        updateCarouselButtons('photoTrack', currentPhotoIndex, photoImages.length);

    });
</script>

@*Tab Script*@
<script>
    function openTab(evt, tabName) {
        // Hide all tab content
        let tabcontent = document.getElementsByClassName("tabcontent");
        for (let i = 0; i < tabcontent.length; i++) {
            tabcontent[i].style.display = "none";
        }

        // Remove active class from all buttons
        let tablinks = document.getElementsByClassName("tablinks");
        for (let i = 0; i < tablinks.length; i++) {
            tablinks[i].className = tablinks[i].className.replace(" active", "");
        }

        // Show the selected tab content and mark button as active
        document.getElementById(tabName).style.display = "block";
        evt.currentTarget.className += " active";

        // Reset carousel positions when switching tabs
        if (tabName === 'Tab1') {
            // Reset photo carousel
            const photoTrack = document.getElementById('photoTrack');
            currentPhotoIndex = 0;
            photoTrack.style.transform = 'translateX(0)';
            const photoImages = photoTrack.querySelectorAll('img');
            updateCarouselButtons('photoTrack', currentPhotoIndex, photoImages.length);
        } 
    }

    // Open the default tab on page load
    document.addEventListener('DOMContentLoaded', function () {
        document.getElementById("defaultOpen").click();
    });
</script>


