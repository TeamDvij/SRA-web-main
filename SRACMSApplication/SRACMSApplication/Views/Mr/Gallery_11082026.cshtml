<style>
    .event {
        background-color: white;
        padding: 20px;
        border-radius: 10px;
        max-width: 1000px;
        margin: auto;
    }

        .event h2 {
            color: #333;
            margin-bottom: 15px;
            text-align: center;
        }

    .photo-carousel {
        position: relative;
        overflow: hidden;
        width: 100%;
        display: flex;
        align-items: center;
    }

    .photo-track {
        display: flex;
        gap: 30px;
        transition: transform 0.5s ease-in-out;
        flex-wrap: nowrap;
        min-height: 120px; /* Prevent collapse if empty */
    }

        .photo-track:empty::after {
            content: "No content available";
            display: block;
            text-align: center;
            width: 100%;
            padding: 20px;
            color: #666;
            font-style: italic;
        }

    .photo-carousel img {
        height: 120px;
        width: auto;
        border-radius: 8px;
        flex-shrink: 0;
        cursor: pointer;
        object-fit: cover;
    }

    .photo-carousel video {
        height: 120px;
        width: auto;
        border-radius: 8px;
        flex-shrink: 0;
        cursor: pointer;
        object-fit: cover;
    }

    .carousel-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background-color: rgba(0, 0, 0, 0.6);
        color: white;
        border: none;
        padding: 10px;
        cursor: pointer;
        font-size: 18px;
        border-radius: 5px;
        z-index: 10;
    }

        .carousel-btn:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

    .prev-btn {
        left: 10px;
    }

    .next-btn {
        right: 10px;
    }

    .carousel-btn:hover:not(:disabled) {
        background-color: rgba(0, 0, 0, 0.8);
    }
    /* Lightbox Overlay */
    .lightbox {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.95);
        display: none;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        z-index: 99999;
    }

        /* Image container */
        .lightbox img {
            max-width: 90vw;
            max-height: 85vh;
            object-fit: contain;
            transition: transform 0.3s ease-in-out;
            cursor: grab;
        }

    /* Navigation arrows */
    .lightbox-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(0,0,0,0.6);
        border: none;
        color: white;
        font-size: 40px;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        cursor: pointer;
        z-index: 100000;
    }

    .lightbox-prev {
        left: 20px;
    }

    .lightbox-next {
        right: 20px;
    }

    .lightbox-nav:hover {
        background: rgba(255,255,255,0.2);
    }

    /* Close Button */
    .lightbox-close {
        position: absolute;
        top: 20px;
        right: 25px;
        font-size: 35px;
        background: none;
        border: none;
        color: white;
        cursor: pointer;
        z-index: 100001;
    }

    /* Zoom Controls */
    .lightbox-controls {
        position: absolute;
        bottom: 25px;
        display: flex;
        gap: 15px;
    }

        .lightbox-controls button {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            font-size: 22px;
            border: none;
            background: rgba(255,255,255,0.15);
            color: white;
            cursor: pointer;
            backdrop-filter: blur(5px);
        }

            .lightbox-controls button:hover {
                background: rgba(255,255,255,0.35);
            }
</style>
