@model SRACMSApplication.Models.faqModel
@{
    ViewBag.Title = "FAQ";
    Layout = @Session["Layout"].ToString();
    //Layout = "~/Views/Shared/Master7.cshtml";
}
<!-- Add jQuery and DataTables JS -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<link href="~/Content/webcss/faq.css" rel="stylesheet" />

<!-- Bootstrap JS + Popper -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<div class="sramain" id="targetSection">
    <div class="row">
        <div class="col-md-12">
            <h3 class="fs-5" style="background-color: antiquewhite; padding:10px;">
                @(Session["Lang"].ToString() == "mr" ? "शंका समाधान (FAQ)" : "FAQ")
            </h3>
        </div>
        <div class="container mt-5">
            <div class="accordion" id="faqAccordion" style="width:100%;margin-top:-60px;overflow-y: auto; max-height: 600px;">
                @foreach (var item in Model.faq_list.Select((x, i) => new { Data = x, Index = i + 1 }))
                {
                    if (@item.Index == 1)
                    {
                        <div class="accordion-item" style="font-size:16px">
                            <h2 class="accordion-header" id="heading+@item.Index">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq+@item.Index" aria-expanded="false" aria-controls="faq+@item.Index">
                                    प्र.@item.Index –  @(Session["Lang"].ToString() == "mr" ? @item.Data.faq1 : @item.Data.faq_eng)
                                </button>
                            </h2>
                            <div style="font-size:16px;" id="faq+@item.Index" class="accordion-collapse collapse show" aria-labelledby="heading+@item.Index" data-bs-parent="#faqAccordion">
                                <div class="accordion-body">
                                    उत्तर – @(Session["Lang"].ToString() == "mr" ? @item.Data.answer : @item.Data.answer_eng)
                                </div>
                            </div>
                        </div>
                    }
                    if (@item.Index != 1)
                    {
                        <div class="accordion-item" style="font-size:16px">
                            <h2 class="accordion-header" id="heading+@item.Index">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq+@item.Index" aria-expanded="false" aria-controls="faq+@item.Index">
                                    प्र.@item.Index –  @(Session["Lang"].ToString() == "mr" ? @item.Data.faq1 : @item.Data.faq_eng)
                                </button>
                            </h2>
                            <div style="font-size:16px;" id="faq+@item.Index" class="accordion-collapse collapse" aria-labelledby="heading+@item.Index" data-bs-parent="#faqAccordion">
                                <div class="accordion-body">
                                    उत्तर – @(Session["Lang"].ToString() == "mr" ? @item.Data.answer : @item.Data.answer_eng)
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

