@model SRACMSApplication.Models.aboutModel
@{
    ViewBag.Title = "PradhikarnachiMahiti";
    Layout = @Session["Layout"].ToString();
    //Layout = "~/Views/Shared/Master7.cshtml";
}
<style>
    .authority-info {
        height: 635px;
        overflow-y: auto;
        padding: 22px 24px 30px;
        border: 1px solid #e5eaf1;
        border-radius: 14px;
        background: #f5f7fb;
        box-shadow: 0 8px 24px rgba(24, 48, 84, .08);
        scrollbar-color: #b7c5d8 transparent;
    }

    .authority-info > .row {
        margin: 0;
        padding: 0 28px 28px;
        border-radius: 10px;
        background: #fff;
    }

    .authority-info .authority-info-title {
        position: relative;
        margin: 0 -28px 24px;
        padding: 18px 24px 18px 30px !important;
        border-radius: 10px 10px 0 0;
        background: linear-gradient(110deg, #123f73, #1768a6) !important;
        color: #fff;
        font-family: 'TrioDevanagari', sans-serif;
        font-size: 1.35rem;
        font-weight: 700;
        letter-spacing: .01em;
        box-shadow: 0 4px 12px rgba(20, 75, 127, .18);
    }

    .authority-info .authority-info-title::before {
        content: "";
        position: absolute;
        top: 18px;
        bottom: 18px;
        left: 0;
        width: 5px;
        border-radius: 0 4px 4px 0;
        background: #f2b544;
    }

    .authority-info .authority-info-content {
        padding: 4px 8px 12px;
    }

    .authority-info .authority-info-content p.fs-5 {
        margin: 0 0 18px !important;
        color: #344357;
        font-family: 'TrioDevanagari', sans-serif;
        font-size: 1.06rem !important;
        line-height: 1.95 !important;
        text-align: justify;
    }

    .authority-info .authority-info-content p.fs-5 span.d-block {
        line-height: 1.95 !important;
    }

    .authority-info .authority-info-content p[style*="color:#004d99"] {
        margin: 30px 0 12px !important;
        padding: 10px 14px 10px 16px;
        border-left: 4px solid #e5a52e;
        border-radius: 0 7px 7px 0;
        background: #f0f5fb;
        color: #164f83 !important;
        font-family: 'TrioDevanagari', sans-serif;
        font-size: 1.12rem !important;
        line-height: 1.6;
    }

    .authority-info .authority-info-content .table-responsive {
        overflow-x: auto;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
    }

    .authority-info .authority-info-content table {
        width: 100%;
        margin-bottom: 0;
        color: #344357;
        background: #fff;
    }

    .authority-info .authority-info-content th {
        padding: 12px;
        background: #eaf1f8;
        color: #164f83;
    }

    .authority-info .authority-info-content td {
        padding: 10px 12px;
        border-top: 1px solid #e8edf3;
    }

    @@media (max-width: 767px) {
        .authority-info { height: 635px; padding: 12px; }
        .authority-info > .row { padding: 0 14px 20px; }
        .authority-info .authority-info-title { margin: 0 -14px 18px; padding: 15px 18px 15px 24px !important; font-size: 1.15rem; }
        .authority-info .authority-info-content { padding: 0; }
        .authority-info .authority-info-content p.fs-5 { font-size: 1rem !important; line-height: 1.8 !important; }
    }
</style>
<div class="sramain authority-info" id="targetSection">
    <div class="row">
        <div class="col-md-12">
            <h3 class="fs-5 authority-info-title">
                @(Session["Lang"].ToString() == "mr" ? "प्राधिकरणाची माहिती" : "SRA Information")
            </h3>
        </div>
        <div class="col-12 authority-info-content">

            <p class="mb-3 fs-5 text-start">
                <span class="d-block" style="font-family: 'TrioDevanagari'; line-height: 40px;" &nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;>
                    @*@(Session["Lang"].ToString() == "mr" ? @Model.line1 : Model.line_eng1)*@
                    पुणे शहर हे महाराष्ट्राची सांस्कृतिक राजधानी म्हणून आणि पिंपरी-चिंचवड हे शहर उद्योग नगरी म्हणून ओळखले जाते.
                    पुणे आणि पिंपरी-चिंचवड या शहरामध्ये उद्योग, व्यवसाय, शिक्षण तसेच रोजगार यासाठी देशाच्या अन्य भागातून मोठ्या प्रमाणात लोक स्थलांतरित होतात.
                    स्थलांतरित होणाऱ्या लोकांना किफायतशीर दरातील निवाऱ्याची सोय उपलब्ध होत नसल्याने, झोपडपट्टीमध्ये वास्तव्य करणे भाग पडते.
                    सद्यस्थितीत पुणे शहरामध्ये ४८६ झोपडपट्ट्यामध्ये साधारण <b>१,६५,०००</b> एवढ्या कुटुंबाचे वास्तव्य असून शहराच्या एकूण लोकसंख्येच्या सुमारे <b>२८%</b>लोक झोपडपट्टीत राहत आहेत.
                    पिंपरी-चिंचवड महानगरपालिका क्षेत्रात ७१ झोपडपट्ट्या असून त्यामध्ये सुमारे <b>३५,२६१</b> कुटुंबाचे वास्तव्य आहे.
                    शहराच्या एकूण लोकसंख्येच्या सुमारे <b>१४.७८</b> टक्के लोक झोपडपट्टीत राहत आहेत. झोपडपट्टीतील अस्वच्छ व अनारोग्य असलेल्या परिस्थितीत तेथील लोक खडतर अवस्थेत जीवन कंठीत असतात. सर्वसामान्य जनतेप्रमाणे झोपडीधारकाचे स्वत:च्या घराचे स्वप्न असते. या स्वप्नपूर्तीसाठी महाराष्ट्र शासन कटिबद्ध आहे.

                </span>
            </p>

            <p class="mb-3 fs-5 text-start">
                <span class="d-block" style="font-family: 'TrioDevanagari'; line-height: 40px;">
                    महाराष्ट्र शासनाच्या महत्वाकांक्षी धोरणानुसार, झोपडपट्टीधारकांना आवश्यक त्या सोयी सुविधायुक्त मोफत घर/सदनिका उपलब्ध करून देऊन त्यांचे राहणीमान
                    व जीवनमान उंचावणे यासाठीचे एक प्रभावी अभियान म्हणजे महाराष्ट्र शासनाची झोपडपट्टी पुनर्वसन योजना होय.
                    या योजनेमध्ये शासनाने झोपडपट्टीने व्यापलेल्या जमिनीचा साधनसंपत्ती म्हणून सुयोग्य वापर करून प्रोत्साहनात्मक चटईक्षेत्र निर्देशांक अनुज्ञेय करून झोपडपट्टी पुनर्वसन योजना राबविली जाते.
                    त्यासाठी शासनाने झोपडपट्टी पुनर्वसन प्राधिकरणाची स्थापना केली आहे.
                </span>
            </p>

            <p class="mb-3 fs-5 text-start">
                <span class="d-block" style="font-family: 'TrioDevanagari'; line-height: 40px;">
                    शासनाने प्राधिकरणाच्या माध्यमातून पात्र झोपडीधारकांना त्यांच्या स्वप्नातील मालकी हक्काचे घर विनामूल्य देवू केले आहे. तसेच <b>दि. १६ मे, २०१८</b> रोजीच्या शासन निर्णयानुसार,
                    असंरक्षित झोपडीधारकांसाठी सशुल्क योजनेच्या माध्यमातून झोपडीधारकांच्या स्वप्नाला बळकटी प्राप्त होत आहे.
                    झोपडपट्टी मुक्त शहर करणे हा प्राधिकरणाचा ध्यास आहे. “अल्पायुषी प्राधिकरण आणि पुनर्विकास चिरंतर” झोपडपट्टी पुनर्वसन योजनेचे ध्येय आहे.
                </span>
            </p>

            <p class="mb-3 fs-4 text-start" style="color:#004d99;"><b>@(Session["Lang"].ToString() == "mr" ? "स्थापना" : "Establishment")</b></p>
            <p class="mb-3 fs-5 text-start">
                <span class="d-block" style="font-family: 'TrioDevanagari';">
                    @(Session["Lang"].ToString() == "mr" ? @Model.about_line_sthapana : Model.about_line_sthapana_eng)
                </span>
            </p>

            <p class="mb-3 fs-4 text-start" style="color:#004d99;"><b>@(Session["Lang"].ToString() == "mr" ? "संबधित वैधानिक तरतुदी" : "RELEVANT STATUTORY PROVISIONS")</b></p>
            <p class="mb-3 fs-5 text-start">
                <span class="d-block" style="font-family: 'TrioDevanagari';">
                    @(Session["Lang"].ToString() == "mr" ? @Model.line8 : Model.line_eng8)
                </span>
                <br />
                <span class="d-block" style="font-family: 'TrioDevanagari';">
                    @(Session["Lang"].ToString() == "mr" ? @Model.line9 : Model.line_eng9)
                </span>
            </p>

            <p class="mb-3 fs-4 text-start" style="color:#004d99;"><b>@(Session["Lang"].ToString() == "mr" ? "उद्देश" : "Objectives")</b></p>
            <p class="mb-3 fs-5 text-start">
                <span class="d-block" style="font-family: 'TrioDevanagari';">
                    @(Session["Lang"].ToString() == "mr" ? @Model.line5 : Model.line_eng5)
                </span><br />
                <span class="d-block" style="font-family: 'TrioDevanagari';">
                    @(Session["Lang"].ToString() == "mr" ? @Model.line6 : Model.line_eng6)
                </span><br />
                <span class="d-block" style="font-family: 'TrioDevanagari';">
                    @(Session["Lang"].ToString() == "mr" ? Model.line7 : Model.line_eng7)
                </span><br />
                <span class="d-block" style="font-family: 'TrioDevanagari';">
                    @(Session["Lang"].ToString() == "mr" ? Model.line7_1 : Model.line_eng7_1)
                </span>
            </p>

            <p class="mb-3 fs-4 text-start" style="color:#004d99;"><b>@(Session["Lang"].ToString() == "mr" ? "कार्यक्षेत्र" : "Workspace")</b></p>
            <p class="mb-3 fs-5 text-start">
                <span class="d-block" style="font-family: 'TrioDevanagari';">
                    @(Session["Lang"].ToString() == "mr" ? @Model.line3 : Model.line_eng3)
                </span><br />
                <span class="d-block" style="font-family: 'TrioDevanagari';">
                    @(Session["Lang"].ToString() == "mr" ? @Model.line4 : Model.line_eng4)
                </span>
            </p>

            <p class="mb-3 fs-4 text-start" style=" font-family 'TrioDevanagari' ;color:#004d99;"><b>@(Session["Lang"].ToString() == "mr" ? "प्राधिकरण्याच्या कामकाजासंदर्भातील अधिनियम, नियम व नियमावली" : "Acts, Rules and Regulations relating to the functioning of the Authority")</b></p>
            <div class="table-responsive">
                <table id="datatable" style="padding:10px" class="fs-5">
                    <thead>
                        <tr>
                            <th class="fs-5" style="text-align: center; font-family: 'TrioDevanagari'; width: 1%;">@(Session["Lang"].ToString() == "mr" ? "अ.क्र." : "Sr.No.")</th>
                            <th class="fs-5" style="text-align: center; font-family: 'TrioDevanagari'; width: 15%;">@(Session["Lang"].ToString() == "mr" ? "अधिनियम, नियम व नियमावली" : "Acts, Rules and Regulations")</thstyle="text-align:center;>
                            <th class="fs-5" style="text-align: center; font-family: 'TrioDevanagari'; width: 5%;">@(Session["Lang"].ToString() == "mr" ? "वर्ष" : "Year")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.LawRegulationTableList.Select((x, i) => new { Data = x, Index = i + 1 }))
                        {
                            <tr>
                                <td class="text-center fs-5" style="font-family: 'TrioDevanagari';">
                                    @(
                                    Session["Lang"].ToString() == "mr" ? @item.Data.col0 : item.Data.col_eng0
                                    )
                                </td>
                                <td class="fs-5" style="font-family: 'TrioDevanagari';">
                                    @(
                                    Session["Lang"].ToString() == "mr" ? @item.Data.col1 : item.Data.col_eng1
                                    )
                                </td>
                                <td class="text-center fs-5" style="font-family: 'TrioDevanagari';">
                                    @(
                                    Session["Lang"].ToString() == "mr" ? @item.Data.col2 : item.Data.col_eng2
                                    )
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>









