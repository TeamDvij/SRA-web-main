    @model SRACMSApplication.Models.homeModel
@{
    ViewBag.Title = "Home";
    Layout = @Session["Layout"].ToString();
    //Layout = "~/Views/Shared/Master7.cshtml";
}

<!-- Bootstrap JS (Required for Carousel) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<div class="container-fluid-slide-minister"  id="targetSection">
    <!-- Carousel Section -->
    <div class="home-banner-layout">
            <div class="home-banner-stage">
            <div id="carouselExample" class="carousel slide home-banner-carousel" data-bs-ride="carousel">
                <!-- Indicators -->
                <div class="carousel-indicators">
                    @for (int i = 0; i < Model.banner_List.Count; i++)
                    {
                        <button type="button" data-bs-target="#carouselExample" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-label="Slide @(i+1)"></button>
                    }
                </div>

                <div class="carousel-inner">
                    @foreach (var item in Model.banner_List.Select((x, i) => new { Data = x, Index = i }))
                    {
                        <div class="carousel-item @(item.Index == 0 ? "active" : "")" data-bs-interval="3000">
                            <img class="d-block w-100 img-fluid" src="@Url.Content(item.Data.doc_location + item.Data.doc_name)" alt="Slide @item.Index">
                        </div>
                    }
                </div>

                <!-- Navigation Arrows -->
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                </button>
            </div>
            </div>
            <div id="homeMinisterCarousel" class="carousel slide home-minister-carousel" data-bs-ride="carousel" data-bs-interval="4000" data-bs-pause="false" aria-label="माननीय मंत्री">
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <div class="home-minister-feature-slide"><div class="home-minister-feature-art"><img src="@Url.Content(Model.minister1_Photo)" alt="@(Session["Lang"].ToString() == "mr" ? Model.minister1_Name : Model.minister1_Name_eng)"></div><div class="home-minister-feature-copy"><strong>@(Session["Lang"].ToString() == "mr" ? Model.minister1_Name : Model.minister1_Name_eng)</strong><span>@(Session["Lang"].ToString() == "mr" ? "मा. मुख्यमंत्री" : "Hon. Chief Minister")</span></div></div>
                    </div>
                    <div class="carousel-item">
                        <div class="home-minister-feature-slide"><div class="home-minister-feature-art"><img src="@Url.Content(Model.minister2_Photo)" alt="@(Session["Lang"].ToString() == "mr" ? Model.minister2_Name : Model.minister2_Name_eng)"></div><div class="home-minister-feature-copy"><strong>@(Session["Lang"].ToString() == "mr" ? Model.minister2_Name : Model.minister2_Name_eng)</strong><span>@(Session["Lang"].ToString() == "mr" ? "मा. उपमुख्यमंत्री तथा गृहनिर्माण मंत्री" : "Hon. Deputy Chief Minister and Housing Minister")</span></div></div>
                    </div>
                    <div class="carousel-item">
                        <div class="home-minister-feature-slide"><div class="home-minister-feature-art"><img src="@Url.Content(Model.minister3_Photo)" alt="@(Session["Lang"].ToString() == "mr" ? Model.minister3_Name : Model.minister3_Name_eng)"></div><div class="home-minister-feature-copy"><strong>@(Session["Lang"].ToString() == "mr" ? Model.minister3_Name : Model.minister3_Name_eng)</strong><span>@(Session["Lang"].ToString() == "mr" ? "मा. उपमुख्यमंत्री" : "Hon. Deputy Chief Minister")</span></div></div>
                    </div>
                    <div class="carousel-item">
                        <div class="home-minister-feature-slide"><div class="home-minister-feature-art"><img src="@Url.Content(Model.minister4_Photo)" alt="@(Session["Lang"].ToString() == "mr" ? Model.minister4_Name : Model.minister4_Name_eng)"></div><div class="home-minister-feature-copy"><strong>@(Session["Lang"].ToString() == "mr" ? Model.minister4_Name : Model.minister4_Name_eng)</strong><span>@(Session["Lang"].ToString() == "mr" ? "मा. राज्यमंत्री गृहनिर्माण" : "Hon. Minister of State, Housing")</span></div></div>
                    </div>
                    <div class="carousel-item">
                        <div class="home-minister-feature-slide"><div class="home-minister-feature-art"><img src="@Url.Content(Model.ceoPhoto)" alt="@(Session["Lang"].ToString() == "mr" ? Model.ceoName : Model.ceoName_eng)"></div><div class="home-minister-feature-copy"><strong>@(Session["Lang"].ToString() == "mr" ? Model.ceoName : Model.ceoName_eng)</strong><span>@(Session["Lang"].ToString() == "mr" ? "मा. मुख्य कार्यकारी अधिकारी" : "Hon. Chief Executive Officer")</span></div></div>
                    </div>
                </div>
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#homeMinisterCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="मंत्री 1"></button>
                    <button type="button" data-bs-target="#homeMinisterCarousel" data-bs-slide-to="1" aria-label="मंत्री 2"></button>
                    <button type="button" data-bs-target="#homeMinisterCarousel" data-bs-slide-to="2" aria-label="मंत्री 3"></button>
                    <button type="button" data-bs-target="#homeMinisterCarousel" data-bs-slide-to="3" aria-label="मंत्री 4"></button>
                    <button type="button" data-bs-target="#homeMinisterCarousel" data-bs-slide-to="4" aria-label="मंत्री 5"></button>
                </div>
            </div>
    </div>

    <!-- Ministers Section (Single Horizontal Row) -->
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="team teamback">
                <div class="d-flex flex-wrap justify-content-center home-ministers">
                    <!-- gap-4 ensures equal spacing -->
                    <!-- Minister 1 -->
                    <div class="text-center home-minister-card">
                        <div class="ih-item">
                            <div class="img home-minister-photo">
                                <img src="@Url.Content(@Model.minister1_Photo)" alt="img" class="minister-img img-fluid rounded">
                            </div>
                        </div>
                        <div class="team-bottom mt-2">
                            <h6>@(Session["Lang"].ToString() == "mr" ? @Model.minister1_Name : @Model.minister1_Name_eng)</h6>
                            <p class="fw-bold text-danger fs-9">
                                @(Session["Lang"].ToString() == "mr" ? "मा. मुख्यमंत्री" : "Hon. Chief Minister")
                            </p>
                        </div>
                    </div>

                    <!-- Minister 2 -->
                    <div class="text-center home-minister-card">
                        <div class="ih-item">
                            <div class="img home-minister-photo">
                                <img src="@Url.Content(@Model.minister2_Photo)" alt="img" class="minister-img img-fluid rounded">
                            </div>
                        </div>
                        <div class="team-bottom mt-2">
                            <h6>@(Session["Lang"].ToString() == "mr" ? @Model.minister2_Name : @Model.minister2_Name_eng)</h6>
                            <p class="fw-bold text-danger fs-9">
                                @(Session["Lang"].ToString() == "mr" ? "मा. उपमुख्यमंत्री तथा गृहनिर्माण मंत्री" : "Hon. Deputy Chief Minister and Hon. Housing Minister")
                            </p>
                        </div>
                    </div>

                    <!-- Minister 3 -->
                    <div class="text-center home-minister-card">
                        <div class="ih-item">
                            <div class="img home-minister-photo">
                                <img src="@Url.Content(@Model.minister3_Photo)" alt="img" class="minister-img img-fluid rounded">
                            </div>
                        </div>
                        <div class="team-bottom mt-2">
                            <h6>@(Session["Lang"].ToString() == "mr" ? @Model.minister3_Name : @Model.minister3_Name_eng)</h6>
                            <p class="fw-bold text-danger fs-9">
                                @(Session["Lang"].ToString() == "mr" ? "मा. उपमुख्यमंत्री" : "Hon. Deputy Chief Minister")
                            </p>
                        </div>
                    </div>

                    <!-- Minister 4 -->
                    <div class="text-center home-minister-card">
                        <div class="ih-item">
                            <div class="img home-minister-photo">
                                <img src="@Url.Content(@Model.minister4_Photo)" alt="img" class="minister-img img-fluid rounded">
                            </div>
                        </div>
                        <div class="team-bottom mt-2">
                            <h6>@(Session["Lang"].ToString() == "mr" ? @Model.minister4_Name : @Model.minister4_Name_eng)</h6>
                            <p class="fw-bold text-danger fs-9">
                                @(Session["Lang"].ToString() == "mr" ? "मा. राज्यमंत्री गृहनिर्माण" : "Hon. Minister of State, Housing")
                            </p>
                        </div>
                    </div>
                    <!-- CEO 5 -->
                    <div class="text-center home-minister-card">
                        <div class="ih-item">
                            <div class="img home-minister-photo">
                                <img src="@Url.Content(@Model.ceoPhoto)" alt="img" class="minister-img img-fluid rounded">
                            </div>
                        </div>
                        <div class="team-bottom mt-2">
                            <h6>@(Session["Lang"].ToString() == "mr" ? @Model.ceoName : @Model.ceoName_eng)</h6>
                            <p class="fw-bold text-danger fs-9">
                                @(Session["Lang"].ToString() == "mr" ? "मा. मुख्य कार्यकारी अधिकारी" : "Hon. Chief Executive Officer")
                            </p>
                        </div>
                    </div>
                </div> <!-- End of flex container -->
            </div>
        </div>
    </div>
</div>

<style>
    /* View-only sizing keeps every language and slide on the same visual frame. */
    .container-fluid-slide-minister,
    .container-fluid-slide-minister .team.teamback,
    .container-fluid-slide-minister .home-ministers {
        width: 100%;
        max-width: 100%;
    }

    #carouselExample.home-banner-carousel .carousel-item {
        height: auto;
    }

    #carouselExample.home-banner-carousel .carousel-item img {
        display: block;
        width: 100%;
        height: auto;
        max-width: 100%;
        object-fit: initial;
    }

    .home-ministers {
        align-items: flex-start;
        gap: 12px;
        padding: 20px 12px 24px;
    }

    .home-ministers .home-minister-card {
        position: relative;
        display: flex;
        flex: 1 1 0;
        flex-direction: column;
        align-items: center;
        min-width: 150px;
        padding: 4px 8px;
        border: 1px solid rgba(21, 67, 112, .08);
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 5px 16px rgba(23, 53, 83, .08);
        animation: minister-card-enter .65s ease both;
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }

    .home-ministers .home-minister-card:nth-child(2) { animation-delay: .08s; }
    .home-ministers .home-minister-card:nth-child(3) { animation-delay: .16s; }
    .home-ministers .home-minister-card:nth-child(4) { animation-delay: .24s; }
    .home-ministers .home-minister-card:nth-child(5) { animation-delay: .32s; }

    .home-ministers .home-minister-card:hover {
        z-index: 1;
        transform: translateY(-6px);
        border-color: rgba(23, 104, 166, .28);
        box-shadow: 0 14px 28px rgba(23, 53, 83, .16);
    }

    .home-minister-card img.minister-img {
        transition: transform .35s ease;
    }

    .home-minister-card:hover img.minister-img {
        transform: scale(1.04);
    }

    @@keyframes minister-card-enter {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@media (prefers-reduced-motion: reduce) {
        .home-ministers .home-minister-card {
            animation: none;
            transition: none;
        }

        .home-minister-card img.minister-img {
            transition: none;
        }
    }

    .home-minister-card .ih-item {
        display: flex;
        width: 100%;
        justify-content: center;
    }

    .home-minister-card .home-minister-photo {
        display: flex;
        width: 120px;
        height: 120px;
        max-width: none;
        max-height: none;
        align-items: flex-end;
        justify-content: center;
        overflow: hidden;
    }

    .home-minister-card img.minister-img {
        display: block;
        width: 110px;
        height: 116px;
        max-width: 100%;
        object-fit: contain;
        object-position: center bottom;
    }

    .home-minister-card .team-bottom {
        width: 100%;
        margin-top: 8px;
    }

    .home-minister-card .team-bottom h6 {
        display: flex;
        min-height: 2.8em;
        align-items: center;
        justify-content: center;
        margin: 0;
        padding: 4px 0;
        font-size: clamp(11px, 0.95vw, 14px);
        line-height: 1.35;
        transform: none;
    }

    .home-minister-card .team-bottom p {
        min-height: 2.6em;
        margin: 4px 0 0;
        font-size: clamp(10px, 0.85vw, 12px);
        line-height: 1.35;
        transform: none;
    }

    @@media (max-width: 575.98px) {
        .home-ministers {
            gap: 8px;
            padding: 16px 6px 20px;
        }

        .home-ministers .home-minister-card {
            flex-basis: 145px;
            min-width: 135px;
        }
    }

    /* Keep the minister profiles in the page flow while giving them stronger visual focus. */
    #carouselExample.home-banner-carousel {
        overflow: hidden;
        border: 1px solid rgba(21, 67, 112, .12);
        border-radius: 16px;
        background: #f1f6fc;
        box-shadow: 0 12px 30px rgba(18, 55, 96, .16);
    }

    #carouselExample.home-banner-carousel .carousel-inner,
    #carouselExample.home-banner-carousel .carousel-item,
    #carouselExample.home-banner-carousel .carousel-item img {
        border-radius: 16px;
    }

    #carouselExample.home-banner-carousel .carousel-control-prev,
    #carouselExample.home-banner-carousel .carousel-control-next {
        top: 50%;
        bottom: auto;
        width: 44px;
        height: 44px;
        margin: 0 14px;
        border: 1px solid rgba(255, 255, 255, .7);
        border-radius: 50%;
        background: rgba(12, 49, 91, .68);
        opacity: .95;
        transform: translateY(-50%);
    }

    .container-fluid-slide-minister .team.teamback {
        padding: 10px 0 18px;
        background: linear-gradient(180deg, #f2f7fd, #fff 80%);
    }

    .home-ministers .home-minister-card {
        min-width: 160px;
        padding: 10px 12px 14px;
        border: 1px solid #dce6f1;
        border-top: 3px solid #1b659d;
        border-radius: 17px;
        background: linear-gradient(180deg, #fff, #fbfdff);
        box-shadow: 0 8px 20px rgba(21, 55, 91, .10);
    }

    .home-ministers .home-minister-card:first-child {
        border-top-color: #c69a3a;
        box-shadow: 0 9px 24px rgba(145, 105, 25, .15);
    }

    .home-minister-card .home-minister-photo {
        width: 132px;
        height: 136px;
        border-radius: 14px;
        background: linear-gradient(145deg, #edf5fc, #fff);
    }

    .home-minister-card img.minister-img {
        width: 126px;
        height: 132px;
    }

    .home-minister-card .team-bottom h6 {
        color: #12365f;
        font-size: clamp(14px, 1.05vw, 16px);
        font-weight: 700;
    }

    .home-minister-card .team-bottom p {
        color: #a32134;
        font-size: clamp(12px, .9vw, 13px);
        font-weight: 600;
    }

    @@media (max-width: 575.98px) {
        .home-minister-card .home-minister-photo { width: 116px; height: 120px; }
        .home-minister-card img.minister-img { width: 110px; height: 116px; }
    }

    .home-banner-stage { position: relative; width: 100%; }

    .home-banner-ministers-overlay {
        position: absolute;
        z-index: 5;
        inset: 0;
        display: grid;
        place-items: center;
        padding: clamp(12px, 2.5vw, 32px);
        border-radius: 16px;
        background: rgba(231, 239, 249, .52);
        backdrop-filter: blur(8px);
        opacity: 1;
        visibility: visible;
        transition: opacity .35s ease, visibility .35s ease;
        pointer-events: none;
    }

    .home-banner-ministers-overlay.is-scrolled { opacity: 0; visibility: hidden; }

    .home-banner-ministers-panel {
        width: min(1120px, 100%);
        padding: 15px 18px 17px;
        border: 1px solid rgba(255, 255, 255, .88);
        border-radius: 22px;
        background: rgba(255, 255, 255, .91);
        box-shadow: 0 14px 36px rgba(18, 52, 91, .19);
    }

    .home-banner-ministers-heading { margin-bottom: 12px; text-align: center; }
    .home-banner-ministers-heading > span { color: #d45832; font-size: 10px; font-weight: 800; letter-spacing: .22em; }
    .home-banner-ministers-heading h2 { margin: 2px 0 0; color: #113b6a; font-size: clamp(18px, 2vw, 25px); font-weight: 800; }
    .home-banner-minister-list { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }

    .home-banner-minister-item {
        display: flex;
        min-width: 0;
        min-height: 142px;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        gap: 7px;
        padding: 10px 8px;
        border: 1px solid #e1eaf4;
        border-top: 3px solid #1b659d;
        border-radius: 15px;
        background: linear-gradient(180deg, #fff, #f7faff);
        text-align: center;
    }

    .home-banner-minister-item:first-child { border-top-color: #c69a3a; }

    .home-banner-minister-photo {
        display: flex;
        width: 72px;
        height: 78px;
        flex: 0 0 78px;
        align-items: flex-end;
        justify-content: center;
        overflow: hidden;
        border-radius: 12px;
        background: linear-gradient(145deg, #edf5fc, #fff);
    }

    .home-banner-minister-photo img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center bottom;
    }

    .home-banner-minister-details { display: flex; min-width: 0; flex-direction: column; gap: 3px; }
    .home-banner-minister-details strong {
        color: #12365f;
        font-size: clamp(12px, .95vw, 15px);
        font-weight: 800;
        line-height: 1.35;
    }
    .home-banner-minister-details span { color: #a32134; font-size: clamp(10px, .8vw, 12px); font-weight: 600; line-height: 1.3; }

    @@media (max-width: 575.98px) {
        .home-banner-ministers-overlay { padding: 4px; }
        .home-banner-ministers-panel { padding: 5px; border-radius: 10px; }
        .home-banner-ministers-heading { margin-bottom: 3px; }
        .home-banner-ministers-heading > span { display: none; }
        .home-banner-ministers-heading h2 { margin: 0; font-size: 11px; }
        .home-banner-minister-list { gap: 3px; }
        .home-banner-minister-item { min-height: 0; gap: 2px; padding: 3px 2px; border-radius: 7px; }
        .home-banner-minister-photo { width: 42px; height: 44px; flex-basis: 44px; border-radius: 6px; }
        .home-banner-minister-details { gap: 1px; }
        .home-banner-minister-details strong { display: -webkit-box; overflow: hidden; font-size: 8px; line-height: 1.15; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
        .home-banner-minister-details span { display: -webkit-box; overflow: hidden; font-size: 7px; line-height: 1.1; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
    }

    .home-banner-layout {
        display: grid;
        grid-template-columns: minmax(0, 2.25fr) minmax(300px, .95fr);
        grid-template-rows: minmax(0, 1fr);
        aspect-ratio: 3.8 / 1;
        width: min(100% - 32px, 1600px);
        margin: 16px auto 24px;
        overflow: hidden;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 14px 36px rgba(18, 52, 91, .18);
    }

    .home-banner-layout .home-banner-stage { min-width: 0; min-height: 0; height: 100%; aspect-ratio: auto; overflow: hidden; background: transparent; }
    #carouselExample.home-banner-carousel { height: 100%; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
    #carouselExample.home-banner-carousel .carousel-inner,
    #carouselExample.home-banner-carousel .carousel-item { width: 100%; height: 100%; border-radius: 0; background: transparent; }
    #carouselExample.home-banner-carousel .carousel-item img { display: block; width: 100%; height: 100%; border-radius: 0; object-fit: contain; object-position: center; }
    #carouselExample.home-banner-carousel .carousel-control-prev,
    #carouselExample.home-banner-carousel .carousel-control-next {
        width: 50px;
        height: 50px;
        margin: 0 14px;
        border: 1px solid rgba(19, 54, 91, .14);
        border-radius: 50%;
        background: rgba(255, 255, 255, .92);
        opacity: .95;
    }
    #carouselExample.home-banner-carousel .carousel-control-prev-icon,
    #carouselExample.home-banner-carousel .carousel-control-next-icon { filter: invert(1) grayscale(1); }

    .home-minister-carousel { position: relative; min-width: 0; height: 100%; overflow: hidden; background: #fff5e7; }
    .home-minister-carousel .carousel-inner,
    .home-minister-carousel .carousel-item { height: 100%; }
    .home-minister-feature-slide { display: flex; height: 100%; flex-direction: column; }
    .home-minister-feature-art {
        position: relative;
        display: flex;
        min-height: 0;
        flex: 1 1 auto;
        align-items: flex-end;
        justify-content: center;
        overflow: hidden;
        background: linear-gradient(180deg, #ffbd78 0%, #ffd39f 58%, #fff1df 100%);
    }
    .home-minister-feature-art::before {
        position: absolute;
        bottom: 8%;
        width: 48%;
        height: 64%;
        border-radius: 34px 34px 14px 14px;
        background: #f34816;
        content: "";
    }
    .home-minister-feature-art img {
        position: relative;
        z-index: 1;
        display: block;
        width: 90%;
        height: 100%;
        max-height: 400px;
        object-fit: contain;
        object-position: center bottom;
    }
    .home-minister-feature-copy {
        display: flex;
        min-height: 94px;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 10px 20px 24px;
        background: #fffaf2;
        text-align: center;
    }
    .home-minister-feature-copy strong { color: #d84c20; font-size: clamp(16px, 1.5vw, 23px); font-weight: 800; line-height: 1.3; }
    .home-minister-feature-copy span { color: #25354b; font-size: clamp(12px, .95vw, 15px); font-weight: 600; line-height: 1.35; }
    .home-minister-carousel .carousel-indicators { right: 0; bottom: 7px; left: 0; gap: 5px; margin: 0; }
