    @model SRACMSApplication.Models.homeModel
@{
    ViewBag.Title = "Home";
    Layout = @Session["Layout"].ToString();
    //Layout = "~/Views/Shared/Master7.cshtml";
}

<!-- Bootstrap JS (Required for Carousel) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<div class="container-fluid-slide-minister"  id="targetSection">
    <!-- Carousel Section -->
    <div class="row justify-content-center">
        <div class="col-12 col-md-8">
            <div id="carouselExample" class="carousel slide" data-bs-ride="carousel">
                <!-- Indicators -->
                <div class="carousel-indicators">
                    @for (int i = 0; i < Model.banner_List.Count; i++)
                    {
                        <button type="button" data-bs-target="#carouselExample" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-label="Slide @(i+1)"></button>
                    }
                </div>

                <div class="carousel-inner">
                    @foreach (var item in Model.banner_List.Select((x, i) => new { Data = x, Index = i }))
                    {
                        <div class="carousel-item @(item.Index == 0 ? "active" : "")" data-bs-interval="3000">
                            <img class="d-block w-100 img-fluid" src="@Url.Content(item.Data.doc_location + item.Data.doc_name)" alt="Slide @item.Index">
                        </div>
                    }
                </div>

                <!-- Navigation Arrows -->
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                </button>
            </div>
        </div>
    </div>

    <!-- Ministers Section (Single Horizontal Row) -->
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="team teamback">
                <div class="d-flex flex-wrap justify-content-center ">
                    <!-- gap-4 ensures equal spacing -->
                    <!-- Minister 1 -->
                    <div class="text-center ">
                        <div class="ih-item">
                            <div class="img">
                                <img src="@Url.Content(@Model.minister1_Photo)" alt="img" class="minister-img img-fluid rounded">
                            </div>
                        </div>
                        <div class="team-bottom mt-2">
                            <h6>@(Session["Lang"].ToString() == "mr" ? @Model.minister1_Name : @Model.minister1_Name_eng)</h6>
                            <p class="fw-bold text-danger fs-9">
                                @(Session["Lang"].ToString() == "mr" ? "मा. मुख्यमंत्री" : "Hon. Chief Minister")
                            </p>
                        </div>
                    </div>

                    <!-- Minister 2 -->
                    <div class="text-center ">
                        <div class="ih-item">
                            <div class="img">
                                <img src="@Url.Content(@Model.minister2_Photo)" alt="img" class="minister-img img-fluid rounded">
                            </div>
                        </div>
                        <div class="team-bottom mt-2">
                            <h6>@(Session["Lang"].ToString() == "mr" ? @Model.minister2_Name : @Model.minister2_Name_eng)</h6>
                            <p class="fw-bold text-danger fs-9">
                                @(Session["Lang"].ToString() == "mr" ? "मा. उपमुख्यमंत्री तथा गृहनिर्माण मंत्री" : "Hon. Deputy Chief Minister and Hon. Housing Minister")
                            </p>
                        </div>
                    </div>

                    <!-- Minister 3 -->
                    <div class="text-center ">
                        <div class="ih-item">
                            <div class="img">
                                <img src="@Url.Content(@Model.minister3_Photo)" alt="img" class="minister-img img-fluid rounded">
                            </div>
                        </div>
                        <div class="team-bottom mt-2">
                            <h6>@(Session["Lang"].ToString() == "mr" ? @Model.minister3_Name : @Model.minister3_Name_eng)</h6>
                            <p class="fw-bold text-danger fs-9">
                                @(Session["Lang"].ToString() == "mr" ? "मा. उपमुख्यमंत्री" : "Hon. Deputy Chief Minister")
                            </p>
                        </div>
                    </div>

                    <!-- Minister 4 -->
                    <div class="text-center ">
                        <div class="ih-item">
                            <div class="img">
                                <img src="@Url.Content(@Model.minister4_Photo)" alt="img" class="minister-img img-fluid rounded">
                            </div>
                        </div>
                        <div class="team-bottom mt-2">
                            <h6>@(Session["Lang"].ToString() == "mr" ? @Model.minister4_Name : @Model.minister4_Name_eng)</h6>
                            <p class="fw-bold text-danger fs-9">
                                @(Session["Lang"].ToString() == "mr" ? "मा. राज्यमंत्री गृहनिर्माण" : "Hon. Minister of State, Housing")
                            </p>
                        </div>
                    </div>
                    <!-- CEO 5 -->
                    <div class="text-center ">
                        <div class="ih-item">
                            <div class="img">
                                <img src="@Url.Content(@Model.ceoPhoto)" alt="img" class="minister-img img-fluid rounded">
                            </div>
                        </div>
                        <div class="team-bottom mt-2">
                            <h6>@(Session["Lang"].ToString() == "mr" ? @Model.ceoName : @Model.ceoName_eng)</h6>
                            <p class="fw-bold text-danger fs-9">
                                @(Session["Lang"].ToString() == "mr" ? "मा. मुख्य कार्यकारी अधिकारी" : "Hon. Chief Executive Officer")
                            </p>
                        </div>
                    </div>
                </div> <!-- End of flex container -->
            </div>
        </div>
    </div>
</div>





