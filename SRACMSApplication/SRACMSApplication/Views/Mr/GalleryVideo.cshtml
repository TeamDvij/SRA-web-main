@{
    ViewBag.Title = "Gallery";
    Layout = (Session["Layout"] != null) ? Session["Layout"].ToString() : "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/webcss/video-gallery.css" rel="stylesheet" />

<div class="sramain" id="targetSection">
    <div class="row">
        <div class="col-md-12">
            <h3 class="fs-5" style="background-color: antiquewhite; padding:10px;">
                व्हिडिओ गॅलरी
            </h3>

            <div class="video-gallery-wrapper">
                <div class="video-gallery-row">

                    @if (ViewBag.VideoGalleryList != null)
                    {
                        for (int j = 0; j < ViewBag.VideoGalleryList.Count; j++)
                        {
                            //var videoPath = Url.Content("~/Content/Videos/4.mp4");

                            <div class="video-gallery-col">
                                <div class="video-card">
                                    <div class="video-thumbnail"
                                         onclick="openVideoModal('@Url.Content(ViewBag.VideoGalleryList[j].doc_location + ViewBag.VideoGalleryList[j].doc_name)', @(j - 1))">

                                        <video preload="metadata">
                                            <source src="@Url.Content(ViewBag.VideoGalleryList[j].doc_location + ViewBag.VideoGalleryList[j].doc_name)" type="video/mp4" />
                                        </video>

                                        <div class="video-play-button">
                                            <span>▶</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    </div>
            </div>
        </div>

        <!-- VIDEO MODAL -->
        <div id="videoModal" class="video-modal">

            <!-- Toolbar Controls (Zoom In, Zoom Out, Close) -->
            <div class="video-modal-controls">
                <button type="button" class="modal-ctrl-btn" onclick="zoomIn()" title="Zoom In">+</button>
                <button type="button" class="modal-ctrl-btn" onclick="zoomOut()" title="Zoom Out">-</button>
                <button type="button" class="video-modal-close modal-ctrl-btn" onclick="closeVideoModal()" title="Close">&times;</button>
            </div>

            <!-- Previous Button -->
            <button type="button" class="modal-nav-btn modal-nav-prev" onclick="prevVideo()">&#10094;</button>

            <!-- Video Modal Content Wrapper -->
            <div class="video-modal-content-wrapper">
                <video id="modalVideo"
                       controlsList="nodownload"
                       disablePictureInPicture
                       controls
                       autoplay
                       playsinline>
                </video>
            </div>

            <!-- Next Button -->
            <button type="button" class="modal-nav-btn modal-nav-next" onclick="nextVideo()">&#10095;</button>

        </div>
    </div>
</div>

<script>
    let galleryVideos = [];
    let currentIndex = 0;
    let currentZoom = 1;

    // Automatically collect all video source paths on page load
    document.addEventListener("DOMContentLoaded", function () {
        const videoSources = document.querySelectorAll('.video-thumbnail video source');
        galleryVideos = Array.from(videoSources).map(source => source.src);
    });

    function openVideoModal(videoUrl, index) {
        currentIndex = index;
        currentZoom = 1; // Reset zoom state

        var modal = document.getElementById("videoModal");
        var video = document.getElementById("modalVideo");

        video.src = galleryVideos.length > 0 ? galleryVideos[currentIndex] : videoUrl;
        video.style.transform = `scale(${currentZoom})`;

        modal.style.display = "flex";
        document.body.style.overflow = "hidden";

        video.play().catch(function () {
            // Browser may block autoplay
        });
    }

    function closeVideoModal() {
        var modal = document.getElementById("videoModal");
        var video = document.getElementById("modalVideo");

        video.pause();
        video.removeAttribute("src");
        video.load();

        currentZoom = 1;
        video.style.transform = `scale(${currentZoom})`;

        modal.style.display = "none";
        document.body.style.overflow = "";
    }

    function nextVideo() {
        if (galleryVideos.length === 0) return;
        currentIndex = (currentIndex + 1) % galleryVideos.length; // Loop back to start
        resetZoomAndLoadVideo();
    }

    function prevVideo() {
        if (galleryVideos.length === 0) return;
        currentIndex = (currentIndex - 1 + galleryVideos.length) % galleryVideos.length; // Loop to end
        resetZoomAndLoadVideo();
    }

    function zoomIn() {
        if (currentZoom < 3) { // Max zoom limit (3x)
            currentZoom += 0.25;
            updateZoom();
        }
    }

    function zoomOut() {
        if (currentZoom > 0.5) { // Min zoom limit (0.5x)
            currentZoom -= 0.25;
            updateZoom();
        }
    }

    function updateZoom() {
        var video = document.getElementById("modalVideo");
        video.style.transform = `scale(${currentZoom})`;
    }

    function resetZoomAndLoadVideo() {
        currentZoom = 1;
        var video = document.getElementById("modalVideo");
        video.style.transform = `scale(${currentZoom})`;

        video.pause();
        video.src = galleryVideos[currentIndex];
        video.load();
        video.play().catch(function () { });
    }

    /* Close when clicking outside video content */
    document.getElementById("videoModal").addEventListener("click", function (event) {
        if (event.target === this) {
            closeVideoModal();
        }
    });

    /* Keyboard navigation & controls */
    document.addEventListener("keydown", function (event) {
        var modal = document.getElementById("videoModal");
        if (modal.style.display === "flex") {
            if (event.key === "Escape") {
                closeVideoModal();
            } else if (event.key === "ArrowRight") {
                nextVideo();
            } else if (event.key === "ArrowLeft") {
                prevVideo();
            }
        }
    });
</script>