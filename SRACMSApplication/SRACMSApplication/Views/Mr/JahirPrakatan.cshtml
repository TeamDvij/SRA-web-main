@model SRACMSApplication.Models.other_jahirPrakatanModel
@{
    ViewBag.Title = "JahirPrakatan";
    //Layout = "~/Views/Shared/Master7.cshtml";
    Layout = @Session["Layout"].ToString();
}

<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<!-- Add jQuery and DataTables JS -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<link href="~/Content/webcss/tabs.css" rel="stylesheet" />

<div class="sramain" id="targetSection">
    <div class="row">
        <div class="col-md-12">
            <h3 class="fs-5" style="background-color: antiquewhite; padding:10px;">
                जाहीर प्रकटने
            </h3>
        </div>
        <div class="col-md-12">
            @*Tab List*@
            <div class="tab">
                <button class="tablinks" onclick="openTab(event, 'Tab1')" id="defaultOpen">@(Session["Lang"].ToString() == "mr" ? "प्राथमिक सर्व्हेक्षण" : "Preliminary Survey")</button>
                <button class="tablinks" onclick="openTab(event, 'Tab2')">@(Session["Lang"].ToString() == "mr" ? "प्राथमिक पात्रता" : "Primary Eligibility")</button>
                <button class="tablinks" onclick="openTab(event, 'Tab3')">@(Session["Lang"].ToString() == "mr" ? "अंतिम पात्रता" : "Final Eligibility")</button>
            </div>
            @*प्राथमिक सर्व्हेक्षण*@
            <div id="Tab1" class="tabcontent" style="padding:10px;">
                <div class="table-container">
                    <table id="datatable1" cellspacing="0" style="padding:10px;">
                        <thead>
                            <tr>
                                <th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "अ.क्र." : "Sr.No.")</th>
                                <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "विभाग" : "Department")</th>
                                <th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "जाहीर प्रकटन नं." : "Disclosure No.")</th>
                                <th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "विषय" : "Subject") </th>
                                <th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "अपलोड तारीख" : "Upload Date")</th>
                                <th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "पहा" : "View")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OtherJahirPrakatanList.Select((x, i) => new { Data = x, Index = i + 1 }))
                            {
                                <tr>
                                    <td style="text-align:center">@item.Index</td>
                                    <td style="text-align:center">@(Session["Lang"].ToString() == "mr" ? @item.Data.sys_config.sys_name_mar : @item.Data.sys_config.sys_name_eng)</td>
                                    <td style="text-align:left">@(Session["Lang"].ToString() == "mr" ? @item.Data.disclosure_number : @item.Data.disclosure_number_eng)</td>
                                    <td style="text-align:left">@(Session["Lang"].ToString() == "mr" ? @item.Data.subject : @item.Data.subject_eng)</td>
                                    <td style="text-align:center">@item.Data.upload_date</td>
                                    <td class="tCenter">
                                        <a href="@Url.Content(@item.Data.doc_location+@item.Data.doc_name)" class="marathi_font" target="_blank">
                                            <img src="~/Content/images/pdf-logo.png" width="25" height="25">
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <!-- Add DataTables CSS -->
                    <script>
                        $(document).ready(function () {
                            var lang = '@Session["Lang"].ToString()';
                            // Initialize DataTable
                            var table = $('#datatable1').DataTable({
                                "paging": true,
                                "pageLength": 5,
                                "lengthMenu": [5, 10, 25, 50, 100],
                                "language": {
                                    "url": lang === 'mr' ?
                                        '//cdn.datatables.net/plug-ins/1.13.6/i18n/mr.json' :
                                        '//cdn.datatables.net/plug-ins/1.13.6/i18n/en-GB.json'
                                },
                                "columnDefs": [
                                    { "orderable": false, "targets": [4, 5] }, // Disable sorting for View column
                                    { "searchable": false, "targets": [] } // Disable search for Sr.No and View columns
                                ]
                            });
                            // Add search input functionality
                            $('#searchInput').on('keyup', function () {
                                table.search(this.value).draw();
                            });
                        });
                    </script>
                </div>
            </div>

            @*प्राथमिक पात्रता*@
            <div id="Tab2" class="tabcontent" style="padding:10px">
                <table id="datatable2" cellspacing="0" style="padding:10px">
                    <thead>
                        <tr>
                            <th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "अ.क्र." : "Sr.No.")</th>
                            <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "विभाग" : "Department")</th>
                            <th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "योजनेचे नाव" : "Scheme Name")</th>
                            <th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "तारीख" : "Date")</th>
                            <th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "पहा" : "View")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.primary_Notice_List.Select((x, i) => new { Data = x, Index = i + 1 }))
                        {
                            <tr>
                                <td style="text-align:center">@item.Index</td>
                                <td style="text-align:center">@(Session["Lang"].ToString() == "mr" ? @item.Data.sys_config.sys_name_mar : @item.Data.sys_config.sys_name_eng)</td>
                                <td style="text-align:left">@(Session["Lang"].ToString() == "mr" ? @item.Data.plan_name : @item.Data.plan_name_eng)</td>
                                @if (@item.Data.plan_date_New.ToString("dd-MM-yyyy") != "01-01-1900")
                                {
                                    <td style="text-align:center">@item.Data.plan_date_New.ToString("dd-MM-yyyy")</td>
                                }
                                @if (@item.Data.plan_date_New.ToString("dd-MM-yyyy") == "01-01-1900")
                                {
                                    <td></td>
                                }
                                <td class="tCenter">
                                    <a href="@Url.Content(@item.Data.doc_location+@item.Data.doc_name)" class="marathi_font" target="_blank">
                                        <img src="~/Content/images/pdf-logo.png" width="25" height="25">
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <!-- Add DataTables CSS -->
                <script>
                    $(document).ready(function () {
                        var lang = '@Session["Lang"].ToString()';

                        // Initialize DataTable
                        var table = $('#datatable2').DataTable({
                            "paging": true,
                            "pageLength": 5,
                            "lengthMenu": [5, 10, 25, 50, 100],
                            "language": {
                                "url": lang === 'mr' ?
                                    '//cdn.datatables.net/plug-ins/1.13.6/i18n/mr.json' :
                                    '//cdn.datatables.net/plug-ins/1.13.6/i18n/en-GB.json'
                            },
                            "columnDefs": [
                                { "orderable": false, "targets": [3, 4] }, // Disable sorting for View column
                                { "searchable": false, "targets": [] } // Disable search for Sr.No and View columns
                            ]
                        });

                        // Add search input functionality
                        $('#searchInput').on('keyup', function () {
                            table.search(this.value).draw();
                        });
                    });
                </script>
            </div>

            @*अंतिम पात्रता*@
            <div id="Tab3" class="tabcontent" style="padding:10px">
                <table id="datatable3" cellspacing="0" style="padding:10px">
                    <thead>
                        <tr>
                            <th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "अ.क्र." : "Sr.No.")</th>
                            <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "विभाग" : "Department")</th>
                            <th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "योजनेचे नाव" : "Scheme Name")</th>
                            <th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "तारीख" : "Date")</th>
                            <th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "पहा" : "View")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.final_Notice_List.Select((x, i) => new { Data = x, Index = i + 1 }))
                        {
                            <tr>
                                <td style="text-align:center">@item.Index</td>
                                <td style="text-align:center">@(Session["Lang"].ToString() == "mr" ? @item.Data.sys_config.sys_name_mar : @item.Data.sys_config.sys_name_eng)</td>
                                <td style="text-align:left">@(Session["Lang"].ToString() == "mr" ? @item.Data.plan_name : @item.Data.plan_name_eng)</td>
                                @if (@item.Data.plan_date_New.ToString("dd-MM-yyyy") != "01-01-1900")
                                {
                                    <td style="text-align:center">@item.Data.plan_date_New.ToString("dd-MM-yyyy")</td>
                                }
                                @if (@item.Data.plan_date_New.ToString("dd-MM-yyyy") == "01-01-1900")
                                {
                                    <td></td>
                                }
                                <td class="tCenter">
                                    <a href="@Url.Content(@item.Data.doc_location+@item.Data.doc_name)" class="marathi_font" target="_blank">
                                        <img src="~/Content/images/pdf-logo.png" width="25" height="25">
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <!-- Add DataTables CSS -->
                <script>
                    $(document).ready(function () {
                        var lang = '@Session["Lang"].ToString()';

                        // Initialize DataTable
                        var table = $('#datatable3').DataTable({
                            "paging": true,
                            "pageLength": 5,
                            "lengthMenu": [5, 10, 25, 50, 100],
                            "language": {
                                "url": lang === 'mr' ?
                                    '//cdn.datatables.net/plug-ins/1.13.6/i18n/mr.json' :
                                    '//cdn.datatables.net/plug-ins/1.13.6/i18n/en-GB.json'
                            },
                            "columnDefs": [
                                { "orderable": false, "targets": [3, 4] }, // Disable sorting for View column
                                { "searchable": false, "targets": [] } // Disable search for Sr.No and View columns
                            ]
                        });

                        // Add search input functionality
                        $('#searchInput').on('keyup', function () {
                            table.search(this.value).draw();
                        });
                    });
                </script>
            </div>
        </div>
    </div>
</div>

@*Tab Script*@
<script>
            function openTab(evt, tabName) {
                // Hide all tab content
                let tabcontent = document.getElementsByClassName("tabcontent");
                for (let i = 0; i < tabcontent.length; i++) {
                    tabcontent[i].style.display = "none";
                }

                // Remove active class from all buttons
                let tablinks = document.getElementsByClassName("tablinks");
                for (let i = 0; i < tablinks.length; i++) {
                    tablinks[i].className = tablinks[i].className.replace(" active", "");
                }

                // Show the selected tab content and mark button as active
                document.getElementById(tabName).style.display = "block";
                evt.currentTarget.className += " active";
            }

            // Open the default tab on page load
            document.getElementById("defaultOpen").click();
</script>
