@model SRACMSApplication.Models.other_developerModel
@{
    ViewBag.Title = "VikasakList";
    Layout = @Session["Layout"].ToString();
    //Layout = "~/Views/Shared/Master7.cshtml";
}


<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">


<!-- Add jQuery and DataTables JS -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<link href="~/Content/webcss/tabs.css" rel="stylesheet" />

<div class="sramain" id="targetSection">
    <div class="row">
        <div class="col-md-12">
            <h3 class="fs-5" style="background-color: antiquewhite; padding:10px;">
                @(Session["Lang"].ToString() == "mr" ? "नोंदणीकृत विकसकांची यादी" : "Registered Developer List")
            </h3>
        </div>
        <div class="col-md-12 table-container">
            <table id="datatable" style="padding:10px">
                <thead>
                    <tr>
                        <th style="text-align:center;width:5%;">@(Session["Lang"].ToString() == "mr" ? "अ.क्र." : "Sr.No.")</th>
                        <th style="text-align:center;">@(Session["Lang"].ToString() == "mr" ? "विकसक संस्थेचे नाव व पत्ता" : "Developer Firm Name")</th>
                        <th style="text-align: center; width: 15%;">@(Session["Lang"].ToString() == "mr" ? "दूरध्वनी / मोबाईल क्रमांक" : "Contact Number")</th>
                        <th style="text-align: center; width: 13%;">@(Session["Lang"].ToString() == "mr" ? "नोंदणी वर्ग व क्रमांक" : "Registration Number")</th>
                        <th style="text-align: center; width: 13%;">@(Session["Lang"].ToString() == "mr" ? "नोंदणी दिनांक" : "Registration Date")</th>
                        @*<th style="text-align:center;">@(Session["Lang"].ToString() == "mr" ? "पूर्ण केलेले प्रकल्प" : "Completed Projects")</th>
                            <th style="text-align:center;">@(Session["Lang"].ToString() == "mr" ? "सुरु असलेले प्रकल्प" : "Ongoing Projects")</th>*@
                    </tr>

                </thead>
                <tbody>
                    @foreach (var item in Model.developerList.Select((x, i) => new { Data = x, Index = i + 1 }))
                    {
                        <tr>
                            <td style="text-align:center">@item.Index</td>
                            <td style="text-align:left;">
                                <spam style="font-weight:bold;">@(Session["Lang"].ToString() == "mr" ? @item.Data.dev_name : @item.Data.dev_name_eng)</spam> <br />
                                @(Session["Lang"].ToString() == "mr" ? @item.Data.dev_address : @item.Data.dev_address_eng)
                            </td>
                            <td style="text-align:center">@(Session["Lang"].ToString() == "mr" ? @item.Data.dev_contact : @item.Data.dev_contact_eng)</td>
                            <td style="text-align:center">
                                <spam style="font-weight:bold;">@(Session["Lang"].ToString() == "mr" ? @item.Data.dev_class : @item.Data.dev_class_eng)</spam> <br />
                                @(Session["Lang"].ToString() == "mr" ? @item.Data.dev_registration_no : @item.Data.dev_registration_no_eng)
                            </td>
                            @if (@item.Data.dev_registration_date.ToString("dd-MM-yyyy") != "01-01-1900")
                            {
                                <td style="text-align:center">@item.Data.dev_registration_date.ToString("dd-MM-yyyy")</td>
                            }
                            @if (@item.Data.dev_registration_date.ToString("dd-MM-yyyy") == "01-01-1900")
                            {
                                <td></td>
                            }

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


<!-- Add DataTables CSS -->

<script>
    $(document).ready(function() {
        var lang = '@Session["Lang"].ToString()';

        // Initialize DataTable
        var table = $('#datatable').DataTable({
            "paging": true,
            "pageLength": 5,
            "lengthMenu": [5,10, 25, 50, 100],
            "language": {
                "url": lang === 'mr' ?
                    '//cdn.datatables.net/plug-ins/1.13.6/i18n/mr.json' :
                    '//cdn.datatables.net/plug-ins/1.13.6/i18n/en-GB.json'
            },
            "columnDefs": [
                { "orderable": false, "targets": [4] }, // Disable sorting for View column
                { "searchable": false, "targets": [] } // Disable search for Sr.No and View columns
            ]
        });

        // Add search input functionality
        $('#searchInput').on('keyup', function() {
            table.search(this.value).draw();
        });

    });
</script>





