@model SRACMSApplication.Models.other_building_permission_bhogvataModel
@{
    ViewBag.Title = "Occupancy Certificates";
    Layout = @Session["Layout"].ToString();
    //Layout = "~/Views/Shared/Master7.cshtml";
}


<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">


<!-- Add jQuery and DataTables JS -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<link href="~/Content/webcss/tabs.css" rel="stylesheet" />

<div class="sramain" id="targetSection">
    <div class="row">
        <div class="col-md-12">
            <h3 class="fs-5" style="background-color: antiquewhite; padding:10px;">
                @(Session["Lang"].ToString() == "mr" ? "भोगवटा प्रमाणपत्रे" : "Occupancy Certificates")
            </h3>
        </div>
        <div class="col-md-12 table-container">
            @{
                int srno = 1;  // Initialize serial number for groups
            }
            <table id="datatable" style="padding:10px">
                <thead>
                    <tr>
                        <th style="text-align:center; width:2%;">@(Session["Lang"].ToString() == "mr" ? "अ.क्र." : "Sr.No.")</th>
                        <th style="text-align:center; width:5%;" title="मास्टर क्रमांक">@(Session["Lang"].ToString() == "mr" ? "मा.क्र." : "Master No.")</th>
                        <th style="text-align:center; width:12%;">@(Session["Lang"].ToString() == "mr" ? "विभाग" : "Department")</th>
                        <th style="text-align:left; width:40%;">@(Session["Lang"].ToString() == "mr" ? "योजनाचे नाव" : "Project Name") </th>
                        <th style="text-align:center; width:15%;">@(Session["Lang"].ToString() == "mr" ? "तपशील" : "Details")</th>
                    </tr>

                </thead>
                <tbody>
                    @foreach (var group in Model.other_bhogvata_list.OrderByDescending(x => x.proj_date).GroupBy(x => new { x.project_new.project_name, x.project_new.Master_no, x.sys_config.sys_name_mar }))
                    {
                        <tr>
                            <td style="text-align:center;">@srno</td>
                            <td style="text-align:center;">@(group.Key.Master_no.ToString() == "0" ? "" : group.Key.Master_no.ToString())</td>
                            <td style="text-align:center;">@group.Key.sys_name_mar</td>
                            <td style="text-align:left;">@group.Key.project_name</td>
                            <td style="text-align:center;">
                                @foreach (var item in group.OrderByDescending(x => x.proj_date))
                                {
                                    <div style="margin-top:1%;margin-bottom:1%;">
                                        @item.proj_date.ToString("dd-MM-yyyy")
                                        <a style="background-color:white; border:none;" href="@Url.Content(@item.doc_location + @item.doc_name)" target="_blank" class="btn btn-primary btn-sm">
                                            <img src="~/Content/images/pdf-logo.png" width="25" height="25">
                                        </a>
                                    </div>
                                }
                            </td>
                        </tr>
                        { srno = srno + 1; }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>




<!-- Add DataTables CSS -->

<script>
    $(document).ready(function() {
        var lang = '@Session["Lang"].ToString()';

        // Initialize DataTable
        var table = $('#datatable').DataTable({
            "paging": true,
            "pageLength": 5,
            "lengthMenu": [5,10, 25, 50, 100],
            "language": {
                "url": lang === 'mr' ?
                    '//cdn.datatables.net/plug-ins/1.13.6/i18n/mr.json' :
                    '//cdn.datatables.net/plug-ins/1.13.6/i18n/en-GB.json'
            },
            "columnDefs": [
                { "orderable": false, "targets": [4] }, // Disable sorting for View column
                { "searchable": false, "targets": [] } // Disable search for Sr.No and View columns
            ]
        });

        // Add search input functionality
        $('#searchInput').on('keyup', function() {
            table.search(this.value).draw();
        });

    });
</script>



