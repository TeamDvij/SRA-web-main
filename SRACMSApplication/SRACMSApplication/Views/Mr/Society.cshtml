@model SRACMSApplication.Models.societyModel
@{
    ViewBag.Title = "Society";
    Layout = @Session["Layout"].ToString();
    //Layout = "~/Views/Shared/Master7.cshtml";
}

<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">

<!-- Add jQuery and DataTables JS -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<link href="~/Content/webcss/tabs.css" rel="stylesheet" />


<div class="sramain" id="targetSection">
    <div class="row">
        <div class="col-md-12">
            <h3 class="fs-5" style="background-color: antiquewhite; padding:10px;">
                @(Session["Lang"].ToString() == "mr" ? "गृहनिर्माण संस्थांची यादी" : "List of housing societies")
            </h3>
        </div>
        <div class="col-md-12  table-container">
            <table id="datatable" style="padding:10px">
                <thead>
                    <tr>
                        <th style="text-align: center;">@(Session["Lang"].ToString() == "mr" ? "अ.क्र." : "Sr.No.")</th>
                        <th style="text-align: center;">@(Session["Lang"].ToString() == "mr" ? "संस्थेचे नाव" : "Society Name") </th>
                        <th style="text-align: center;">@(Session["Lang"].ToString() == "mr" ? "संस्थेचा पत्ता" : "Society Address") </th>
                        <th style="text-align: center;">@(Session["Lang"].ToString() == "mr" ? "नोंदणी क्रमांक" : "Registration No.")</th>
                        <th style="text-align: center;">@(Session["Lang"].ToString() == "mr" ? "नोंदणी दिनांक" : "Registration Date") </th>
                    </tr>

                </thead>
                <tbody>
                    @foreach (var item in Model.society_List.Select((x, i) => new { Data = x, Index = i + 1 }))
                    {
                        <tr>
                            <td style="text-align: center;width: 5%;">@item.Index</td>
                            <td style="width: 30%;">@(Session["Lang"].ToString() == "mr" ? @item.Data.soc_name : @item.Data.soc_name_eng)</td>
                            <td style="width: 30%;">@(Session["Lang"].ToString() == "mr" ? @item.Data.soc_address : @item.Data.soc_address_eng)</td>
                            <td style="width: 20%;">@(Session["Lang"].ToString() == "mr" ? @item.Data.soc_registration_no : @item.Data.soc_registration_no_eng)</td>
                            @if (@item.Data.soc_registration_dt.ToString("dd-MM-yyyy") != "01-01-1900")
                            {
                                <td style="text-align: center;width: 12%;">@item.Data.soc_registration_dt.ToString("dd-MM-yyyy")</td>
                            }

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


<!-- Add DataTables CSS -->

<script>
    $(document).ready(function() {
        var lang = '@Session["Lang"].ToString()';

        // Initialize DataTable
        var table = $('#datatable').DataTable({
            "paging": true,
            "pageLength": 5,
            "lengthMenu": [5,10, 25, 50, 100],
            "language": {
                "url": lang === 'mr' ?
                    '//cdn.datatables.net/plug-ins/1.13.6/i18n/mr.json' :
                    '//cdn.datatables.net/plug-ins/1.13.6/i18n/en-GB.json'
            },
            "columnDefs": [
                { "orderable": false, "targets": [4] }, // Disable sorting for View column
                { "searchable": false, "targets": [] } // Disable search for Sr.No and View columns
            ]
        });

        // Add search input functionality
        $('#searchInput').on('keyup', function() {
            table.search(this.value).draw();
        });

    });
</script>
