    <style>
        
        .sitemap-section {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 41px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
            margin-bottom: 20px;
        }

            .sitemap-section h3 {
                font-size: 18px;
                margin-bottom: 12px;
                color: #111827;
                border-bottom: 2px solid #e5e7eb;
                padding-bottom: 6px;
            }

            .sitemap-section ul {
                list-style: none;
                padding-left: 0;
                margin-bottom: 0;
                text-align:left;
            }

            .sitemap-section li {
                margin: 6px 0;
                line-height: 2;
                list-style-type: square; /* hollow circle (different style) */
            }

            .sitemap-section a {
                text-decoration: none;
                color: #0d6efd;
            }

                .sitemap-section a:hover {
                    text-decoration: underline;
                }
            /* Submenu */
            .sitemap-section ul ul {
                margin-top: 6px;
                margin-left: 18px;
                padding-left: 12px;
                border-left: 2px solid #dee2e6;
                list-style: none; /* remove default bullets */
            }

                .sitemap-section ul ul li::before {
                    content: "•"; /* or "→", "›", "‣" */
                    color: #333; /* bullet color */
                    font-weight: bold;
                    display: inline-block;
                    width: 1em;
                    margin-left: -1em; /* align bullets correctly */
                }


                .sitemap-section ul ul li {
                    font-size: 15px;
                    margin: 4px 0;
                    list-style-type: circle; /* hollow circle (different style) */
                }
    </style>
    <style>
        .scrollable-div {
            height: 550px; /* Fixed height */
            overflow-y: scroll; /* Enables vertical scrolling */
            /*border: 1px solid #ccc;*/ /* Optional, for better visibility */
            /*padding: 10px;*/
        }

        .b {
            color: antiquewhite;
        }
    </style>
