                                        <thead>
                                            <tr>
                                                <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "अ.क्र." : "Sr.No.")</th>
                                                <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "प्रकल्पाचे नाव" : "Project Name") </th>
                                                <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "दिनांक" : "Date")</th>
                                                <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "पहा" : "View")</th>
                                            </tr>
