                                                <th style="text-align:center;">3</th>
                                                <th style="text-align:center;">4</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.other_order_3c_primaryList.Select((x, i) => new { Data = x, Index = i + 1 }))
