<div class="container containerStyle">
    <div class="row">
        <div>
            <div class="multimedia">
                <h3>@(Session["Lang"].ToString() == "mr" ? "योजना मंजुरी  14.6.12 (1)" : "Scheme Approval  14.6.12 (1)")</h3>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs">
        <li class="active"><a data-toggle="tab" href="#SR1">@(Session["Lang"].ToString() == "mr" ? "प्रारूप योजना मंजुरी" : "Preliminary Scheme Approval")</a></li>
        <li><a data-toggle="tab" href="#SR2">@(Session["Lang"].ToString() == "mr" ? "अंतिम योजना मंजुरी" : "Final Scheme Approval")</a></li>
    </ul>

    <div class="tab-content">
        <div id="SR1" class="tab-pane fade in active">
            @*<div class="multimedia">
                <h3 style="font-size: medium;">@(Session["Lang"].ToString() == "mr" ? "प्रारूप योजना मंजुरी" : "Preliminary Scheme Approval")</h3>
            </div>*@
            <table id="datatable1" class="table table-striped table-bordered pStyle" cellspacing="0" width="100%">
                <thead>
                    <tr>
                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "अ.क्र." : "Sr.No.")</th>
                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "मा.क्र." : "Master No.")</th>
                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "विभाग" : "Department")</th>
                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "योजनेचे नाव" : "Scheme Name")</th>
                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "दिनांक" : "Date")</th>
                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "यादी ४(३)" : "List 4(3)")</th>
                    </tr>
                    @*<tr style="font-size:medium;">
                        <th style="text-align:center;">1</th>
                        <th style="text-align:center;">2</th>
                        <th style="text-align:center;">3</th>
                        <th style="text-align:center;">4</th>
                    </tr>*@
                </thead>
                <tbody>
                    @foreach (var item in Model.other_srList.Select((x, i) => new { Data = x, Index = i + 1 }))
                    {
                        <tr>
                            <td style="text-align:center;width:5%;">@item.Index</td>
                            <td style="text-align:center;width:8%;">@(item.Data.project_new.Master_no.ToString() == "0" ? "" : item.Data.project_new.Master_no.ToString())</td>
                            <td style="text-align:center;width:8%;">@(Session["Lang"].ToString() == "mr" ? @item.Data.sys_config.sys_name_mar : @item.Data.sys_config.sys_name_eng)</td>
                            <td style="text-align:left;width:50%;">@(item.Data.project_new.Master_no.ToString() == "0" ? (Session["Lang"].ToString() == "mr" ? @item.Data.subject : @item.Data.subject) : (Session["Lang"].ToString() == "mr" ? @item.Data.project_new.project_name : @item.Data.project_new.project_name_eng) ) </td>
                            @*<td style="text-align:left">@(Session["Lang"].ToString() == "mr" ? @item.Data.subject : @item.Data.subject_eng)</td>*@
                            <td style="text-align:center;width:12%;">@item.Data.subject_date.ToString("dd-MM-yyyy")</td>
                            <td class="tCenter" style="width:5%">
                                <a href="@Url.Content(@item.Data.doc_location+@item.Data.doc_name)" class="marathi_font" target="_blank">
                                    <img src="~/Content/images/pdf-logo.png" width="25" height="25">
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
        <div id="SR2" class="tab-pane fade">
            @*<div class="multimedia">
                <h3 style="font-size: medium;">@(Session["Lang"].ToString() == "mr" ? "अंतिम योजना मंजुरी" : "Final Scheme Approval")</h3>
            </div>*@
            <table id="datatable2" class="table table-striped table-bordered pStyle" cellspacing="0" width="100%">
                <thead>
                    <tr>
                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "अ.क्र." : "Sr.No.")</th>
                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "मा.क्र." : "Master No.")</th>
                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "विभाग" : "Department")</th>
