@model SRACMSApplication.Models.other_building_permission_bhogvataModel

@{
    ViewBag.Title = "BuildingPermission1";
    Layout = "~/Views/Shared/_newMaster.cshtml";
}



<!DOCTYPE html>
<html>
<head>
    @*javascript*@
    <script>
    $(document).ready(function () {
        $('#datatable').dataTable(),
        $("[data-toggle=tooltip]").tooltip();
    });

    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="~/Content/webcss/New.css" rel="stylesheet" />
    <link href="~/Content/webcss/template3.css" rel="stylesheet" />
</head>
<body>
    <div class="grid-container" style="margin-bottom: 181px;">
        <div class="item3">
            <h3 style="margin-top:-20px;">@(Session["Lang"].ToString() == "mr" ? "बांधकाम परवानगी प्रमाणपत्रे" : "Building Permission Certificates")</h3>

            <div class="row" style="margin-top:-40px;">
                <div class="col-md-12">
                    <table id="datatable1" class="table table-striped table-bordered pStyle" cellspacing="0" width="100%">
                        <thead  style="background-color:#004274;">
                            <tr>
                                <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "अ.क्र." : "Sr.No.")</th>
                                <th class="tCenter; width:500px;">@(Session["Lang"].ToString() == "mr" ? "योजनाचे नाव" : "Project Name") </th>
                                <th class="tCenter; width:200px;">@(Session["Lang"].ToString() == "mr" ? "परवानगी दिनांक" : "Date")</th>
                                <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "पहा" : "View")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.other_building_permission_list.Select((x, i) => new { Data = x, Index = i + 1 }))
                            {
                                <tr>
                                    <td style="text-align:center">@item.Index</td>
                                    <td style="text-align:left; width:500px;">@(Session["Lang"].ToString() == "mr" ? @item.Data.proj_name : @item.Data.proj_name_eng)</td>
                                    <td style="text-align:center; width:200px;">@item.Data.proj_date.ToString("dd/MM/yyyy")</td>
                                    <td style="text-align:center" class="tCenter">
                                        <a href="@Url.Content(@item.Data.doc_location+@item.Data.doc_name)" class="marathi_font" target="_blank">
                                            <img src="~/Content/images/pdf-logo.png" width="25" height="25">
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                    <button class="button button2" onclick="window.location.href='@Url.Action("template4", "Home")'">आणखी पहा... </button>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
