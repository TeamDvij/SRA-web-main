@model SRACMSApplication.Models.other_lotteryModel
@{
    ViewBag.Title = "Lottery";
    Layout = "~/Views/Shared/_MasterView.cshtml";
}
@*Data table*@
@*css*@

@*javascript*@
<script>
    $(document).ready(function () {
        $('#datatable').dataTable(),
        $("[data-toggle=tooltip]").tooltip();
    });

</script>

@*<link href="//maxcdn.bootstrapcdn.com/bootstrap/3.3.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">*@
<script src="~//maxcdn.bootstrapcdn.com/bootstrap/3.3.0/js/bootstrap.min.js"></script>
<script src="~//code.jquery.com/jquery-1.11.1.min.js"></script>
<!------ Include the above in your HEAD tag ---------->

<script language="JavaScript" src="https://code.jquery.com/jquery-1.11.1.min.js" type="text/javascript"></script>
<script language="JavaScript" src="https://cdn.datatables.net/1.10.4/js/jquery.dataTables.min.js" type="text/javascript"></script>
<script language="JavaScript" src="https://cdn.datatables.net/plug-ins/3cfcc339e89/integration/bootstrap/3/dataTables.bootstrap.js" type="text/javascript"></script>
@*<link rel="stylesheet" type="text/css" href="http://maxcdn.bootstrapcdn.com/bootstrap/3.2.0/css/bootstrap.min.css">*@
<link rel="stylesheet" type="text/css" href="http://cdn.datatables.net/plug-ins/3cfcc339e89/integration/bootstrap/3/dataTables.bootstrap.css">

<div class="container containerStyle">
    <div class="row">
        <div>
            <div class="multimedia">
                <h3>@(Session["Lang"].ToString() == "mr" ? "लॉटरी पद्धतीने सदनिका वाटप करण्यात आलेल्या योजनांची यादी" : "Lottery List")</h3>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <table id="datatable" class="table table-striped table-bordered pStyle" cellspacing="0" width="100%">
                <thead>
                    <tr>
                        <th style="text-align:center;vertical-align:middle">@(Session["Lang"].ToString() == "mr" ? "अ.क्र." : "Sr.No.")</th>
                        <th style="text-align:center;vertical-align:middle">@(Session["Lang"].ToString() == "mr" ? "योजनेचे नाव" : "Plan Name") </th>
                        <th style="text-align:center;vertical-align:middle">@(Session["Lang"].ToString() == "mr" ? "विकसक" : "Developer")</th>
                        @*<th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "वर्ष" : "Year")</th>*@
                        <th style="text-align:center;vertical-align:middle">@(Session["Lang"].ToString() == "mr" ? "सदनिका वाटप दिनांक" : "Flat allotment date")</th>
                        <th style="text-align:center;vertical-align:middle">@(Session["Lang"].ToString() == "mr" ? "एकूण सदनिका" : "Total Flats")</th>
                        <th style="text-align:center;vertical-align:middle">@(Session["Lang"].ToString() == "mr" ? "वाटप सदनिका" : "Alloted Flats")</th>
                        <th style="text-align:center;vertical-align:middle">@(Session["Lang"].ToString() == "mr" ? "पहा" : "View")</th>
                        @*<th style="text-align:center">@(Session["Lang"].ToString() == "mr" ? "व्हिडिओ पहा" : "Video")</th>*@
                    </tr>
                    @*<tr style="font-size:medium;">
                        <th style="text-align:center;">1</th>
                        <th style="text-align:center;">2</th>
                        <th style="text-align:center;">3</th>
                        <th style="text-align:center;">4</th>
                        <th style="text-align:center;">5</th>
                        <th style="text-align:center;">6</th>
                        <th style="text-align:center;">7</th>
                        <th style="text-align:center;">8</th>
                        @*<th style="text-align:center;">9</th>*@
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.other_lotteryList.Select((x, i) => new { Data = x, Index = i + 1 }))
                    {
                        <tr>
                            <td style="text-align:center">@item.Index</td>
                            <td style="text-align:left">@(Session["Lang"].ToString() == "mr" ? @item.Data.proj_name : @item.Data.proj_name_eng)</td>
                            <td style="text-align:left">@(Session["Lang"].ToString() == "mr" ? @item.Data.developer: @item.Data.developer_eng)</td>
                            @*<td style="text-align:center">@item.Data.lottery_year</td>*@
                            <td style="text-align:center">@item.Data.flat_allotment_date.ToString("dd/MM/yyyy")</td>
                            <td style="text-align:center">@item.Data.total_flats</td>
                            <td style="text-align:center">@item.Data.allotted_flats</td>
                            <td class="tCenter">
                                <a href="@Url.Content(@item.Data.doc_location+@item.Data.doc_name)" class="marathi_font" target="_blank">
                                    <img src="~/Content/images/pdf-logo.png" width="25" height="25">
                                </a>
                            </td>
                            @*<td class="tCenter">
                                @if (@item.Data.video_url != null)
                                {
                                    <a href="@Url.Content(@item.Data.video_url)" class="marathi_font" target="_blank">
                                        <img src="~/Content/images/utLogo.jpg" width="25" height="25">
                                    </a>
                                }
                            </td>*@
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>