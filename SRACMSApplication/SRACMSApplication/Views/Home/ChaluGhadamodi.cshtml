<div class="container containerStyle">
    <div class="row">
                <div class="col-md-12">
                    <div class="multimedia">
                        <h3>@(Session["Lang"].ToString() == "mr" ? "बातम्या" : "News") </h3>
                    </div>
                    <div class="gallery_box" style="margin-left:15px">
                                    <div class="gallery-container galleryStyle">
                                        <div class="row">
                                            <div class="col-md-3">
                                                <div class="titleStyle">
                                                    <h2>@(Session["Lang"].ToString() == "mr" ? "शीर्षक" : "Title")</h2>
                                                </div><br />
                                                @foreach (var item in Model.DistinctYear.Select((x, i) => new { Data = x, Index = i + 1 }))
                                                {
                                                    <div>
                                                        <ul><li style="margin-left:10px; margin-top:10px;"><a style="font-size:larger;margin-bottom:10px" href="@Url.Content("~/Home/ChaluGhadamodi?desc="+@item.Data.Text)">@item.Data.Text</a></li></ul>
                                                    </div>
                                                }
                                            </div>
                                            <div class="col-md-9">
                                                <div class="titleStyle">
                                                    <h2>@Session["defaultYear"]</h2>
                                                </div><br />
                                                <div class="tz-gallery">
                                                    <div class="row">
                                                        @{ int totalcount = Model.chalughadamodi_List.Count();}
                                                        @if (Model.chalughadamodi_List.Count() > 8)
                                                        {
                                                            totalcount = 8;
                                                        }
                                                        @for (int j = 0; j < totalcount; j = j + 4)
                                                        {
                                                            <div class="row">
                                                                <div class="col-sm-12 col-md-3">
                                                                    <a class="lightbox" href="@Url.Content(Model.chalughadamodi_List[j].doc_location + Model.chalughadamodi_List[j].doc_name)">
                                                                        <img src="@Url.Content(Model.chalughadamodi_List[j].doc_location + Model.chalughadamodi_List[j].doc_name)" alt="Bridge">
                                                                    </a>
                                                                </div>
                                                                @if (j + 1 < totalcount)
                                                                {
                                                                <div class="col-sm-12 col-md-3">
                                                                    <a class="lightbox" href="@Url.Content(Model.chalughadamodi_List[j+1].doc_location + Model.chalughadamodi_List[j+1].doc_name)">
                                                                        <img src = "@Url.Content(Model.chalughadamodi_List[j+1].doc_location + Model.chalughadamodi_List[j+1].doc_name)" alt="Bridge">
                                                                    </a>
                                                                </div>
                                                                 }
                                                                @if (j + 2 < totalcount)
                                                                {
                                                                    <div class="col-sm-12 col-md-3">
                                                                    <a class="lightbox" href="@Url.Content(Model.chalughadamodi_List[j + 2].doc_location + Model.chalughadamodi_List[j + 2].doc_name)">
                                                                        <img src="@Url.Content(Model.chalughadamodi_List[j + 2].doc_location + Model.chalughadamodi_List[j + 2].doc_name)" alt="Bridge">
                                                                    </a>
                                                                </div>
                                                                }
                                                                @if (j + 3 < totalcount)
                                                                {
                                                                <div class="col-sm-12 col-md-3">
                                                                    <a class="lightbox" href="@Url.Content(Model.chalughadamodi_List[j + 3].doc_location + Model.chalughadamodi_List[j + 3].doc_name)">
                                                                        <img src="@Url.Content(Model.chalughadamodi_List[j + 3].doc_location + Model.chalughadamodi_List[j + 3].doc_name)" alt="Bridge">
                                                                    </a>
                                                                </div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                
                                                    <div class="row" id="less">
                                                    </div>
                                                    <div class="row" id="more" style="display:none">
                                                        @for (int j = totalcount; j < Model.chalughadamodi_List.Count(); j = j + 4)
                                                        {
                                                            <div class="row">
                                                                <div class="col-sm-12 col-md-3">
                                                                    <a class="lightbox" href="@Url.Content(Model.chalughadamodi_List[j].doc_location + Model.chalughadamodi_List[j].doc_name)">
                                                                        <img src="@Url.Content(Model.chalughadamodi_List[j].doc_location + Model.chalughadamodi_List[j].doc_name)" alt="Bridge">
                                                                    </a>
                                                                </div>
                                                                @if (j + 1 < Model.chalughadamodi_List.Count)
                                                                {
                                                                    <div class="col-sm-12 col-md-3">
                                                                        <a class="lightbox" href="@Url.Content(Model.chalughadamodi_List[j+1].doc_location + Model.chalughadamodi_List[j+1].doc_name)">
                                                                            <img src="@Url.Content(Model.chalughadamodi_List[j+1].doc_location + Model.chalughadamodi_List[j+1].doc_name)" alt="Bridge">
                                                                        </a>
                                                                    </div>
                                                                }
                                                                @if (j + 2 < Model.chalughadamodi_List.Count)
                                                                {
                                                                    <div class="col-sm-12 col-md-3">
                                                                        <a class="lightbox" href="@Url.Content(Model.chalughadamodi_List[j + 2].doc_location + Model.chalughadamodi_List[j + 2].doc_name)">
                                                                            <img src="@Url.Content(Model.chalughadamodi_List[j + 2].doc_location + Model.chalughadamodi_List[j + 2].doc_name)" alt="Bridge">
                                                                        </a>
                                                                    </div>
                                                                }
                                                                @if (j + 3 < Model.chalughadamodi_List.Count)
                                                                {
                                                                    <div class="col-sm-12 col-md-3">
                                                                        <a class="lightbox" href="@Url.Content(Model.chalughadamodi_List[j + 3].doc_location + Model.chalughadamodi_List[j + 3].doc_name)">
                                                                            <img src="@Url.Content(Model.chalughadamodi_List[j + 3].doc_location + Model.chalughadamodi_List[j + 3].doc_name)" alt="Bridge">
                                                                        </a>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                    <br />
                                                    @if (Model.chalughadamodi_List.Count() > 8)
                                                    {
                                                        <a href="javascript:myFunction()" id="myBtn">More...</a>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <br />
                                    </div>
                                    <script src="https://cdnjs.cloudflare.com/ajax/libs/baguettebox.js/1.8.1/baguetteBox.min.js"></script>
                                    <script>
                                            baguetteBox.run('.tz-gallery');
                                    </script>
                                    <br />
                    </div>
                </div>
            </div>
</div>

<script>
function myFunction() {
  var less = document.getElementById("less");
  var more = document.getElementById("more");
  var btnText = document.getElementById("myBtn");

  if (less.style.display === "none") {
      less.style.display = "inline";
    btnText.innerHTML = "More...";
    more.style.display = "none";
  } else {
      less.style.display = "none";
      btnText.innerHTML = "Less...";
      more.style.display = "inline";

  }
}

</script>