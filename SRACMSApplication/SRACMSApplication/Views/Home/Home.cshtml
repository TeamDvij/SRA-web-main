    @model SRACMSApplication.Models.homeModel
@{
    ViewBag.Title = "Home";
    Layout = @Session["Layout"].ToString();
    //Layout = "~/Views/Shared/Master7.cshtml";
}

<!-- Bootstrap JS (Required for Carousel) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<div class="container-fluid-slide-minister"  id="targetSection">
    <!-- Carousel Section -->
    <div class="row justify-content-center">
        <div class="col-12 col-md-8">
            <div id="carouselExample" class="carousel slide" data-bs-ride="carousel">
                <!-- Indicators -->
                <div class="carousel-indicators">
                    @for (int i = 0; i < Model.banner_List.Count; i++)
                    {
                        <button type="button" data-bs-target="#carouselExample" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-label="Slide @(i+1)"></button>
                    }
                </div>

                <div class="carousel-inner">
                    @foreach (var item in Model.banner_List.Select((x, i) => new { Data = x, Index = i }))
                    {
                        <div class="carousel-item @(item.Index == 0 ? "active" : "")" data-bs-interval="3000">
                            <img class="d-block w-100 img-fluid" src="@Url.Content(item.Data.doc_location + item.Data.doc_name)" alt="Slide @item.Index">
                        </div>
                    }
                </div>

                <!-- Navigation Arrows -->
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                </button>
            </div>
        </div>
    </div>

    <!-- Ministers Section (Single Horizontal Row) -->
    <div class="row justify-content-center " ">
        <div class="col-12" style="padding:0px;">
               <div class="card ">
                <div class="team teamback">
                    <div class="d-flex flex-wrap justify-content-center home-ministers" style="gap:20px;">
                        <!-- Minister 1 -->
                        <div class="text-center home-minister-card">
                            <div class="ih-item">
                                <div class="img home-minister-photo">
                                    <img src="@Url.Content(@Model.minister1_Photo)" alt="img" class="minister-img img-fluid">
                                </div>
                            </div>
                            <div class="team-bottom">
                                <h7>@(Session["Lang"].ToString() == "mr" ? @Model.minister1_Name : @Model.minister1_Name_eng)</h7>
                                <p class="fw-bold text-danger">
                                    @(Session["Lang"].ToString() == "mr" ? "माननीय मुख्यमंत्री" : "Hon. Chief Minister")
                                </p>
                            </div>
                        </div>

                        <!-- Minister 2 -->
                        <div class="text-center home-minister-card">
                            <div class="ih-item">
                                <div class="img home-minister-photo">
                                    <img src="@Url.Content(@Model.minister2_Photo)" alt="img" class="minister-img img-fluid">
                                </div>
                            </div>
                            <div class="team-bottom">
                                <h7>@(Session["Lang"].ToString() == "mr" ? @Model.minister2_Name : @Model.minister2_Name_eng)</h7>
                                <p class="fw-bold text-danger">
                                    @(Session["Lang"].ToString() == "mr" ? "माननीय उपमुख्यमंत्री तथा माननीय गृहनिर्माण मंत्री" : "Hon. Deputy Chief Minister and Hon. Housing Minister")
                                </p>
                            </div>
                        </div>

                        <!-- Minister 3 -->
                        <div class="text-center home-minister-card">
                            <div class="ih-item">
                                <div class="img home-minister-photo">
                                    <img src="@Url.Content(@Model.minister3_Photo)" alt="img" class="minister-img img-fluid">
                                </div>
                            </div>
                            <div class="team-bottom">
                                <h7>@(Session["Lang"].ToString() == "mr" ? @Model.minister3_Name : @Model.minister3_Name_eng)</h7>
                                <p class="fw-bold text-danger">
                                    @(Session["Lang"].ToString() == "mr" ? "माननीय उपमुख्यमंत्री" : "Hon. Deputy Chief Minister")
                                </p>
                            </div>
                        </div>

                        <!-- Minister 4 -->
                        <div class="text-center home-minister-card">
                            <div class="ih-item gap-3">
                                <div class="img home-minister-photo">
                                    <img src="@Url.Content(@Model.minister4_Photo)" alt="img" class="minister-img img-fluid">
                                </div>
                            </div>
                            <div class="team-bottom">
                                <h7>@(Session["Lang"].ToString() == "mr" ? @Model.minister4_Name : @Model.minister4_Name_eng)</h7>
                                <p class="fw-bold text-danger">मा. राज्यमंत्री गृहनिर्माण</p>
                            </div>
                        </div>
                    </div> <!-- End of flex container -->
                </div>
            </div>
            </div>
    </div>
</div>





<style>
    .container-fluid-slide-minister,
    .container-fluid-slide-minister .team.teamback,
    .container-fluid-slide-minister .home-ministers {
        width: 100%;
        max-width: 100%;
    }

    .home-ministers {
        align-items: flex-start;
        gap: 12px !important;
        padding: 20px 12px 24px;
    }

    .home-ministers .home-minister-card {
        display: flex;
        flex: 1 1 0;
        flex-direction: column;
        align-items: center;
        min-width: 150px;
        padding: 4px 8px;
    }

    .home-minister-card .ih-item {
        display: flex;
        width: 100%;
        justify-content: center;
    }

    .home-minister-card .home-minister-photo {
        display: flex;
        width: 120px;
        height: 120px;
        align-items: flex-end;
        justify-content: center;
        overflow: hidden;
    }

    .home-minister-card img.minister-img {
        display: block;
        width: 110px;
        height: 116px;
        max-width: 100%;
        object-fit: contain;
        object-position: center bottom;
    }

    .home-minister-card .team-bottom {
        width: 100%;
        margin-top: 8px;
    }

    .home-minister-card .team-bottom h7 {
        display: flex;
        min-height: 2.8em;
        align-items: center;
        justify-content: center;
        margin: 0;
        padding: 4px 0;
        line-height: 1.35;
    }

    .home-minister-card .team-bottom p {
        min-height: 2.6em;
        margin: 4px 0 0;
        line-height: 1.35;
    }

    @@media (max-width: 575.98px) {
        .home-ministers {
            gap: 8px !important;
            padding: 16px 6px 20px;
        }

        .home-ministers .home-minister-card {
            flex-basis: 145px;
            min-width: 135px;
        }
    }
</style>

