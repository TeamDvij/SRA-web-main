@model SRACMSApplication.Models.other_building_permission_bhogvataModel
@{
    ViewBag.Title = "BuildingPermission";
    Layout = "~/Views/Shared/_MasterView.cshtml";
}

<script>
    $(document).ready(function () {
        $('#datatable1').dataTable(),
            $('#datatable2').dataTable(),
        $("[data-toggle=tooltip]").tooltip();

    });

</script>
<script src="~//maxcdn.bootstrapcdn.com/bootstrap/3.3.0/js/bootstrap.min.js"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
<script language="JavaScript" src="https://cdn.datatables.net/1.10.4/js/jquery.dataTables.min.js" type="text/javascript"></script>
<script language="JavaScript" src="https://cdn.datatables.net/plug-ins/3cfcc339e89/integration/bootstrap/3/dataTables.bootstrap.js" type="text/javascript"></script>
<link rel="stylesheet" type="text/css" href="http://cdn.datatables.net/plug-ins/3cfcc339e89/integration/bootstrap/3/dataTables.bootstrap.css">

@*Tab Container*@

@*//Tab Container script and Css*@
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
    /*body {
        font-family: Arial;
    }*/

    /* Style the tab */
    .tab {
        overflow: hidden;
        border: 1px solid #ccc;
    }

    li.active {
        background: dodgerblue;
        color: white;
    }

    element.style {
    }

    .nav-tabs > li.active > a, .nav-tabs > li.active > a:hover, .nav-tabs > li.active > a:focus {
        color: white;
    }


        .nav-tabs > li.active > a, .nav-tabs > li.active > a:hover, .nav-tabs > li.active > a:focus {
            background: #87ceeb21;
        }

    .nav > li > a:hover, .nav > li > a:focus {
        text-decoration: none;
        background-color: #87ceeb21;
        color: black;
    }
    /* Style the buttons inside the tab */
    .tab button {
        /*background-color: inherit;*/
        float: left;
        border: none;
        outline: none;
        cursor: pointer;
        padding: 14px 16px;
        transition: 0.3s;
        font-size: 17px;
    }

    a:hover, .nav-tabs > li.active > a:focus {
        color: white;
    }
    /* Change background color of buttons on hover */
    .tab button:hover {
        background-color: #87ceeb21;
    }

    /* Create an active/current tablink class */
    .tab button.active {
        /*background-color: #ccc;*/
        background-color: dodgerblue;
        color: white;
    }

    /* Style the tab content */
    .tabcontent {
        display: none;
        padding: 6px 12px;
        border: 1px solid #ccc;
        border-top: none;
        /*font-size: initial;*/
        font-size: 120%;
    }

    /* Style the close button */
    .topright {
        float: right;
        cursor: pointer;
        font-size: 28px;
    }

        .topright:hover {
            color: red;
        }

    .multimedia {
        margin-left: 0px;
    }
</style>

<div class="container containerStyle">
    <div class="row">
        <div>
            <div class="row">
                <div class="col-md-12">
                    <dsiv class="multimedia">
                        <h3>@(Session["Lang"].ToString() == "mr" ? "भोगवटा प्रमाणपत्रे" : "Occupancy Certificates")</h3>
                    </dsiv>
                    @*<ul class="nav nav-tabs">
                        <li class="active"><a data-toggle="tab" href="#BP">@(Session["Lang"].ToString() == "mr" ? "बांधकाम परवानगी" : "Building Permission")</a></li>
                        <li><a data-toggle="tab" href="#Occupancy">@(Session["Lang"].ToString() == "mr" ? "भोगवटा प्रमाणपत्र" : "Occupancy Certificate")</a></li>
                    </ul>*@
                    <div class="tab-content">
                        @*<div id="Occupancy" class="tab-pane fade">*@
                            @*<div class="multimedia">
                                <h3 style="font-size: medium;">@(Session["Lang"].ToString() == "mr" ? "भोगवटा" : "Occupancy Certificate")</h3>
                            </div>*@
                            <table id="datatable2" class="table table-striped table-bordered pStyle" cellspacing="0" width="100%">
                                <thead>
                                    <tr>
                                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "अ.क्र." : "Sr.No.")</th>
                                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "मा.क्र." : "Master No.")</th>
                                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "विभाग" : "Department")</th>
                                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "योजनाचे नाव" : "Project Name") </th>
                                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "भोगवटा दिनांक" : "Date")</th>
                                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "पहा" : "View")</th>
                                    </tr>
                                    @*<tr style="font-size:medium;">
                                        <th style="text-align:center;">1</th>
                                        <th style="text-align:center;">2</th>
                                        <th style="text-align:center;">3</th>
                                        <th style="text-align:center;">4</th>
                                    </tr>*@
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.other_bhogvata_list.Select((x, i) => new { Data = x, Index = i + 1 }))
                                    {
                                        <tr>
                                            <td style="text-align:center;width:5%;">@item.Index</td>
                                            <td style="text-align:center;width:8%;">@(item.Data.project_new.Master_no.ToString() == "0" ? "" : item.Data.project_new.Master_no.ToString())</td>
                                            <td style="text-align:center;width:8%;">@(Session["Lang"].ToString() == "mr" ? @item.Data.sys_config.sys_name_mar : @item.Data.sys_config.sys_name_eng)</td>
                                            <td style="text-align:left;width:50%;">@(item.Data.project_new.Master_no.ToString() == "0" ? (Session["Lang"].ToString() == "mr" ? @item.Data.proj_name_eng : @item.Data.proj_name_eng) : (Session["Lang"].ToString() == "mr" ? @item.Data.project_new.project_name : @item.Data.project_new.project_name_eng) ) </td>
                                            @*<td style="text-align:left">@(Session["Lang"].ToString() == "mr" ? @item.Data.proj_name : @item.Data.proj_name_eng)</td>*@
                                            <td style="text-align:center;width:12%;">@item.Data.proj_date.ToString("dd/MM/yyyy")</td>
                                            <td class="tCenter" style="width:5%">
                                                <a href="@Url.Content(@item.Data.doc_location+@item.Data.doc_name)" class="marathi_font" target="_blank">
                                                    <img src="~/Content/images/pdf-logo.png" width="25" height="25">
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        @*</div>*@
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

