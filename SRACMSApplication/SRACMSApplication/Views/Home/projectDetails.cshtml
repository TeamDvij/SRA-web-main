@model SRACMSApplication.Models.homeModel
@{
    ViewBag.Title = "projectDetails";
    Layout = "~/Views/Shared/_MasterView.cshtml";
}

<style>
    a:hover {
        color:black;
    }
    .title_class {
        background-color: #008eff; /* Green header */
        color: white;
        padding: 10px;
        text-align: center;
        border-radius: 8px;
        margin-bottom: 30px;
    }

     .container_new {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
        }

    .column {
        width: 45%;
        margin-bottom: 10px;
        background-color: #ffffff; /* White background for sections */
        border-radius: 8px;
        padding: 10px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    }

    .section {
        margin-bottom: 10px;
        background-color: #f9f9f9; /* Light background for each section */
        border-left: 5px solid orange; /* Green border for emphasis */
        padding: 10px;
        border-radius: 8px;
    }
    .section h1 {
           background-color: #008eff; /* Green header */
            color: white;
            font-size: 1.5em;
            padding: 10px;
        }
        .section h2 {
            color: #333; /* Dark text color for section titles */
            margin-bottom: 5px;
            font-size: 1.5em;
        }
        .section h3 {
            color: #333; /* Dark text color for section titles */
            margin-bottom: 5px;
            font-size: 1.2em;
        }

    ul {
        list-style-type: square;
        margin-left: 20px;
        color: #555; /* Darker text color for bullet points */
    }

        ul li {
            font-size: 1.2em;
            padding: 5px 0;
        }

  
    /* Hover effect on sections */
    .section:hover {
        background-color: #bbdaf2; /* Light blue hover effect */
       color: white;
    }

    .search-container {
            background-color: #fff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .search-container input[type="search"] {
                padding: 10px;
                font-size: 16px;
                border: 1px solid #ccc;
                border-radius: 4px;
                width: 250px;
                transition: all 0.3s;
            }

                .search-container input[type="search"]:focus {
                    outline: none;
                    border-color: #007bff;
                    box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
                }

            .search-container button {
                padding: 10px 20px;
                font-size: 16px;
                background-color: #007bff;
                color: white;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                transition: all 0.3s;
            }

                .search-container button:hover {
                    background-color: #0056b3;
                }

                .search-container button:active {
                    background-color: #00408a;
                }
                 .search-container h3{
                     color:black;
                 }

</style>
