@model SRACMSApplication.Models.homeModel
@{
    ViewBag.Title = "template1";
    Layout = "~/Views/Shared/_newMaster2.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="~/Content/webcss/New.css" rel="stylesheet" />
    <script language="JavaScript" src="https://cdn.datatables.net/1.10.4/js/jquery.dataTables.min.js" type="text/javascript"></script>
    


    @*javascript*@
    <script>
    $(document).ready(function () {
        $('#datatable').dataTable(),
        $("[data-toggle=tooltip]").tooltip();
    });

    </script>

</head>
<body>


    <div class="row">
        <div class="Middlecolumn">
            <div class="card">
                <button class="button button2">@(Session["Lang"].ToString() == "mr" ? "योजना निहाय माहिती" : "Projects Information") </button>
                <button class="button button2">@(Session["Lang"].ToString() == "mr" ? "झो.पु.प्रा. नियमावली" : "SRA Rules") </button>
                <button class="button button2">@(Session["Lang"].ToString() == "mr" ? "कार्यक्षेत्राचा नकाशा" : "MAP of Work Area")</button>
                <button class="button button2">@(Session["Lang"].ToString() == "mr" ? "झो.पु.प्रा.योजनेचे टप्पे" : "SRA Stages of Plan")</button>
                <button class="button button2">@(Session["Lang"].ToString() == "mr" ? "विहित निकष / नमुने / कार्यपद्धती" : "Download Forms")</button>
                <button class="button button2">@(Session["Lang"].ToString() == "mr" ? "नोंदणीक्रुत विकसकांची यादी" : "Registered Developer List")</button>
                <button class="button button2">@(Session["Lang"].ToString() == "mr" ? "लॉटरी पद्धतीने सदनिका वितरण" :  "Allotment of Flats by Lottery")</button>
                <button class="button button2">@(Session["Lang"].ToString() == "mr" ? "गृहनिर्माण संस्थांची यादी" : "List Of Housing Societies")</button>
                <button class="button button2"> @(Session["Lang"].ToString() == "mr" ? "झोपडपट्ट्यांची यादी" : "Slum List")</button>
            </div>
        </div>
        <div class="leftcolumn">
            <div class="card">

                <div id="carouselExampleControls" class="carousel slide " data-bs-ride="carousel" data-bs-interval="3000">
                    <div class="carousel-inner" style="width:740px;">
                        <div class="carousel-item active">
                            <img style="height:auto;width:auto;" src="~/Content/images/02.jpg" class="d-block w-100">
                        </div>
                        <div class="carousel-item">
                            <img src="~/Content/images/02.png" class="d-block w-100">
                        </div>
                        <div class="carousel-item">
                            <img src="~/Content/images/07.png" class="d-block w-100">
                        </div>
                        <div class="carousel-item">
                            <img src="~/Content/images/08.png" class="d-block w-100">
                        </div>
                    </div>

                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>

                </div>
                
            </div>


            <div class="card">
                <section class="current-section">
                    <div class="customTabs" style="margin-left:-10px;">
                        <div class="tabs-wrap">
                            <ul class="nav nav-tabs" id="myTab" role="tablist">
                                <li class="nav-item" role="tabpanel">
                                    <button style="font-size:small;"  onclick="myFunction()" class="nav-link active" id="tab1" data-bs-toggle="tab" data-bs-target="#menu1" type="button" role="tab" aria-controls="home" aria-selected="true">
                                        <i class="fa-regular fa-file-lines"></i> जाहीर प्रकटने
                                    </button>
                                </li>
                                <li class="nav-item" role="tabpanel">
                                    <button style="font-size:small;"  onclick="myFunction()" class="nav-link" id="tab2" data-bs-toggle="tab" data-bs-target="#menu2" type="button" role="tab" aria-controls="profile" aria-selected="false" tabindex="-1">
                                        <i class="fa-regular fa-file-lines"></i> पात्रता यादी (परिशिष्ट २)
                                    </button>
                                </li>
                                <li class="nav-item" role="tabpanel">
                                    <button style="font-size:small;" onclick="myFunction()" class="nav-link" id="tab3" data-bs-toggle="tab" data-bs-target="#menu3" type="button" role="tab" aria-controls="contact" aria-selected="false" tabindex="-1">
                                        <i class="fa-regular fa-file-lines"></i> पुनर्वसन क्षेत्र आदेश (३क)
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button style="font-size:small;" onclick="myFunction()" class="nav-link" id="tab4" data-bs-toggle="tab" data-bs-target="#menu4" type="button" role="tab" aria-controls="contact" aria-selected="false" tabindex="-1">
                                        <i class="fa-regular fa-file-lines"></i> निर्मूलन आदेश (३ड)
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button style="font-size:small;" onclick="myFunction()" class="nav-link" id="tab4" data-bs-toggle="tab" data-bs-target="#menu4" type="button" role="tab" aria-controls="contact" aria-selected="false" tabindex="-1">
                                        <i class="fa-regular fa-file-lines"></i> बांधकाम परवानगी
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button style="font-size:small;" onclick="myFunction()" class="nav-link" id="tab4" data-bs-toggle="tab" data-bs-target="#menu4" type="button" role="tab" aria-controls="contact" aria-selected="false" tabindex="-1">
                                        <i class="fa-regular fa-file-lines"></i> योजना मंजुरी
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button style="font-size:small;" onclick="myFunction()" class="nav-link" id="tab4" data-bs-toggle="tab" data-bs-target="#menu4" type="button" role="tab" aria-controls="contact" aria-selected="false" tabindex="-1">
                                        <i class="fa-regular fa-file-lines"></i> भोगवटा प्रमाणपत्रे
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button style="font-size:small;" onclick="myFunction()" class="nav-link" id="tab4" data-bs-toggle="tab" data-bs-target="#menu4" type="button" role="tab" aria-controls="contact" aria-selected="false" tabindex="-1">
                                        <i class="fa-regular fa-file-lines"></i> दरपत्रके / ई-निविदा
                                    </button>
                                </li>

                            </ul>
                            <div id="myDIV">
                                <div class="tab-pane fade show active" id="menu1" role="tabpanel" aria-labelledby="tab1">
                                    <table id="datatable">
                                        <thead>
                                            <tr class="tCenter">
                                                <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "विषय" : "Subject") </th>
                                                <th class="tCenter" width="15%">@(Session["Lang"].ToString() == "mr" ? "प्रकाशित दिनांक" : "Publish Date")</th>
                                                <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "पहा" : "View")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.GovtResolutionList.Select((x, i) => new { Data = x, Index = i + 1 }))
                                            {
                                                <tr>
                                                    <td style="text-align:left">@(Session["Lang"].ToString() == "mr" ? @item.Data.resolution_subject : @item.Data.resolution_subject_eng)</td>
                                                    <td class="tCenter">@item.Data.resolution_date.ToString("dd/MM/yyyy")</td>
                                                    <td class="tCenter">
                                                        <a href="@Url.Content(@item.Data.doc_location+@item.Data.doc_name)" class="marathi_font" target="_blank">
                                                            <img src="~/Content/images/pdf-logo.png" width="25" height="25">
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="tab-pane fade" id="menu2" role="tabpanel" aria-labelledby="tab2">
                                    <div class="fixed-area">
                                        <div class="scroll-content" style="background-color: #004274">
                                            <table id="datatable">
                                                <thead>
                                                    <tr class="tCenter">
                                                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "विषय" : "Subject") </th>
                                                        <th class="tCenter" width="15%">@(Session["Lang"].ToString() == "mr" ? "प्रकाशित दिनांक" : "Publish Date")</th>
                                                        <th class="tCenter">@(Session["Lang"].ToString() == "mr" ? "पहा" : "View")</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in Model.GovtResolutionList.Select((x, i) => new { Data = x, Index = i + 1 }))
                                                    {
                                                        <tr>
                                                            <td style="text-align:left">@(Session["Lang"].ToString() == "mr" ? @item.Data.resolution_subject : @item.Data.resolution_subject_eng)</td>
                                                            <td class="tCenter">@item.Data.resolution_date.ToString("dd/MM/yyyy")</td>
                                                            <td class="tCenter">
                                                                <a href="@Url.Content(@item.Data.doc_location+@item.Data.doc_name)" class="marathi_font" target="_blank">
                                                                    <img src="~/Content/images/pdf-logo.png" width="25" height="25">
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>


                                    </div>
                                </div>
                            </div>
                </section>
            </div>
        </div>

        <div class="rightcolumn">
            <div class="card">
                <div class="team teamback">
                    <div class="team-main">
                        <div class="team-row d-flex flex-column justify-content-center align-items-center flex-nowrap">
                            <!-- Minister 1 -->
                            <div class="team text-center mx-3">
                                <div class="ih-item">
                                    <div class="img">
                                        <img src="@Url.Content(@Model.minister1_Photo)" alt="img" class="minister-img">
                                    </div>
                                </div>
                                <div class="team-bottom">
                                    <h6>@(Session["Lang"].ToString() == "mr" ? @Model.minister1_Name : @Model.minister1_Name_eng)</h6>
                                    <p class="fw-bold text-danger">
                                        @(Session["Lang"].ToString() == "mr" ? "माननीय मुख्यमंत्री" : "Hon. Chief Minister")
                                    </p>
                                </div>
                            </div>

                            <!-- Minister 2 -->
                            <div class="team text-center mx-3">
                                <div class="ih-item">
                                    <div class="img">
                                        <img src="@Url.Content(@Model.minister2_Photo)" alt="img" class="minister-img">
                                    </div>
                                </div>
                                <div class="team-bottom">
                                    <h6>@(Session["Lang"].ToString() == "mr" ? @Model.minister2_Name : @Model.minister2_Name_eng)</h6>
                                    <p class="fw-bold text-danger">
                                        @(Session["Lang"].ToString() == "mr" ? "माननीय उपमुख्यमंत्री तथा माननीय गृहनिर्माण मंत्री" : "Hon. Deputy Chief Minister and Hon. Housing Minister")
                                    </p>
                                </div>
                            </div>

                            <!-- Minister 3 -->
                            <div class="team text-center mx-3">
                                <div class="ih-item">
                                    <div class="img">
                                        <img src="@Url.Content(@Model.minister3_Photo)" alt="img" class="minister-img">
                                    </div>
                                </div>
                                <div class="team-bottom">
                                    <h6>@(Session["Lang"].ToString() == "mr" ? @Model.minister3_Name : @Model.minister3_Name_eng)</h6>
                                    <p class="fw-bold text-danger">
                                        @(Session["Lang"].ToString() == "mr" ? "माननीय उपमुख्यमंत्री" : "Hon. Deputy Chief Minister")
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
    </div>

    

</body>
</html>
<script>
    function myFunction() {
        var x = document.getElementById("myDIV");

        // Toggle display using proper CSS value 'none' (lowercase)
        if (x.style.display === "none") {
            x.style.display = "block";
        } else {
            x.style.display = "none";
        }
    }

</script>

