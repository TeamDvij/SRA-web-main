@model SRACMSApplication.Models.homeModel
@{
    ViewBag.Title = "WorkAreaMap";
    Layout = "~/Views/Shared/_MasterView.cshtml";
}
@*Data table*@
@*css*@

@*javascript*@
<script>
    $(document).ready(function () {
        $('#datatable').dataTable(),
        $("[data-toggle=tooltip]").tooltip();
    });

</script>

