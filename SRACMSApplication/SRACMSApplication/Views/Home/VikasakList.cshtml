@model SRACMSApplication.Models.other_developerModel
@{
    ViewBag.Title = "VikasakList";
    Layout = "~/Views/Shared/_MasterView.cshtml";
}

@*Data table*@
@*css*@

@*javascript*@
<script>
    $(document).ready(function () {
        $('#datatable').dataTable(),
        $('#datatable2').dataTable();

        $("[data-toggle=tooltip]").tooltip();

    });

</script>

@*<link href="//maxcdn.bootstrapcdn.com/bootstrap/3.3.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">*@
<script src="~//maxcdn.bootstrapcdn.com/bootstrap/3.3.0/js/bootstrap.min.js"></script>
<script src="~//code.jquery.com/jquery-1.11.1.min.js"></script>
<!------ Include the above in your HEAD tag ---------->

<script language="JavaScript" src="https://code.jquery.com/jquery-1.11.1.min.js" type="text/javascript"></script>
<script language="JavaScript" src="https://cdn.datatables.net/1.10.4/js/jquery.dataTables.min.js" type="text/javascript"></script>
<script language="JavaScript" src="https://cdn.datatables.net/plug-ins/3cfcc339e89/integration/bootstrap/3/dataTables.bootstrap.js" type="text/javascript"></script>
@*<link rel="stylesheet" type="text/css" href="http://maxcdn.bootstrapcdn.com/bootstrap/3.2.0/css/bootstrap.min.css">*@
<link rel="stylesheet" type="text/css" href="http://cdn.datatables.net/plug-ins/3cfcc339e89/integration/bootstrap/3/dataTables.bootstrap.css">
<div class="container containerStyle">
    <div class="row">
        <div>
            <div class="multimedia">
                <h3>@(Session["Lang"].ToString() == "mr" ? "नोंदणीकृत विकसकांची यादी" : "Registered Developer List")</h3>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <table id="datatable" class="table table-striped table-bordered pStyle" cellpadding="0" cellspacing="0" width="100%">
                    <thead>
                        <tr style="height:46px;">
                            <th style="text-align:center;">@(Session["Lang"].ToString() == "mr" ? "अ.क्र." : "Sr.No.")</th>
                            <th style="text-align:center;">@(Session["Lang"].ToString() == "mr" ? "विकसक संस्थेचे नाव व पत्ता" : "Developer Firm Name")</th>
                            <th style="text-align:center;">@(Session["Lang"].ToString() == "mr" ? "दूरध्वनी / मोबाईल क्रमांक" : "Contact Number")</th>
                            <th style="text-align:center;">@(Session["Lang"].ToString() == "mr" ? "नोंदणी वर्ग व क्रमांक" : "Registration Number")</th>
                            <th style="text-align:center;">@(Session["Lang"].ToString() == "mr" ? "नोंदणी दिनांक" : "Registration Date")</th>
                            @*<th style="text-align:center;">@(Session["Lang"].ToString() == "mr" ? "पूर्ण केलेले प्रकल्प" : "Completed Projects")</th>
                            <th style="text-align:center;">@(Session["Lang"].ToString() == "mr" ? "सुरु असलेले प्रकल्प" : "Ongoing Projects")</th>*@
                        </tr>
                        <tr style="font-size:medium;">
                            <th style="text-align:center;">1</th>
                            <th style="text-align:center;">2</th>
                            <th style="text-align:center;">3</th>
                            <th style="text-align:center;">4</th>
                            <th style="text-align:center;">5</th>
                            @*<th style="text-align:center;">6</th>
                            <th style="text-align:center;">7</th>*@
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.developerList.Select((x, i) => new { Data = x, Index = i + 1 }))
                        {
                            <tr style="height:46px;">
                                <td style="text-align:center">@item.Index</td>
                                <td style="text-align:left;">
                                    <spam style="font-weight:bold;">@(Session["Lang"].ToString() == "mr" ? @item.Data.dev_name : @item.Data.dev_name_eng)</spam> <br /> 
                                    @(Session["Lang"].ToString() == "mr" ? @item.Data.dev_address : @item.Data.dev_address_eng)
                                </td>
                                <td style="text-align:center"  width="150">@(Session["Lang"].ToString() == "mr" ? @item.Data.dev_contact : @item.Data.dev_contact_eng)</td>
                                <td style="text-align:center"  width="150">
                                    <spam style="font-weight:bold;">@(Session["Lang"].ToString() == "mr" ? @item.Data.dev_class : @item.Data.dev_class_eng)</spam> <br />
                                    @(Session["Lang"].ToString() == "mr" ? @item.Data.dev_registration_no : @item.Data.dev_registration_no_eng)
                                </td>
                                @if (@item.Data.dev_registration_date.ToString("dd-MM-yyyy") != "01-01-1900")
                                {
                                    <td style="text-align:center" width="150">@item.Data.dev_registration_date.ToString("dd-MM-yyyy")</td>
                                }
                                  @if (@item.Data.dev_registration_date.ToString("dd-MM-yyyy") == "01-01-1900")
                                  {
                                    <td></td>
                                  }
                                @*@if (@item.Data.completed_projects != "0")
                                {
                                    <td style="text-align:center">@(Session["Lang"].ToString() == "mr" ? @item.Data.completed_projects : @item.Data.completed_projects_eng)</td>
                                }
                                @if (@item.Data.completed_projects == "0")
                                {
                                    <td></td>
                                }
                                @if (@item.Data.current_projects != "0" )
                                {
                                    <td style="text-align:center">@(Session["Lang"].ToString() == "mr" ? @item.Data.current_projects : @item.Data.current_projects_eng)</td>
                                }
                                @if (@item.Data.current_projects == "0")
                                {
                                    <td></td>
                                }*@
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>