<div class="container containerStyle">
 
        <div class="row">
            <div class="multimedia">
                <h3>@(Session["Lang"].ToString() == "mr" ? "शंका समाधान (FAQ)" : "FAQ's")</h3>
            </div>
        </div>
        <table class="table table-bordered tableSet">
            <tbody>
                @foreach (var item in Model.faq_list.Select((x, i) => new { Data = x, Index = i + 1 }))
                {
                    <tr>
                        <td class="tCenter">@item.Index.</td>
                        <td><a href="#@item.Index" data-toggle="collapse">@(Session["Lang"].ToString() == "mr" ? @item.Data.faq1 : @item.Data.faq_eng) </a></td>
                    </tr>
                    <tr>
                        <td></td>
                        <td id="@item.Index" class="collapse">@(Session["Lang"].ToString() == "mr" ? @item.Data.answer : @item.Data.answer_eng)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

          
